[{"t": "Contador subindo enquanto marca", "h": "<div class=\"lu-panel\" style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--accent-soft)\"><label class=\"lu-check m-loop\"><input aria-label=\"Seleção\" type=\"checkbox\"/></label><b class=\"num mo-count\" style=\"--to:25;--suf:' selecionados'\"></b><span class=\"lu-grow\"></span><button class=\"lu-btn sm\" type=\"button\"><i class=\"\" data-i=\"download\"></i>Exportar</button></div>", "lang": "html", "code": "<div class=\"lu-demo\">\n  <div class=\"lu-panel\" style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--accent-soft)\">\n    <label class=\"lu-check m-loop\">\n      <input type=\"checkbox\" aria-label=\"Seleção\">\n    </label>\n    <b class=\"num mo-count\" style=\"--to:25;--suf:' selecionados'\"></b>\n    <span class=\"lu-grow\"></span>\n    <button class=\"lu-btn sm\" type=\"button\">\n      <i data-i=\"download\"></i>\n      Exportar\n    </button>\n  </div>\n</div>"}, {"t": "Referência visual", "h": "<div class=\"lu-panel\" style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--accent-soft);border-color:color-mix(in oklab,var(--accent) 30%,transparent)\"><label class=\"lu-check\"><input aria-label=\"Seleção\" data-ind=\"1\" type=\"checkbox\"/></label><b class=\"num\">25 selecionadas</b><a class=\"lu-btn link sm\" href=\"#\">Selecionar todas as 1.096</a><span class=\"lu-grow\"></span><button class=\"lu-btn sm\" type=\"button\"><i class=\"\" data-i=\"folder\"></i>Mover</button><button class=\"lu-btn sm\" type=\"button\"><i class=\"\" data-i=\"download\"></i>Exportar</button><button class=\"lu-btn sm danger-soft\" type=\"button\"><i class=\"\" data-i=\"trash\"></i>Excluir</button></div>", "lang": "html", "code": "<div class=\"lu-demo\">\n  <div class=\"lu-panel\" style=\"display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--accent-soft);border-color:color-mix(in oklab,var(--accent) 30%,transparent)\">\n    <label class=\"lu-check\">\n      <input type=\"checkbox\" data-ind=\"1\" aria-label=\"Seleção\">\n    </label>\n    <b class=\"num\">25 selecionadas</b>\n    <a class=\"lu-btn link sm\" href=\"#\">Selecionar todas as 1.096</a>\n    <span class=\"lu-grow\"></span>\n    <button class=\"lu-btn sm\" type=\"button\">\n      <i data-i=\"folder\"></i>\n      Mover\n    </button>\n    <button class=\"lu-btn sm\" type=\"button\">\n      <i data-i=\"download\"></i>\n      Exportar\n    </button>\n    <button class=\"lu-btn sm danger-soft\" type=\"button\">\n      <i data-i=\"trash\"></i>\n      Excluir\n    </button>\n  </div>\n</div>"}]