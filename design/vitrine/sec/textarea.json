[{"t": "Crescendo e contando", "h": "<div class=\"lu-grid\" style=\"--cols:2;gap:16px\"><div class=\"lu-field\"><span class=\"lu-label\">Observações</span><div class=\"lu-ta m-grow focus\"><div class=\"tx\">Entregar após as 14h.\nPortão lateral, falar com Rita.\nLevar maquininha.</div></div><div class=\"lu-helprow\"><span class=\"lu-help\">autogrow até 6 linhas</span></div></div><div class=\"lu-field\"><span class=\"lu-label\">Mensagem ao cliente</span><div class=\"lu-ta focus\"><div class=\"tx\">Seu pedido saiu para entrega e chega hoje entre 14h e 16h.</div></div><div class=\"lu-helprow\"><span class=\"lu-help\">Até 200 caracteres</span><span class=\"lu-cnt m-loop\"></span></div></div></div>", "lang": "heex", "code": "<.textarea value=\"Entregar após as 14h. Portão lateral, falar com Rita. Levar maquininha.\" />\n<.textarea value=\"Seu pedido saiu para entrega e chega hoje entre 14h e 16h.\" />\n<.textarea />"}, {"t": "variant × size", "h": "<div style=\"display:grid;grid-template-columns:90px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center\"><span></span><span class=\"lu-xs lu-muted mono\" style=\"text-align:center\">sm</span><span class=\"lu-xs lu-muted mono\" style=\"text-align:center\">md</span><span class=\"lu-xs lu-muted mono\" style=\"text-align:center\">lg</span><span class=\"lu-xs lu-muted mono\">outlined</span><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta s-sm\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta s-md\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta s-lg\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><span class=\"lu-xs lu-muted mono\">filled</span><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta filled s-sm\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta filled s-md\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta filled s-lg\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><span class=\"lu-xs lu-muted mono\">plain</span><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta plain s-sm\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta plain s-md\"><div class=\"tx ph\">Escreva uma observação…</div></div></div><div style=\"display:flex;justify-content:center;min-width:0\"><div class=\"lu-ta plain s-lg\"><div class=\"tx ph\">Escreva uma observação…</div></div></div></div>", "lang": "heex", "code": "<.textarea value=\"Escreva uma observação…\" />"}, {"t": "counter", "h": "<div class=\"lu-grid\" style=\"--cols:4;gap:16px\"><div class=\"lu-field\"><span class=\"lu-label\">normal</span><div class=\"lu-ta\"><div class=\"tx\">Cliente pediu nota com CPF.</div></div><div class=\"lu-helprow\"><span class=\"lu-help\"></span><span class=\"lu-cnt\">26 / 200</span></div></div><div class=\"lu-field\"><span class=\"lu-label\">aviso (≥ 90%)</span><div class=\"lu-ta\"><div class=\"tx\">Texto longo quase no limite…</div></div><div class=\"lu-helprow\"><span class=\"lu-help\"></span><span class=\"lu-cnt warn\">184 / 200</span></div></div><div class=\"lu-field\"><span class=\"lu-label\">excedido</span><div class=\"lu-ta err\"><div class=\"tx\">Texto que passou do limite…</div></div><div class=\"lu-helprow\"><span class=\"lu-help\"></span><span class=\"lu-cnt over\">214 / 200</span></div></div><div class=\"lu-field\"><span class=\"lu-label\">mínimo</span><div class=\"lu-ta\"><div class=\"tx\">Curto</div></div><div class=\"lu-helprow\"><span class=\"lu-help\">Explique o motivo</span><span class=\"lu-cnt\">5 / 20 mín.</span></div></div></div>", "lang": "heex", "code": "<.textarea value=\"Cliente pediu nota com CPF.\" />\n<.textarea />\n<.textarea value=\"Texto longo quase no limite…\" />\n<.textarea variant=\"warn\" />\n<.textarea value=\"Texto que passou do limite…\" />\n<.textarea variant=\"over\" />\n<.textarea value=\"Curto\" />"}, {"t": "tokens · header/footer · resizable", "h": "<div class=\"lu-grid\" style=\"--cols:2;gap:16px\"><div class=\"lu-field\"><span class=\"lu-label\">Modelo de mensagem</span><div class=\"lu-ta\"><div class=\"bar top\"><span class=\"lu-xs lu-muted\">Variáveis: </span><span class=\"lu-chip sm\">{{cliente}}</span><span class=\"lu-chip sm\">{{numero}}</span></div><div class=\"tx\">Olá, <code>{{cliente}}</code>! Sua nota <code>{{numero}}</code> foi autorizada. O boleto vence em <code>{{vencimento}}</code>.</div><div class=\"bar\"><i class=\"sm\" data-i=\"bold\"></i><i class=\"sm\" data-i=\"italic\"></i><i class=\"sm\" data-i=\"link\"></i><span class=\"lu-cnt\">96 / 300</span></div></div></div><div class=\"lu-field\"><span class=\"lu-label\">Redimensionável</span><div class=\"lu-ta\"><div class=\"tx\">Arraste o canto para aumentar.</div><span class=\"grip\"></span></div></div></div>", "lang": "heex", "code": "<.textarea value=\"Olá, {{cliente}} ! Sua nota {{numero}} foi autorizada. O boleto vence em {{vencimento}} .\" />\n<.textarea value=\"Arraste o canto para aumentar.\" />"}, {"t": "state", "h": "<div class=\"lu-grid\" style=\"--cols:2;gap:16px\"><div class=\"lu-field\"><span class=\"lu-label\">Motivo</span><div class=\"lu-ta ok\"><div class=\"tx\">Cancelado a pedido do cliente.</div></div><span class=\"lu-help ok\"><i class=\"sm\" data-i=\"check-circle\"></i>Motivo registrado</span></div><div class=\"lu-field\"><span class=\"lu-label\">Motivo</span><div class=\"lu-ta err\"><div class=\"tx ph\">Obrigatório</div></div><span class=\"lu-help err\"><i class=\"sm\" data-i=\"warn-circle\"></i>Informe o motivo do cancelamento</span></div></div>", "lang": "heex", "code": "<.textarea value=\"Cancelado a pedido do cliente.\" />\n<.textarea value=\"Obrigatório\" />"}, {"t": "Valores da API que completam a paridade", "h": "<div class=\"lu-grid\" style=\"--cols:4;gap:14px\"><div class=\"lu-cell\"><div class=\"lu-helprow\"><span class=\"lu-cnt\">26 / 200</span></div><span class=\"lu-cap\">counter_align=end</span></div><div class=\"lu-cell\"><div class=\"lu-helprow lu-ta-c start\"><span class=\"lu-cnt\" style=\"margin-left:0\">26 / 200</span></div><span class=\"lu-cap\">counter_align=start</span></div><div class=\"lu-cell\"><div class=\"lu-ta ok\"><div class=\"tx\">Ok</div></div><span class=\"lu-cap\">state=success</span></div><div class=\"lu-cell\"><div class=\"lu-ta err\"><div class=\"tx\">Erro</div></div><span class=\"lu-cap\">state=error</span></div></div>", "lang": "heex", "code": "<.textarea counter_align=\"end\" />\n<.textarea counter_align=\"start\" variant=\"start\" />\n<.textarea value=\"Ok\" state=\"success\" />\n<.textarea value=\"Erro\" state=\"error\" />"}]