[{"t": "Básico — aura enquanto o assistente ou um processo externo trabalha", "h": "<div class=\"lu-col\" style=\"gap:16px;\"><span class=\"lu-aura m-spin t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Assistente lendo a nota</b><span>NF-e 48.211 · 44 itens</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-dual t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-success\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check-circle\"></i></span><div class=\"t\"><b>Conciliação pronta</b><span>18 lançamentos casados</span></div><button class=\"lu-b c-neutral v-outline s-sm sh-rounded\" type=\"button\">Revisar</button></div></span><span class=\"lu-aura m-glow t-warn w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-warning\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"alert\"></i></span><div class=\"t\"><b>Certificado vence hoje</b><span>Renove para continuar emitindo</span></div><button class=\"lu-b c-neutral v-solid s-sm sh-rounded\" type=\"button\">Renovar</button></div></span></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"dual\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"glow\" tone=\"warn\">\n  …\n</.aura>"}, {"t": "Exemplo", "h": "<b style=\"font-size:15px\">Posição padrão: centro, embaixo</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">Todo toast aparece centralizado embaixo (center-bottom), o mais novo por cima; a largura acompanha o texto, até 440px. Para um canto, passe position no toaster ou no send_toast.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-screen\"><div class=\"lines\"><i style=\"width:40%\"></i><i style=\"width:65%\"></i><i style=\"width:52%\"></i></div><div class=\"dock\"><div style=\"width:380px;max-width:100%\"><div class=\"lu-tcard c-success\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check-circle\"></i></span><div class=\"t\"><b>NF-e 48.211 autorizada</b><span>Protocolo 129 2611 0004 8211</span></div></div></div><div class=\"lu-stoast\" role=\"status\"><span class=\"lu-st\"><i></i></span><span class=\"msg\">Deploy <b>f798c00</b> está compilando em <b>nexus · main</b></span><button class=\"act\" type=\"button\">Cancelar</button></div></div></div></div>", "lang": "heex", "code": "<.toast_card kind=\"success\" title=\"NF-e 48.211 autorizada\" description=\"Protocolo 129 2611 0004 8211\" />\n<.status_toast status=\"run\" title=\"Deploy f798c00 está compilando em nexus · main\" action=\"Cancelar\" />"}, {"t": "Exemplo (2)", "h": "<b style=\"font-size:15px\">Progresso</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">O fundo se preenche até 100%; concluído fica verde e mostra o resultado; falha não some sozinha.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:12px;\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"fill\" style=\"transform:scaleX(.42)\"></span><span class=\"tile\"><i class=\"md\" data-i=\"file\"></i></span><div class=\"t\"><b>Emitindo NF-e do pedido #2491</b><span>Assinando o XML…</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span><span class=\"pct\">42%</span></div><div class=\"lu-tcard c-success done\" style=\"width:100%;\"><span class=\"fill\" style=\"transform:none\"></span><span class=\"tile\"><i class=\"md\" data-i=\"check\"></i></span><div class=\"t\"><b>NF-e 48.212 autorizada</b><span>Protocolo 129 2611 0004 8221</span></div><span class=\"pct\" style=\"color:var(--pos)\">100%</span></div><div class=\"lu-tcard c-error fail\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"x-circle\"></i></span><div class=\"t\"><b>Envio da planilha falhou</b><span>Linha 214: CNPJ inválido</span></div><button class=\"lu-b c-neutral v-outline s-sm sh-rounded\" type=\"button\">Tentar de novo</button></div></div></div>", "lang": "heex", "code": "<.toast_card kind=\"primary\" title=\"Emitindo NF-e do pedido #2491\" description=\"Assinando o XML…\" />\n<.toast_card kind=\"success\" title=\"NF-e 48.212 autorizada\" description=\"Protocolo 129 2611 0004 8221\" />\n<.toast_card kind=\"error\" title=\"Envio da planilha falhou\" description=\"Linha 214: CNPJ inválido\" />"}, {"t": "Exemplo (3)", "h": "<b style=\"font-size:15px\">Status (inverso)</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">Compacto e escuro nos dois temas, para processos longos: o círculo enche enquanto roda (ou mostra o % real), fila tracejada, ponto verde quando conclui e vermelho quando falha. Nomes em destaque, ação à direita.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:10px;align-items:flex-start\"><div class=\"lu-stoast\" role=\"status\"><span class=\"lu-st\"><i></i></span><span class=\"msg\">Deploy <b>f798c00</b> está compilando em <b>nexus · main</b></span><button class=\"act\" type=\"button\">Cancelar</button></div><div class=\"lu-stoast\" role=\"status\"><span class=\"lu-st queue\"><i></i></span><span class=\"msg\">Deploy <b>a41e2d9</b> na fila, <b>2 à frente</b></span><button class=\"act\" type=\"button\">Cancelar</button></div><div class=\"lu-stoast\" role=\"status\"><span class=\"dot ok\"></span><span class=\"msg\">Deploy <b>f798c00</b> publicado em <b>38s</b></span><button class=\"act ghost\" type=\"button\">Logs</button><button class=\"act\" type=\"button\">Abrir</button></div><div class=\"lu-stoast\" role=\"status\"><span class=\"dot err\"></span><span class=\"msg\">Deploy <b>c03b7e1</b> falhou na etapa <b>build</b></span><button class=\"act\" type=\"button\">Ver logs</button></div></div></div>", "lang": "heex", "code": "<.status_toast status=\"run\" title=\"Deploy f798c00 está compilando em nexus · main\" action=\"Cancelar\" />\n<.status_toast status=\"run\" title=\"Deploy a41e2d9 na fila, 2 à frente\" action=\"Cancelar\" />\n<.status_toast status=\"run\" title=\"Deploy f798c00 publicado em 38s\" action=\"Logs\" />\n<.status_toast status=\"run\" title=\"Deploy c03b7e1 falhou na etapa build\" action=\"Ver logs\" />"}, {"t": "Exemplo (4)", "h": "<b style=\"font-size:15px\">Status no ERP</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">O mesmo formato para lote de notas, importação e backup.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:10px;align-items:flex-start\"><div class=\"lu-stoast\" role=\"status\"><span class=\"lu-st\"><i></i></span><span class=\"msg\">Emitindo <b>32 NF-e</b> do lote <b>#118</b></span><button class=\"act\" type=\"button\">Cancelar</button></div><div class=\"lu-stoast\" role=\"status\"><span class=\"lu-st\" style=\"--stp:42%\"><i></i></span><span class=\"msg\">Importando <b>extrato BB</b>, <b>412 de 980</b> linhas</span><button class=\"act\" type=\"button\">Ocultar</button></div><div class=\"lu-stoast\" role=\"status\"><span class=\"dot ok\"></span><span class=\"msg\"><b>Backup</b> concluído, <b>1,2 GB</b></span><button class=\"act\" type=\"button\">Baixar</button></div></div></div>", "lang": "heex", "code": "<.status_toast status=\"run\" title=\"Emitindo 32 NF-e do lote #118\" action=\"Cancelar\" />\n<.status_toast status=\"run\" title=\"Importando extrato BB , 412 de 980 linhas\" action=\"Ocultar\" />\n<.status_toast status=\"run\" title=\"Backup concluído, 1,2 GB\" action=\"Baixar\" />"}, {"t": "Exemplo (5)", "h": "<b style=\"font-size:15px\">Variantes da aura</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">spin gira enquanto trabalha; dual (duas cores) quando o resultado fica pronto; glow pulsa, sem girar, quando precisa do usuário.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:12px;\"><span class=\"lu-aura m-spin t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Assistente conciliando o extrato</b><span>Banco do Brasil · 64 lançamentos</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-dual t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-success\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check-circle\"></i></span><div class=\"t\"><b>Resumo do mês pronto</b><span>Gerado de 1.284 pedidos</span></div><button class=\"lu-b c-neutral v-outline s-sm sh-rounded\" type=\"button\">Abrir</button></div></span><span class=\"lu-aura m-glow t-warn w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-warning\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"alert\"></i></span><div class=\"t\"><b>3 pedidos aguardam sua aprovação</b><span>Mercadinho Bom Preço e mais 2</span></div><button class=\"lu-b c-neutral v-solid s-sm sh-rounded\" type=\"button\">Revisar</button></div></span></div></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"dual\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"glow\" tone=\"warn\">\n  …\n</.aura>"}, {"t": "Exemplo (6)", "h": "<b style=\"font-size:15px\">Cores</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">aura_color segue o significado: assistant (teal + violeta), primary, info, success, warning, error.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:12px;\"><span class=\"lu-aura m-spin t-info w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-info\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"refresh\"></i></span><div class=\"t\"><b>Sincronizando estoque</b><span>Filial Serrinha</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-spin t-pos w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-success\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check\"></i></span><div class=\"t\"><b>Pagamento recebido</b><span>Pix · R$ 3.120,50</span></div></div></span><span class=\"lu-aura m-glow t-neg w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-error\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"x-circle\"></i></span><div class=\"t\"><b>SEFAZ recusou a nota</b><span>Rejeição 539 · duplicidade</span></div></div></span></div></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"info\">\n  …\n</.aura>\n<.aura motion=\"spin\" tone=\"pos\">\n  …\n</.aura>\n<.aura motion=\"glow\" tone=\"neg\">\n  …\n</.aura>"}, {"t": "Exemplo (7)", "h": "<b style=\"font-size:15px\">Espessura</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">aura_size xs (0,75px), sm (1px), padrão (1,25px) e lg (2px): fina por padrão; a mais grossa só para chamar atenção.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:12px;\"><span class=\"lu-aura m-spin t-ai w-xs shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Aura xs</b><span>Assistente trabalhando</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-spin t-ai w-sm shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Aura sm</b><span>Assistente trabalhando</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-spin t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Aura default</b><span>Assistente trabalhando</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-spin t-ai w-lg shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"sparkles\"></i></span><div class=\"t\"><b>Aura lg</b><span>Assistente trabalhando</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span></div></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>"}, {"t": "Exemplo (8)", "h": "<b style=\"font-size:15px\">Toast escuro</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">invert para destacar sobre telas claras; a aura continua visível.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:12px;\"><span class=\"lu-aura m-spin t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-primary dark\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"mic\"></i></span><div class=\"t\"><b>Transcrevendo a reunião</b><span>Revisão comercial · 38 min de áudio</span></div><span class=\"lu-sp v-border s-sm c-primary\" style=\"align-self:center\"></span></div></span><span class=\"lu-aura m-dual t-ai w-default shadow\" style=\"width:100%;--r:15px\"><div class=\"lu-tcard c-success dark\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check-circle\"></i></span><div class=\"t\"><b>Transcrição pronta</b><span>12 tarefas encontradas</span></div><button class=\"lu-b c-neutral v-soft s-sm sh-rounded\" type=\"button\">Ver</button></div></span></div></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"dual\" tone=\"ai\">\n  …\n</.aura>"}, {"t": "Exemplo (9)", "h": "<b style=\"font-size:15px\">Aura em qualquer elemento</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">&lt;.aura&gt; aplica o mesmo anel em botão, campo ou card.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-row\" style=\"gap:18px;align-items:center\"><span class=\"lu-aura m-spin t-ai w-sm r-pill\" style=\"width:auto;--r:15px\"><button class=\"lu-b c-neutral v-outline s-md sh-pill\" style=\"background:var(--bg-panel);border:0;gap:6px\" type=\"button\"><i class=\"\" data-i=\"sparkles\"></i>Gerar resumo</button></span><span class=\"lu-aura m-spin t-ai w-default r-r12\" style=\"width:auto;--r:15px\"><span class=\"lu-input\" style=\"border:0;width:300px\"><i class=\"\" data-i=\"sparkles\"></i><input readonly=\"\" value=\"Lendo o pedido por foto…\"/></span></span><span class=\"lu-aura m-dual t-ai w-default\" style=\"width:auto;--r:15px\"><div class=\"lu-panel\" style=\"border:0;padding:14px;width:300px;display:flex;flex-direction:column;gap:6px\"><b>Pedido #2492</b><span class=\"lu-xs lu-muted\">Assistente preenchendo 44 itens…</span><div class=\"lu-meter2\"><i style=\"width:70%\"></i></div></div></span></div></div>", "lang": "heex", "code": "<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"dual\" tone=\"ai\">\n  …\n</.aura>"}, {"t": "Exemplo (10)", "h": "<b style=\"font-size:15px\">Com desfazer</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">Ação reversível sem modal de confirmação.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-tcard c-neutral dark\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"trash\"></i></span><div class=\"t\"><b>Pedido #2488 excluído</b></div><button class=\"lu-b c-white v-soft s-sm sh-rounded\" type=\"button\">Desfazer</button><button aria-label=\"Fechar\" class=\"x\" type=\"button\"><i class=\"sm\" data-i=\"x\"></i></button></div></div>", "lang": "heex", "code": "<.toast_card kind=\"neutral\" title=\"Pedido #2488 excluído\" />"}, {"t": "Exemplo (11)", "h": "<b style=\"font-size:15px\">Erro</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">Diz o que fazer.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-tcard c-error\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"x-circle\"></i></span><div class=\"t\"><b>Não foi possível emitir</b><span>SEFAZ fora do ar. Tentaremos em 5 min.</span></div><button aria-label=\"Fechar\" class=\"x\" type=\"button\"><i class=\"sm\" data-i=\"x\"></i></button></div></div>", "lang": "heex", "code": "<.toast_card kind=\"error\" title=\"Não foi possível emitir\" description=\"SEFAZ fora do ar. Tentaremos em 5 min.\" />"}, {"t": "Exemplo (12)", "h": "<b style=\"font-size:15px\">Pilha</b><span class=\"lu-small lu-muted\" style=\"margin-bottom:6px\">Novos entram no topo; com o ponteiro em cima a pilha abre.</span><div style=\"padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)\"><div class=\"lu-col\" style=\"gap:8px;\"><div class=\"lu-tcard c-success\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"check\"></i></span><div class=\"t\"><b>NF-e 48.211 autorizada</b><span>agora</span></div><button aria-label=\"Fechar\" class=\"x\" type=\"button\"><i class=\"sm\" data-i=\"x\"></i></button></div><div class=\"lu-tcard c-primary\" style=\"width:100%;\"><span class=\"tile\"><i class=\"md\" data-i=\"bell\"></i></span><div class=\"t\"><b>Novo pedido #2492</b><span>há 1 min</span></div><button aria-label=\"Fechar\" class=\"x\" type=\"button\"><i class=\"sm\" data-i=\"x\"></i></button></div></div></div>", "lang": "heex", "code": "<.toast_card kind=\"success\" title=\"NF-e 48.211 autorizada\" description=\"agora\" />\n<.toast_card kind=\"primary\" title=\"Novo pedido #2492\" description=\"há 1 min\" />"}, {"t": "Valores da API que completam a paridade", "h": "<div class=\"lu-grid\" style=\"--cols:3;gap:14px\"><div class=\"lu-cell\"><div class=\"lu-tcard c-primary\" style=\"width:100%\"><span class=\"tile\"><i class=\"md\" data-i=\"bell\"></i></span><div class=\"t\"><b>Toast claro</b><span>tone=light</span></div></div><span class=\"lu-cap\">tone=light</span></div><div class=\"lu-cell\"><span class=\"lu-aura m-spin t-ai\" style=\"--r:15px;width:100%;--t1:var(--teal-500)\"><div class=\"lu-tcard\" style=\"width:100%\"><div class=\"t\"><b>accent</b></div></div></span><span class=\"lu-cap\">aura_tone=accent</span></div><div class=\"lu-cell\"><span class=\"lu-aura m-spin t-violet\" style=\"--r:15px;width:100%;--t1:var(--violet)\"><div class=\"lu-tcard\" style=\"width:100%\"><div class=\"t\"><b>violet</b></div></div></span><span class=\"lu-cap\">aura_tone=violet</span></div></div>", "lang": "heex", "code": "<.toast_card kind=\"primary\" title=\"Toast claro\" description=\"tone=light\" />\n<.aura motion=\"spin\" tone=\"ai\">\n  …\n</.aura>\n<.aura motion=\"spin\" tone=\"violet\">\n  …\n</.aura>"}]