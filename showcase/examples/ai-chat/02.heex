<div class="grid grid-cols-4 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.card variant="default" class="w-full">variant=default</.card><span class="font-mono text-[11px] text-muted">variant=default</span></div>
  <div class="flex flex-col items-start gap-1.5"><.card variant="muted" class="w-full">variant=canvas</.card><span class="font-mono text-[11px] text-muted">variant=canvas</span></div>
  <div class="flex flex-col items-start gap-1.5"><.ai_chat id="chat-v3" variant="bare" start={false} composer={false} class="w-full">variant=bare</.ai_chat><span class="font-mono text-[11px] text-muted">variant=bare</span></div>
  <div class="flex flex-col items-start gap-1.5"><.card variant="default" class="w-full rounded-[16px]">variant=page</.card><span class="font-mono text-[11px] text-muted">variant=page</span></div>
</div>
