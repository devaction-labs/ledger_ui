<.ai_chat
  id="ledgerly-ai"
  start={false}
  style="height:520px;max-width:640px"
  placeholder="Pergunte sobre receita, churn ou contas…"
  mention
  mention_label="Mencionar conta"
  context={[%{label: "Cohorts", icon: "table"}]}
  on_send="send"
>
  <:header>
    <span class="lu-ic lime"><.icon name="sparkles" size="md" /></span>
    <b>Ledgerly AI</b>
    <span class="lu-badge sm acc">Beta</span>
    <span class="lu-grow"></span>
    <button aria-label="Histórico" class="lu-btn icon ghost sm" type="button"><.icon name="history" /></button>
    <button aria-label="Fechar" class="lu-btn icon ghost sm" type="button"><.icon name="x" /></button>
  </:header>
  <.ai_message role="user">Por que o churn subiu em outubro?</.ai_message>
  <.ai_message variant="plain" actions={~w(copy useful useless regenerate)}>
    <div>O churn subiu <b>0,4 pts</b> por causa de <b>23 contas</b>. Dessas, <b>7 de 11</b> cancelamentos Pro vieram logo após uma falha de pagamento.</div>
    <div class="lu-panel" style="padding:10px 12px;display:flex;gap:10px;align-items:center"><span class="lu-badge neg">−$3,400 MRR</span><span class="lu-small lu-grow">Recuperável com retentativa inteligente</span><button class="lu-btn sm accent" type="button">Recover</button></div>
  </.ai_message>
</.ai_chat>
