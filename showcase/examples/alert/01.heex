<div class="lu-al-in"><.alert color="warning" variant="soft" style="display:flex;gap:10px;padding:12px 14px;border-radius:12px;background:var(--c-soft);color:var(--c-ink)"><:icon><.icon name="alert" /></:icon><span><b>Certificado vence em 3 dias.</b> Renove para continuar emitindo.</span></.alert></div>
