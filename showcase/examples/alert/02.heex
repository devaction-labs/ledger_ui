  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="solid"><:icon><.icon name="info" /></:icon><div class="t"><b>Neutral</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="solid"><:icon><.icon name="sparkles" /></:icon><div class="t"><b>Primary</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="solid"><:icon><.icon name="ai" /></:icon><div class="t"><b>Secondary</b><span>Contexto curto.</span></div></.alert></div>
