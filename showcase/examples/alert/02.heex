<div class="grid grid-cols-[70px_repeat(8,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5">
  <span></span>
  <span :for={c <- ~w(neutral primary secondary info success warning error dark)} class="text-center font-mono text-xs text-muted">{c}</span>
  <%= for v <- ~w(canvas soft bordered outline solid) do %>
    <span class="font-mono text-xs text-muted">{v}</span>
    <div :for={{c, icon} <- [{"neutral", "info"}, {"primary", "sparkles"}, {"secondary", "ai"}, {"info", "info"}, {"success", "check-circle"}, {"warning", "alert"}, {"error", "x-circle"}, {"dark", "info"}]} class="flex min-w-0 justify-center">
      <.alert color={c} variant={v} title={String.capitalize(c)} description="Contexto curto."><:icon><.icon name={icon} /></:icon></.alert>
    </div>
  <% end %>
</div>
