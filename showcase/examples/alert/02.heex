<div style="display:grid;grid-template-columns:70px repeat(8, minmax(0,1fr));gap:10px 12px;align-items:center">
  <span></span>
  <span class="lu-xs lu-muted mono" style="text-align:center">neutral</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">primary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">secondary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">info</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">success</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">warning</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">error</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">dark</span>
  <span class="lu-xs lu-muted mono">canvas</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="canvas" title="Neutral" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="canvas" title="Primary" description="Contexto curto."><:icon><.icon name="sparkles" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="canvas" title="Secondary" description="Contexto curto."><:icon><.icon name="ai" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="canvas" title="Info" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="canvas" title="Success" description="Contexto curto."><:icon><.icon name="check-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="canvas" title="Warning" description="Contexto curto."><:icon><.icon name="alert" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="canvas" title="Error" description="Contexto curto."><:icon><.icon name="x-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="canvas" title="Dark" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <span class="lu-xs lu-muted mono">soft</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="soft" title="Neutral" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="soft" title="Primary" description="Contexto curto."><:icon><.icon name="sparkles" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="soft" title="Secondary" description="Contexto curto."><:icon><.icon name="ai" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="soft" title="Info" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="soft" title="Success" description="Contexto curto."><:icon><.icon name="check-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="soft" title="Warning" description="Contexto curto."><:icon><.icon name="alert" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="soft" title="Error" description="Contexto curto."><:icon><.icon name="x-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="soft" title="Dark" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <span class="lu-xs lu-muted mono">bordered</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="bordered" title="Neutral" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="bordered" title="Primary" description="Contexto curto."><:icon><.icon name="sparkles" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="bordered" title="Secondary" description="Contexto curto."><:icon><.icon name="ai" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="bordered" title="Info" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="bordered" title="Success" description="Contexto curto."><:icon><.icon name="check-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="bordered" title="Warning" description="Contexto curto."><:icon><.icon name="alert" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="bordered" title="Error" description="Contexto curto."><:icon><.icon name="x-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="bordered" title="Dark" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <span class="lu-xs lu-muted mono">outline</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="outline" title="Neutral" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="outline" title="Primary" description="Contexto curto."><:icon><.icon name="sparkles" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="outline" title="Secondary" description="Contexto curto."><:icon><.icon name="ai" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="outline" title="Info" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="outline" title="Success" description="Contexto curto."><:icon><.icon name="check-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="outline" title="Warning" description="Contexto curto."><:icon><.icon name="alert" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="outline" title="Error" description="Contexto curto."><:icon><.icon name="x-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="outline" title="Dark" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <span class="lu-xs lu-muted mono">solid</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="solid" title="Neutral" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="solid" title="Primary" description="Contexto curto."><:icon><.icon name="sparkles" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="solid" title="Secondary" description="Contexto curto."><:icon><.icon name="ai" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="solid" title="Info" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="solid" title="Success" description="Contexto curto."><:icon><.icon name="check-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="solid" title="Warning" description="Contexto curto."><:icon><.icon name="alert" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="solid" title="Error" description="Contexto curto."><:icon><.icon name="x-circle" /></:icon></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="solid" title="Dark" description="Contexto curto."><:icon><.icon name="info" /></:icon></.alert></div>
</div>
