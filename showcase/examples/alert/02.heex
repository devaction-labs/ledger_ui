<div style="display:grid;grid-template-columns:70px repeat(8, minmax(0,1fr));gap:10px 12px;align-items:center">
  <span></span>
  <span class="lu-xs lu-muted mono" style="text-align:center">neutral</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">primary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">secondary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">info</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">success</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">warning</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">error</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">dark</span>
  <span class="lu-xs lu-muted mono">canvas</span>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="neutral" variant="canvas"><:icon><.icon name="info" /></:icon><div class="t"><b>Neutral</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="primary" variant="canvas"><:icon><.icon name="sparkles" /></:icon><div class="t"><b>Primary</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="secondary" variant="canvas"><:icon><.icon name="ai" /></:icon><div class="t"><b>Secondary</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="info" variant="canvas"><:icon><.icon name="info" /></:icon><div class="t"><b>Info</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="success" variant="canvas"><:icon><.icon name="check-circle" /></:icon><div class="t"><b>Success</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="canvas"><:icon><.icon name="alert" /></:icon><div class="t"><b>Warning</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="canvas"><:icon><.icon name="x-circle" /></:icon><div class="t"><b>Error</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="dark" variant="canvas"><:icon><.icon name="info" /></:icon><div class="t"><b>Dark</b><span>Contexto curto.</span></div></.alert></div>
