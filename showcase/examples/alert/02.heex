  <div style="display:flex;justify-content:center;min-width:0"><.alert color="warning" variant="soft"><:icon><.icon name="alert" /></:icon><div class="t"><b>Warning</b><span>Contexto curto.</span></div></.alert></div>
  <div style="display:flex;justify-content:center;min-width:0"><.alert color="error" variant="soft"><:icon><.icon name="x-circle" /></:icon><div class="t"><b>Error</b><span>Contexto curto.</span></div></.alert></div>
