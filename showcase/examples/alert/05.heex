<div class="lu-grid" style="--cols:2;gap:14px">
  <div class="lu-cell"><.alert color="warning" variant={nil} role={nil} accent="left" style="padding:12px 14px;border-radius:12px;background:var(--c-soft);color:var(--c-ink);width:100%">Certificado vence em 3 dias</.alert><span class="lu-cap">accent=left</span></div>
  <div class="lu-cell"><.alert color="warning" variant={nil} role={nil} accent="right" style="padding:12px 14px;border-radius:12px;background:var(--c-soft);color:var(--c-ink);width:100%">Certificado vence em 3 dias</.alert><span class="lu-cap">accent=right</span></div>
</div>
