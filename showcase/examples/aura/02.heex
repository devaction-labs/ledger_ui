<div class="lu-row" style="gap:12px"><.aura tone="accent"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">accent</span></.aura><.aura tone="ai"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">ai</span></.aura><.aura tone="info"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">info</span></.aura><.aura tone="pos"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">pos</span></.aura><.aura tone="warn"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">warn</span></.aura><.aura tone="neg"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">neg</span></.aura><.aura tone="violet"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">violet</span></.aura></div>
