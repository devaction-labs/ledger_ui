<div class="lu-row" style="gap:16px"><.aura tone="ai" width="xs"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">width=xs</span></.aura><.aura tone="ai" width="sm"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">width=sm</span></.aura><.aura tone="ai" width="default"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">width=default</span></.aura><.aura tone="ai" width="lg"><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">width=lg</span></.aura>
<.aura tone="ai" width="sm" radius="pill"><button class="lu-b c-neutral v-solid s-md sh-pill" type="button"><.icon name="sparkles" />Resumir com IA</button></.aura><.aura tone="accent" radius="r12" shadow><span style="display:block;background:var(--bg-panel);padding:12px 16px;font-size:13.5px;white-space:nowrap">r12 + shadow</span></.aura></div>
