<div class="flex flex-wrap items-center gap-4">
  <.aura :for={w <- ~w(xs sm default lg)} tone="ai" width={w}><span class="block bg-panel px-4 py-3 text-[13.5px] whitespace-nowrap">width={w}</span></.aura>
  <.aura tone="ai" width="sm" radius="pill"><.button color="neutral" variant="solid" size="md" shape="pill"><.icon name="sparkles" />Resumir com IA</.button></.aura>
  <.aura tone="accent" radius="r12" shadow><span class="block bg-panel px-4 py-3 text-[13.5px] whitespace-nowrap">r12 + shadow</span></.aura>
</div>
