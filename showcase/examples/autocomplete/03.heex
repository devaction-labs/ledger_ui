<div class="lu-col" style="gap:6px;width:380px">
  <.autocomplete id="ac03" open display_value="orb" options={[%{label: "Orbit Cloud", value: "orbit", initials: "OC", hint: "Pro · $4.2k"}, %{label: "Orbital Labs", value: "orbital", initials: "OL", hint: "Scale · $1.9k"}, %{label: "Orbis Systems", value: "orbis", initials: "OS", hint: "Starter · $340"}]}>
    <:option :let={o}><span><b>{String.slice(o.label, 0, 3)}</b>{String.slice(o.label, 3..-1//1)}</span></:option>
  </.autocomplete>
</div>
