<div class="flex flex-col gap-2.5"><div :for={{i, t, n, r, d} <- [{"AN", "t1", "Ana Nogueira", "Financeiro", "0.0s"}, {"CA", "t3", "Carlos André", "Desenvolvimento", "0.3s"}, {"FP", "t2", "Fernando Pinto", "Produto", "0.6s"}]} class="flex min-w-0 items-center gap-2.5 animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite] [animation-delay:var(--dl,0s)]" style={"--dl:#{d}"}><.avatar initials={i} color={t} size="md" /><span class="flex min-w-0 flex-col text-muted"><b class="truncate text-sm leading-[19px] font-semibold">{n}</b><span class="truncate text-[12.5px] leading-[17px] text-muted">{r}</span></span></div></div>
