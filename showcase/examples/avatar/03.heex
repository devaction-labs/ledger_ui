<div class="flex flex-wrap items-start gap-2.5"><div :for={s <- ~w(circle square rounded squircle reuleaux-triangle diamond hexagon hexagon-2 octagon star star-2 heart)} class="flex flex-col gap-1"><.avatar initials="AN" color="primary" shape={s} size="44" /><span class="font-mono text-xs text-muted">{s}</span></div></div>
