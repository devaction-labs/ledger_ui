<div style="display:grid;grid-template-columns:90px repeat(4, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span :for={v <- ~w(solid soft bordered skeleton)} class="lu-xs lu-muted mono" style="text-align:center">{v}</span><%= for c <- ~w(auto neutral primary secondary info success warning error) do %><span class="lu-xs lu-muted mono">{c}</span><div :for={v <- ~w(solid soft bordered skeleton)} style="display:flex;justify-content:center;min-width:0"><.avatar initials="BP" color={if c == "auto", do: "primary", else: c} variant={v} size="40" /></div><% end %></div>
