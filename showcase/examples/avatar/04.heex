<div class="grid grid-cols-[90px_repeat(4,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span :for={v <- ~w(solid soft bordered skeleton)} class="text-center font-mono text-xs text-muted">{v}</span><%= for c <- ~w(auto neutral primary secondary info success warning error) do %><span class="font-mono text-xs text-muted">{c}</span><div :for={v <- ~w(solid soft bordered skeleton)} class="flex min-w-0 justify-center"><.avatar initials="BP" color={if c == "auto", do: "primary", else: c} variant={v} size="40" /></div><% end %></div>
