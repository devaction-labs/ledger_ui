<div class="flex flex-wrap items-start gap-2.5"><div :for={k <- ~w(company customer supplier assistant invite)} class="flex flex-col gap-1"><.avatar kind={k} size="40" /><span class="font-mono text-xs text-muted">{k}</span></div><div :for={{s, l} <- [{"online", "on"}, {"away", "away"}, {"busy", "busy"}, {"offline", "off"}]} class="flex flex-col gap-1"><.avatar initials="AN" color="primary" variant="soft" size="40" status={s} ping /><span class="font-mono text-xs text-muted">{l}</span></div></div>
