<div class="lu-row lu-start"><div :for={k <- ~w(company customer supplier assistant invite)} class="lu-col" style="gap:4px"><.avatar kind={k} size="40" /><span class="lu-xs lu-muted mono">{k}</span></div><div :for={{s, l} <- [{"online", "on"}, {"away", "away"}, {"busy", "busy"}, {"offline", "off"}]} class="lu-col" style="gap:4px"><.avatar initials="AN" color="primary" variant="soft" size="40" status={s} ping /><span class="lu-xs lu-muted mono">{l}</span></div></div>
