<div class="flex flex-col gap-4"><div class="grid grid-cols-10 gap-3.5"><div :for={s <- ~w(xs-plus sm-plus 24 26 30 32 40 44 48 64)} class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size={s} /><span class="font-mono text-[11px] text-muted">size={s}</span></div></div><div class="grid grid-cols-7 gap-3.5"><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" ping /><span class="font-mono text-[11px] text-muted">status=online</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="offline" ping /><span class="font-mono text-[11px] text-muted">status=offline</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status={false} /><span class="font-mono text-[11px] text-muted">status=false</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="bottom-right" ping /><span class="font-mono text-[11px] text-muted">status_position=bottom-right</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="bottom-left" ping /><span class="font-mono text-[11px] text-muted">status_position=bottom-left</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="top-right" ping /><span class="font-mono text-[11px] text-muted">status_position=top-right</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="top-left" ping /><span class="font-mono text-[11px] text-muted">status_position=top-left</span></div></div><div class="grid grid-cols-11 gap-3.5"><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" ring /><span class="font-mono text-[11px] text-muted">ring=true</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" ring={1} /><span class="font-mono text-[11px] text-muted">ring=1</span></div><div class="flex flex-col items-start gap-1.5"><.avatar initials="AN" color="primary" variant="soft" size="40" ring={false} /><span class="font-mono text-[11px] text-muted">ring=false</span></div><div class="flex flex-col items-start gap-1.5"><span style="background:var(--lu-inverse);padding:6px;border-radius:12px"><.avatar initials="AN" color="primary" variant="soft" size="40" ring ring_color="white" /></span><span class="font-mono text-[11px] text-muted">ring_color=white</span></div><div :for={g <- ~w(amber-orange fuchsia-pink green-fuchsia pink-rose purple-indigo purple-orange sky-blue)} class="flex flex-col items-start gap-1.5"><.avatar initials="AN" size="40" gradient={g} /><span class="font-mono text-[11px] text-muted">gradient={g}</span></div></div><div class="grid grid-cols-4 gap-3.5"><div :for={o <- ~w(3 7)} class="flex flex-col items-start gap-1.5"><.avatar_group overlap={o} style="display:inline-flex"><.avatar :for={i <- ~w(AN CA FP)} initials={i} color="primary" variant="soft" size="32" /></.avatar_group><span class="font-mono text-[11px] text-muted">overlap={o}</span></div></div></div>
