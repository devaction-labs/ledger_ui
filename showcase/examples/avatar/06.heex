<div class="lu-col" style="gap:16px"><div class="lu-grid" style="--cols:10;gap:14px"><div :for={s <- ~w(xs-plus sm-plus 24 26 30 32 40 44 48 64)} class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size={s} /><span class="lu-cap">size={s}</span></div></div><div class="lu-grid" style="--cols:7;gap:14px"><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" ping /><span class="lu-cap">status=online</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="offline" ping /><span class="lu-cap">status=offline</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status={false} /><span class="lu-cap">status=false</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="bottom-right" ping /><span class="lu-cap">status_position=bottom-right</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="bottom-left" ping /><span class="lu-cap">status_position=bottom-left</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="top-right" ping /><span class="lu-cap">status_position=top-right</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" status="online" status_position="top-left" ping /><span class="lu-cap">status_position=top-left</span></div></div><div class="lu-grid" style="--cols:11;gap:14px"><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" ring /><span class="lu-cap">ring=true</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" ring={1} /><span class="lu-cap">ring=1</span></div><div class="lu-cell"><.avatar initials="AN" color="primary" variant="soft" size="40" ring={false} /><span class="lu-cap">ring=false</span></div><div class="lu-cell"><span style="background:var(--inverse);padding:6px;border-radius:12px"><.avatar initials="AN" color="primary" variant="soft" size="40" ring ring_color="white" /></span><span class="lu-cap">ring_color=white</span></div><div :for={g <- ~w(amber-orange fuchsia-pink green-fuchsia pink-rose purple-indigo purple-orange sky-blue)} class="lu-cell"><.avatar initials="AN" size="40" gradient={g} /><span class="lu-cap">gradient={g}</span></div></div><div class="lu-grid" style="--cols:4;gap:14px"><div :for={o <- ~w(3 7)} class="lu-cell"><.avatar_group overlap={o} style="display:inline-flex"><.avatar :for={i <- ~w(AN CA FP)} initials={i} color="primary" variant="soft" size="32" /></.avatar_group><span class="lu-cap">overlap={o}</span></div></div></div>
