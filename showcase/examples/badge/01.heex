<div class="flex flex-wrap items-center gap-2.5"><.badge color="error" variant="solid" shape="pill" class="animate-[mo-pulse_2s_ease-in-out_infinite]">3</.badge><.badge canvas color="primary" class="uppercase tracking-[.06em] text-[11px] font-semibold" dot="live">Ao vivo</.badge><.badge color="success" variant="soft"><span class="animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite]">Pago</span></.badge><.badge color="primary" variant="glow" class="animate-[mo-glow_2.4s_ease-in-out_infinite]">Novo</.badge></div>
