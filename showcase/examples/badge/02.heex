<div style="display:grid;grid-template-columns:80px repeat(5, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span :for={v <- ~w(solid glow soft outline flat)} class="lu-xs lu-muted mono" style="text-align:center">{v}</span><%= for c <- ~w(neutral primary secondary info success warning error dark light white) do %><span class="lu-xs lu-muted mono">{c}</span><div :for={v <- ~w(solid glow soft outline flat)} style="display:flex;justify-content:center;min-width:0"><.badge color={c} variant={v}>{String.capitalize(c)}</.badge></div><% end %></div>
