<div class="lu-panel" style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--accent-soft)">
  <label class="lu-check m-loop"><input aria-label="Seleção" type="checkbox" /></label>
  <b class="num mo-count" style="--to:25;--suf:' selecionados'"></b>
  <span class="lu-grow"></span>
  <button class="lu-btn sm" type="button"><.icon name="download" />Exportar</button>
</div>
