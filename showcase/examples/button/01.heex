<div class="flex flex-wrap items-center gap-2.5"><.button color="mono" class="animate-[mo-bpress_3s_infinite]">Salvar</.button><span class="inline-grid *:[grid-area:1/1]"><span class="animate-[lu-sw-a_4s_ease-in-out_infinite]"><.button color="primary"><.spinner color="white" variant="border" size="xs" label={nil} />Emitindo…</.button></span><span class="opacity-0 animate-[lu-sw-b_4s_ease-in-out_infinite]"><.button color="success"><.icon name="check" />Emitida</.button></span></span><span class="inline-flex rounded-[10px] [--c:var(--color-accent)] animate-[mo-glow_2.4s_ease-in-out_infinite]"><.button color="primary" variant="glow">Assinar plano</.button></span></div>
