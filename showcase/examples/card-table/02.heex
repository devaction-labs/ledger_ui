<% badge_color = fn "pos" -> "success"; "neg" -> "error"; _ -> "neutral" end %>
<% rows = [%{no: "PED-2491", cl: "Mercadinho Bom Preço", tone: "pos", st: "Pago", tot: "R$ 1.284,90", h: "14:02", dl: "0.00", sub: "↳ 3 itens · Arroz 5 kg, Óleo 900 ml, Café 500 g"}, %{no: "PED-2492", cl: "Padaria Central", tone: "", st: "Aberto", tot: "R$ 312,00", h: "14:40", dl: "0.35"}, %{no: "PED-2493", cl: "Farmácia Vida", tone: "neg", st: "Atrasado", tot: "R$ 2.940,10", h: "ontem", dl: "0.70"}] %>
<div class="lu-grid" style="--cols:2;gap:16px">
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">rows</span>
    <.card_table id="ct-rows" rows={rows} row_attrs={&%{style: "--dl:#{&1.dl}s"}} row_expanded={&Map.has_key?(&1, :sub)}>
      <:col :let={o} label="Pedido" class="mono">{o.no}</:col>
  <:col :let={o} label="Cliente">{o.cl}</:col>
  <:col :let={o} label="Status"><.badge canvas color={badge_color.(o.tone)} dot>{o.st}</.badge></:col>
  <:col :let={o} label="Total" align="right" class="strong">{o.tot}</:col>
  <:col :let={o} label="Hora" align="right" class="lu-muted">{o.h}</:col>
      <:expand :let={o}>{o.sub}</:expand>
    </.card_table>
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">flat</span>
    <.card_table id="ct-flat" variant="flat" rows={rows} row_attrs={&%{style: "--dl:#{&1.dl}s"}}>
      <:col :let={o} label="Pedido" class="mono">{o.no}</:col>
  <:col :let={o} label="Cliente">{o.cl}</:col>
  <:col :let={o} label="Status"><.badge canvas color={badge_color.(o.tone)} dot>{o.st}</.badge></:col>
  <:col :let={o} label="Total" align="right" class="strong">{o.tot}</:col>
  <:col :let={o} label="Hora" align="right" class="lu-muted">{o.h}</:col>
    </.card_table>
  </div>
</div>
