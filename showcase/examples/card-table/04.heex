<div class="grid grid-cols-4 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.chip>Total <.icon name="arrow-up" size="sm" /></.chip><span class="font-mono text-[11px] text-muted">sort_dir=asc</span></div>
  <div class="flex flex-col items-start gap-1.5"><.chip>Total <.icon name="arrow-down" size="sm" /></.chip><span class="font-mono text-[11px] text-muted">sort_dir=desc</span></div>
</div>
