<div class="lu-col" style="gap:10px"><div class="lu-grid" style="--cols:6;gap:8px"><.card :for={c <- ~w(primary secondary info success warning error)} variant="solid" color={c}><:title>solid</:title><span>Faturamento do mês</span></.card></div><div class="lu-grid" style="--cols:5;gap:8px"><.card :for={g <- ~w(purple-indigo fuchsia-pink amber-orange sky-blue green-fuchsia)} variant="gradient" gradient={g}><:title>{g}</:title><span>Faturamento do mês</span></.card></div></div>
