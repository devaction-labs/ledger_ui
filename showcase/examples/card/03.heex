<div class="flex flex-col gap-2.5"><div class="grid grid-cols-6 gap-2"><.card :for={c <- ~w(primary secondary info success warning error)} variant="solid" color={c}><:title>solid</:title><span>Faturamento do mês</span></.card></div><div class="grid grid-cols-5 gap-2"><.card :for={g <- ~w(purple-indigo fuchsia-pink amber-orange sky-blue green-fuchsia)} variant="gradient" gradient={g}><:title>{g}</:title><span>Faturamento do mês</span></.card></div></div>
