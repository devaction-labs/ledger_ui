<div class="lu-row"><.card variant="default" color={nil} gradient={nil} size="xs"><:title>xs</:title></.card><.card variant="default" color={nil} gradient={nil} size="sm"><:title>sm</:title></.card><.card variant="default" color={nil} gradient={nil} style="padding:14px;min-height:0"><:title>md</:title></.card><.card variant="default" color={nil} gradient={nil} size="lg"><:title>lg</:title></.card><span :for={b <- ~w(seamless divided separated inset flush)} class="lu-chip">{b}</span></div>
