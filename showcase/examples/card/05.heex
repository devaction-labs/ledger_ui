<div class="lu-grid" style="--cols:2;gap:16px"><.card canvas><.card_header><.card_heading level={3}>Revenue by plan</.card_heading><.card_actions><button class="lu-btn sm" type="button">Plans<.icon name="arrow-up-right" /></button></.card_actions></.card_header><.card_body><div class="lu-col" style="gap:8px"><div class="lu-skel" style="width:60%"></div><div class="lu-skel" style="width:85%"></div><div class="lu-skel" style="width:40%"></div></div></.card_body></.card><.card canvas><.card_header><.card_heading level={3}>MRR movement</.card_heading><.card_actions><button aria-label="Mais" class="lu-btn icon sm" type="button"><.icon name="more-h" /></button></.card_actions></.card_header><.card_body><div class="lu-chart-head"><b>+$14,860</b><span class="lu-muted">net new in October</span></div></.card_body></.card><.card canvas><.card_header><.card_heading level={3}>AI insights <.badge canvas color="lime"><.icon name="sparkles" />3 new</.badge></.card_heading><.card_actions><button aria-label="Abrir chat" class="lu-btn icon sm" type="button"><.icon name="message" /></button></.card_actions></.card_header><.card_body><p class="lu-muted" style="margin:0">Conteúdo do painel.</p></.card_body><.card_footer><span class="lu-delta up">2 pts</span> trailing 12 mo</.card_footer></.card><.card canvas variant="flat"><.card_body style={false}><b>Card plano</b><p class="lu-muted" style="margin:6px 0 0">Sem bandeja, para listas e conteúdo simples.</p></.card_body></.card></div>
