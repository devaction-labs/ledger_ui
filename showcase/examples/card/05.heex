<div class="flex flex-col gap-4"><div class="grid grid-cols-4 gap-3.5"><div :for={{a, css} <- [{"start", "flex-start"}, {"center", "center"}, {"end", "flex-end"}, {"between", "stretch"}]} class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} style={"width:100%;align-items:#{css}"}><:title>Título</:title><span>align={a}</span></.card><span class="font-mono text-[11px] text-muted">align={a}</span></div></div><div class="grid grid-cols-6 gap-3.5"><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} style="border-radius:10px;width:100%"><:title>rounded</:title></.card><span class="font-mono text-[11px] text-muted">shape=rounded</span></div><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} shape="xl" style="width:100%"><:title>xl</:title></.card><span class="font-mono text-[11px] text-muted">shape=xl</span></div><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} style="padding:14px;width:100%"><:title>base</:title></.card><span class="font-mono text-[11px] text-muted">size=base</span></div><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} style="padding:28px;width:100%"><:title>xl</:title></.card><span class="font-mono text-[11px] text-muted">size=xl</span></div><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} padded={false} style="width:100%"><b style="padding:12px">Cabeçalho</b><span style="border-top:1px solid var(--line);padding:12px">Corpo</span></.card><span class="font-mono text-[11px] text-muted">divider=full</span></div><div class="flex flex-col items-start gap-1.5"><.card variant="default" color={nil} gradient={nil} style="width:100%"><b style="font-size:20px">Título h1</b></.card><span class="font-mono text-[11px] text-muted">level=1</span></div></div></div>
