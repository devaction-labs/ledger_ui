<div class="lu-col" style="gap:16px"><div class="lu-grid" style="--cols:4;gap:14px"><div :for={{a, css} <- [{"start", "flex-start"}, {"center", "center"}, {"end", "flex-end"}, {"between", "stretch"}]} class="lu-cell"><.card color={nil} gradient={nil} style={"width:100%;align-items:#{css}"}><:title>Título</:title><span>align={a}</span></.card><span class="lu-cap">align={a}</span></div></div><div class="lu-grid" style="--cols:6;gap:14px"><div class="lu-cell"><.card color={nil} gradient={nil} style="border-radius:10px;width:100%"><:title>rounded</:title></.card><span class="lu-cap">shape=rounded</span></div><div class="lu-cell"><.card color={nil} gradient={nil} shape="xl" style="width:100%"><:title>xl</:title></.card><span class="lu-cap">shape=xl</span></div><div class="lu-cell"><.card color={nil} gradient={nil} style="padding:14px;width:100%"><:title>base</:title></.card><span class="lu-cap">size=base</span></div><div class="lu-cell"><.card color={nil} gradient={nil} style="padding:28px;width:100%"><:title>xl</:title></.card><span class="lu-cap">size=xl</span></div><div class="lu-cell"><.card color={nil} gradient={nil} padded={false} style="width:100%"><b style="padding:12px">Cabeçalho</b><span style="border-top:1px solid var(--line);padding:12px">Corpo</span></.card><span class="lu-cap">divider=full</span></div><div class="lu-cell"><.card color={nil} gradient={nil} style="width:100%"><b style="font-size:20px">Título h1</b></.card><span class="lu-cap">level=1</span></div></div></div>
