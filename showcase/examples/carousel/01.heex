<div class="grid grid-cols-2 gap-4"><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">slide</span><.carousel id="car-slide" pagination="bullets" slides={3} class="max-w-[560px]"><.carousel_slide :for={{bg, t, d} <- [{"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "0s"}, {"linear-gradient(135deg,#6a4fd8,#2b3577)", "Novo: NFC-e", "3s"}, {"linear-gradient(135deg,#e8b04a,#b07a2c)", "Black Friday", "6s"}, {"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "9s"}]} style={"background:#{bg};--dl:#{d}"}>{t}</.carousel_slide></.carousel></div><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">fade</span><.carousel id="car-fade" effect="fade" pagination="bullets" slides={3} class="max-w-[260px]"><.carousel_slide :for={{bg, t, d} <- [{"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "0s"}, {"linear-gradient(135deg,#6a4fd8,#2b3577)", "Novo: NFC-e", "3s"}, {"linear-gradient(135deg,#e8b04a,#b07a2c)", "Black Friday", "6s"}]} style={"background:#{bg};--dl:#{d}"}>{t}</.carousel_slide></.carousel></div></div>
