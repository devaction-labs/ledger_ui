<div class="lu-grid" style="--cols:2;gap:16px"><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">slide</span><.carousel id="car-slide" pagination="bullets" slides={3} style="max-width:560px"><.carousel_slide :for={{bg, t, d} <- [{"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "0s"}, {"linear-gradient(135deg,#6a4fd8,#2b3577)", "Novo: NFC-e", "3s"}, {"linear-gradient(135deg,#e8b04a,#b07a2c)", "Black Friday", "6s"}, {"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "9s"}]} style={"background:#{bg};--dl:#{d}"}>{t}</.carousel_slide></.carousel></div><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">fade</span><.carousel id="car-fade" effect="fade" pagination="bullets" slides={3} style="max-width:260px"><.carousel_slide :for={{bg, t, d} <- [{"linear-gradient(135deg,#1f9282,#0c4b44)", "Promoção de novembro", "0s"}, {"linear-gradient(135deg,#6a4fd8,#2b3577)", "Novo: NFC-e", "3s"}, {"linear-gradient(135deg,#e8b04a,#b07a2c)", "Black Friday", "6s"}]} style={"background:#{bg};--dl:#{d}"}>{t}</.carousel_slide></.carousel></div></div>
