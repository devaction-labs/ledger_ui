<div class="lu-col" style="gap:10px"><div class="lu-row" style="flex-wrap:nowrap;overflow:hidden;gap:12px"><div :for={{tone, icon, t, d} <- [{"lime", "sparkles", "Pergunte à IA", "Por que o churn subiu em outubro?"}, {"acc", "table", "Compare coortes", "Setembro reteve 97% no M1."}, {"info", "download", "Exporte o board pack", "PDF pronto em 1 clique."}, {nil, "users", "Convide a equipe", "Comentários e menções."}]} class="lu-panel" style="min-width:260px;padding:16px;display:flex;flex-direction:column;gap:8px"><span class={["lu-ic", tone]}><.icon name={icon} /></span><b>{t}</b><span class="lu-small lu-muted">{d}</span></div></div><div class="lu-row"><button aria-label="Anterior" class="lu-btn icon sm" type="button"><.icon name="chevron-left" /></button><button aria-label="Próximo" class="lu-btn icon sm" type="button"><.icon name="chevron-right" /></button><span class="lu-grow"></span><span class="lu-row" style="gap:4px"><i style="display:block;height:4px;border-radius:2px;width:18px;background:var(--ink)"></i><i :for={_ <- 1..3} style="display:block;height:4px;border-radius:2px;width:8px;background:var(--line-strong)"></i></span></div></div>
