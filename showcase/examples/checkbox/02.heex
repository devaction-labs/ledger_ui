<div style="display:grid;grid-template-columns:100px repeat(5, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">desmarcado</span><span class="lu-xs lu-muted mono" style="text-align:center">marcado</span><span class="lu-xs lu-muted mono" style="text-align:center">parcial</span><span class="lu-xs lu-muted mono" style="text-align:center">filled</span><span class="lu-xs lu-muted mono" style="text-align:center">desabilitado</span><span class="lu-xs lu-muted mono">neutral</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="neutral" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="neutral" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="neutral" indeterminate id="ind-neutral" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="neutral" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="neutral" disabled checked /></div><span class="lu-xs lu-muted mono">primary</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" indeterminate id="ind-primary" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" disabled checked /></div><span class="lu-xs lu-muted mono">secondary</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="secondary" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="secondary" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="secondary" indeterminate id="ind-secondary" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="secondary" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="secondary" disabled checked /></div><span class="lu-xs lu-muted mono">info</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="info" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="info" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="info" indeterminate id="ind-info" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="info" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="info" disabled checked /></div><span class="lu-xs lu-muted mono">success</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="success" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="success" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="success" indeterminate id="ind-success" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="success" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="success" disabled checked /></div><span class="lu-xs lu-muted mono">warning</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="warning" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="warning" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="warning" indeterminate id="ind-warning" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="warning" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="warning" disabled checked /></div><span class="lu-xs lu-muted mono">error</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="error" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="error" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="error" indeterminate id="ind-error" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="error" filled /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="error" disabled checked /></div></div>
