<div class="grid grid-cols-[100px_repeat(5,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span class="text-center font-mono text-xs text-muted">desmarcado</span><span class="text-center font-mono text-xs text-muted">marcado</span><span class="text-center font-mono text-xs text-muted">parcial</span><span class="text-center font-mono text-xs text-muted">filled</span><span class="text-center font-mono text-xs text-muted">desabilitado</span><span class="font-mono text-xs text-muted">neutral</span><div class="flex min-w-0 justify-center"><.checkbox color="neutral" /></div><div class="flex min-w-0 justify-center"><.checkbox color="neutral" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="neutral" indeterminate id="ind-neutral" /></div><div class="flex min-w-0 justify-center"><.checkbox color="neutral" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="neutral" disabled checked /></div><span class="font-mono text-xs text-muted">primary</span><div class="flex min-w-0 justify-center"><.checkbox color="primary" /></div><div class="flex min-w-0 justify-center"><.checkbox color="primary" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="primary" indeterminate id="ind-primary" /></div><div class="flex min-w-0 justify-center"><.checkbox color="primary" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="primary" disabled checked /></div><span class="font-mono text-xs text-muted">secondary</span><div class="flex min-w-0 justify-center"><.checkbox color="secondary" /></div><div class="flex min-w-0 justify-center"><.checkbox color="secondary" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="secondary" indeterminate id="ind-secondary" /></div><div class="flex min-w-0 justify-center"><.checkbox color="secondary" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="secondary" disabled checked /></div><span class="font-mono text-xs text-muted">info</span><div class="flex min-w-0 justify-center"><.checkbox color="info" /></div><div class="flex min-w-0 justify-center"><.checkbox color="info" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="info" indeterminate id="ind-info" /></div><div class="flex min-w-0 justify-center"><.checkbox color="info" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="info" disabled checked /></div><span class="font-mono text-xs text-muted">success</span><div class="flex min-w-0 justify-center"><.checkbox color="success" /></div><div class="flex min-w-0 justify-center"><.checkbox color="success" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="success" indeterminate id="ind-success" /></div><div class="flex min-w-0 justify-center"><.checkbox color="success" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="success" disabled checked /></div><span class="font-mono text-xs text-muted">warning</span><div class="flex min-w-0 justify-center"><.checkbox color="warning" /></div><div class="flex min-w-0 justify-center"><.checkbox color="warning" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="warning" indeterminate id="ind-warning" /></div><div class="flex min-w-0 justify-center"><.checkbox color="warning" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="warning" disabled checked /></div><span class="font-mono text-xs text-muted">error</span><div class="flex min-w-0 justify-center"><.checkbox color="error" /></div><div class="flex min-w-0 justify-center"><.checkbox color="error" checked /></div><div class="flex min-w-0 justify-center"><.checkbox color="error" indeterminate id="ind-error" /></div><div class="flex min-w-0 justify-center"><.checkbox color="error" filled /></div><div class="flex min-w-0 justify-center"><.checkbox color="error" disabled checked /></div></div>
