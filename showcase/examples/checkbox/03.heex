<div style="display:grid;grid-template-columns:90px repeat(4, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">xs</span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">square</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="xs" shape="square" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="sm" shape="square" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="md" shape="square" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="lg" shape="square" checked label="Rótulo" /></div><span class="lu-xs lu-muted mono">circle</span><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="xs" shape="circle" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="sm" shape="circle" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="md" shape="circle" checked label="Rótulo" /></div><div style="display:flex;justify-content:center;min-width:0"><.checkbox color="primary" size="lg" shape="circle" checked label="Rótulo" /></div></div>
