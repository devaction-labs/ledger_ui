<div class="grid grid-cols-4 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.checkbox color="primary" checked label="Emitir" /><span class="font-mono text-[11px] text-muted">variant=basic</span></div>
  <div class="flex flex-col items-start gap-1.5"><.checkbox color="primary" variant="outline" checked label="Emitir" /><span class="font-mono text-[11px] text-muted">variant=outline</span></div>
  <div class="flex flex-col items-start gap-1.5"><.checkbox_group id="cb05-card" variant="card" color="primary" class="w-[220px]" value={["nfe"]} options={[%{label: "Emitir NF-e", value: "nfe", description: "Ao confirmar"}]} /><span class="font-mono text-[11px] text-muted">variant=card</span></div>
  <div class="flex flex-col items-start gap-1.5"><.checkbox_group id="cb05-chip" variant="chip" color="primary" value={["emitir"]} options={[%{label: "Emitir", value: "emitir"}]} /><span class="font-mono text-[11px] text-muted">variant=chip</span></div>
</div>
