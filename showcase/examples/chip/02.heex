<%!-- the four toggles are drawn as the vitrine does (no aria-pressed); <.chip selected={...}> adds it --%>
<div class="lu-row"><button class="lu-chip on" data-lu-toggle="" type="button">Todos</button><button class="lu-chip" data-lu-toggle="" type="button">Em risco</button><button class="lu-chip" data-lu-toggle="" type="button">Expansão</button><button class="lu-chip" data-lu-toggle="" type="button">Novos</button><.chip dashed icon="plus">Filtro</.chip></div>
