<div class="lu-code"><div class="hd"><.icon name="code" size="sm" />lib/signetum/nfe.ex</div><pre><span class="ln2" style="--dl:0.00s"><span class="ln">1</span><span class="k">defmodule</span> <span class="f">Signetum.NFe</span> <span class="k">do</span></span><span class="ln2" style="--dl:0.35s"><span class="ln">2</span>  <span class="c"># emite e transmite à SEFAZ</span></span><span class="ln2" style="--dl:0.70s"><span class="ln">3</span>  <span class="k">def</span> <span class="f">emitir</span>(pedido) <span class="k">do</span></span><span class="ln2" style="--dl:1.05s"><span class="ln">4</span>    pedido |&gt; <span class="f">montar_xml</span>() |&gt; <span class="f">assinar</span>() |&gt; <span class="f">transmitir</span>()</span><span class="ln2" style="--dl:1.40s"><span class="ln">5</span>  <span class="k">end</span></span><span class="ln2" style="--dl:1.75s"><span class="ln">6</span><span class="k">end</span></span></pre></div>
