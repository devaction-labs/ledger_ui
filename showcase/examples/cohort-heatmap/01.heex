<div class="max-w-[560px]">
  <.card title="Cohort retention">
      <:actions>
        <span class="text-xs text-muted">Low</span>
        <span class="inline-flex items-center gap-[3px]"><i class="block size-2.5 rounded-[3px] bg-accent-100"></i><i class="block size-2.5 rounded-[3px] bg-accent-200"></i><i class="block size-2.5 rounded-[3px] bg-accent-400"></i><i class="block size-2.5 rounded-[3px] bg-accent-600"></i></span>
        <span class="text-xs text-muted">High</span>
      </:actions>
      <.cohort_heatmap
        columns={~w(M0 M1 M2 M3 M4 M5)}
        rows={[
        %{label: "Jan", values: [100, 94, 91, 88, 86, 85]},
        %{label: "Feb", values: [100, 95, 91, 89, 87, 85]},
        %{label: "Mar", values: [100, 93, 89, 86, 84, 82]},
        %{label: "Apr", values: [100, 95, 92, 90, 88, 86]},
        %{label: "May", values: [100, 96, 93, 90, 89, 87]},
        %{label: "Jun", values: [100, 94, 90, 88, 87, nil]},
        %{label: "Jul", values: [100, 96, 93, 91, nil, nil]},
        %{label: "Aug", values: [100, 95, 92, nil, nil, nil]},
        %{label: "Sep", values: [100, 97, nil, nil, nil, nil]},
        %{label: "Oct", values: [100, nil, nil, nil, nil, nil]}
        ]}
      />
  </.card>
</div>
