<% rows = [%{no: "PED-2491", cl: "Mercadinho Bom Preço", tone: "pos", st: "Pago", tot: "R$ 1.284,90", h: "14:02", dl: "0.00"}, %{no: "PED-2492", cl: "Padaria Central", tone: "", st: "Aberto", tot: "R$ 312,00", h: "14:40", dl: "0.35"}, %{no: "PED-2493", cl: "Farmácia Vida", tone: "neg", st: "Atrasado", tot: "R$ 2.940,10", h: "ontem", dl: "0.70"}, %{no: "PED-2494", cl: "Açougue Serrinha", tone: "pos", st: "Pago", tot: "R$ 860,00", h: "ontem", dl: "1.05"}] %>
<.data_table
  id="dt-bulk"
  rows={rows}
  style="position:relative;overflow:hidden"
  row_key={& &1.no}
  selected={[]}
  all_selected={false}
  on_select="select"
  on_select_all="select_all"
  select_all_label="Todos"
  select_label="Selecionar"
  row_attrs={&%{class: "animate-[mo-rowsel_6s_ease-in-out_var(--dl,0s)_infinite]", style: "--dl:#{&1.dl}s"}}
  select_attrs={&%{class: "[&_input]:animate-[lu-cbbox_6s_ease-in-out_var(--dl,0s)_infinite]", style: "--dl:#{&1.dl}s"}}
>
  <:toolbar>
    <.table_search id="dt-search" placeholder="Buscar pedido" width="220px" />
    <.button canvas size="sm"><.icon name="filter" size="md" />Filtrar</.button>
    <span class="min-w-0 flex-1"></span>
    <.button canvas size="sm"><.icon name="download" size="md" />Exportar</.button>
  </:toolbar>
  <:col :let={o} label="Pedido" class="font-mono text-[13px]">{o.no}</:col>
  <:col :let={o} label="Cliente">{o.cl}</:col>
  <:col :let={o} label="Status"><.badge canvas dot color={Map.get(%{"pos" => "success", "neg" => "error"}, o.tone, "neutral")}>{o.st}</.badge></:col>
  <:col :let={o} label="Total" align="right" class="font-medium text-ink">{o.tot}</:col>
  <:col :let={o} label="Hora" align="right" class="text-muted">{o.h}</:col>
  <:bulk>
    <div style="position:absolute;left:0;right:0;bottom:14px;display:flex;justify-content:center">
      <.bulk_bar id="dt-bulk-bar" count={3} label="selecionado" label_plural="selecionados" floating={false} class="animate-[mo-sel_6s_cubic-bezier(.2,.8,.2,1)_infinite]">
        <:action icon="file">Emitir NF-e</:action>
        <:action icon="download">Exportar</:action>
        <:action variant="danger" icon="trash">Excluir</:action>
      </.bulk_bar>
    </div>
    <div style="height:58px"></div>
  </:bulk>
</.data_table>
