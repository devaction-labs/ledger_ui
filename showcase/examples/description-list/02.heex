<div class="flex flex-col gap-4"><div :for={{label, cols, layout} <- [{"cols=1", 1, "stacked"}, {"cols=2", 2, "stacked"}, {"cols=3", 3, "stacked"}, {"cols=4", 4, "stacked"}, {"layout=inline", 2, "inline"}]} class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">{label}</span><.description_list cols={cols} layout={layout} class="my-3.5"><:item :for={{l, v, d} <- [{"Razão social", "Mercadinho Bom Preço Ltda", "0.00s"}, {"CNPJ", "12.345.678/0001-90", "0.25s"}, {"Regime", "Simples Nacional", "0.50s"}, {"Cidade", "Feira de Santana · BA", "0.75s"}, {"Desde", "jan 2024", "1.00s"}, {"Limite", "R$ 15.000,00", "1.25s"}]} label={l} wrapper_style={"--dl:#{d}"}>{v}</:item></.description_list></div></div>
