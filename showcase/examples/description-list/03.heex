<div class="lu-grid" style="--cols:2;gap:16px"><dl class="lu-panel" style="margin:0;padding:4px 16px"><div class="lu-row" style="justify-content:space-between;padding:10px 0;border-top:0"><dt class="lu-small lu-muted">Conta</dt><dd class="num" style="margin:0;font-weight:500">Orbit Cloud</dd></div><div class="lu-row" style="justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)"><dt class="lu-small lu-muted">Plano</dt><dd class="num" style="margin:0;font-weight:500"><.badge canvas color="primary">Pro</.badge></dd></div><div class="lu-row" style="justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)"><dt class="lu-small lu-muted">MRR</dt><dd class="num" style="margin:0;font-weight:500">$4,200</dd></div><div class="lu-row" style="justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)"><dt class="lu-small lu-muted">Assentos</dt><dd class="num" style="margin:0;font-weight:500">46 de 50</dd></div><div class="lu-row" style="justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)"><dt class="lu-small lu-muted">Renovação</dt><dd class="num" style="margin:0;font-weight:500">08/12/2026</dd></div></dl><dl class="lu-grid" style="--cols:2;margin:0;gap:14px"><div :for={{l, v} <- [{"ARPA", "$168"}, {"Clientes", "1,096"}, {"Churn", "2.1%"}, {"NRR", "108%"}]}><dt class="lu-xs lu-muted" style="text-transform:uppercase;letter-spacing:.06em">{l}</dt><dd style="margin:2px 0 0;font-weight:500">{v}</dd></div></dl></div>
