<div class="max-w-[420px]">
  <.card title="Revenue by plan">
      <:actions><.button canvas size="sm">Plans<.icon name="arrow-up-right" /></.button></:actions>
      <.donut_chart
        id="revenue-plan"
        label="Receita por plano"
        center_label="TOTAL MRR"
        center_value="$184.3k"
        segments={[
          %{name: "Pro", value: 96900, color: "var(--lu-chart-1)"},
          %{name: "Scale", value: 49020, color: "var(--lu-chart-2)"},
          %{name: "Starter", value: 38400, color: "var(--lu-chart-5)"}
        ]}
      />
  </.card>
</div>
