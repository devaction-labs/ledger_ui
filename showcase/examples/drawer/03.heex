<div class="flex flex-col gap-2">
  <div :for={{s, w, px} <- [{"sm", "w-[200px]", "400px"}, {"md", "w-[260px]", "520px"}, {"lg", "w-[320px]", "640px"}, {"wide", "w-[400px]", "800px"}, {"xl", "w-[540px]", "1080px"}]} class="flex flex-wrap items-center gap-2.5">
    <span class="w-11 font-mono text-xs text-muted">{s}</span>
    <div class={["flex h-[22px] items-center rounded-md bg-sunken px-2 font-mono text-xs text-muted shadow-[inset_0_0_0_1px_var(--lu-line)]", w]}>{px}</div>
  </div>
</div>
