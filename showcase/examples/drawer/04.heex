<.drawer id="drawer-account" inline placement="right" close_label="Fechar" style="height:420px;justify-content:flex-start;padding:0">
<:header style="padding-bottom:14px;border-bottom:1px solid var(--line)"><span class="lu-av t1 sq" style="--s:40px">OC</span><div><h3>Orbit Cloud</h3><p>Pro · desde jan 2026</p></div></:header>
<div class="lu-grid" style="--cols:2;gap:10px"><div class="lu-panel" style="padding:10px 12px"><div class="lu-xs lu-muted">MRR</div><b class="num">$4,200</b></div><div class="lu-panel" style="padding:10px 12px"><div class="lu-xs lu-muted">Assentos</div><b class="num">46/50</b></div><div class="lu-panel" style="padding:10px 12px"><div class="lu-xs lu-muted">NRR</div><b class="num">118%</b></div><div class="lu-panel" style="padding:10px 12px"><div class="lu-xs lu-muted">Saúde</div><b class="num">Boa</b></div></div><div class="lu-alert lime" style="background:var(--lime-soft);border-color:transparent"><.icon name="sparkles" /><div class="t"><b>Seat expansion ready</b><span>Acima de 90% dos assentos há 3 semanas.</span></div></div>
<:footer><button class="lu-btn ghost" type="button"><.icon name="external" />Abrir conta</button><button class="lu-btn primary" type="button">Propor upgrade</button></:footer>
</.drawer>
