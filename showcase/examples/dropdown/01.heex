<div class="flex flex-wrap items-center gap-2.5">
  <div class="relative h-[280px] w-[300px]">
    <.dropdown id="dd1-a" label="Ações" demo="click" highlight class="w-[220px]" anchor_class="absolute top-2.5 left-5">
<.dropdown_item style="--dl:0s"><:icon><.icon name="edit" /></:icon>Editar</.dropdown_item>
<.dropdown_item style="--dl:1s"><:icon><.icon name="copy" /></:icon>Duplicar</.dropdown_item>
<.dropdown_item style="--dl:2s"><:icon><.icon name="link" /></:icon>Compartilhar</.dropdown_item>
<.dropdown_item style="--dl:3s"><:icon><.icon name="folder" /></:icon>Arquivar</.dropdown_item>
<.dropdown_separator />
<.dropdown_item danger><:icon><.icon name="trash" /></:icon>Excluir</.dropdown_item>
    </.dropdown>
  </div>
  <div class="relative h-[280px] w-[300px]">
    <.dropdown id="dd1-b" toggle_icon="dots" toggle_label="Mais ações" placement="bottom-end" demo="click" highlight class="w-[220px]" anchor_class="absolute top-2.5 right-5">
<.dropdown_item style="--dl:0s"><:icon><.icon name="edit" /></:icon>Editar</.dropdown_item>
<.dropdown_item style="--dl:1s"><:icon><.icon name="copy" /></:icon>Duplicar</.dropdown_item>
<.dropdown_item style="--dl:2s"><:icon><.icon name="link" /></:icon>Compartilhar</.dropdown_item>
<.dropdown_item style="--dl:3s"><:icon><.icon name="folder" /></:icon>Arquivar</.dropdown_item>
<.dropdown_separator />
<.dropdown_item danger><:icon><.icon name="trash" /></:icon>Excluir</.dropdown_item>
    </.dropdown>
  </div>
</div>
