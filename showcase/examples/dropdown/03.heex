<div class="flex flex-wrap items-center gap-2.5">
  <.dropdown id="dd3-k1" toggle_icon="dots" toggle_label="Mais" hover><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-k2" toggle_icon="dots-vertical" toggle_label="Mais"><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-k3" label="rounded"><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-k4" label="pill" shape="pill"><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-k5"><:toggle :let={trig}><.icon_button icon="settings" label="Configurações" color="neutral" variant="outline" size="md" shape="square" {trig} /></:toggle><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-s1" color="mono" toggle_label="Mais"><:action>Emitir NF-e</:action><.dropdown_item>Editar</.dropdown_item></.dropdown>
  <.dropdown id="dd3-s2" color="primary" toggle_label="Mais"><:action>Salvar</:action><.dropdown_item>Editar</.dropdown_item></.dropdown>
</div>
