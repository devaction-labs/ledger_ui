<div class={LedgerUI.Components.Dropdown.pop_classes(min: "w-[280px]")}>
  <.dropdown_item><:icon><.icon name="external" /></:icon>Abrir pedido</.dropdown_item>
  <.dropdown_item color="primary"><:icon><.icon name="file" /></:icon>Emitir NF-e</.dropdown_item>
  <.dropdown_separator />
  <.dropdown_item variant="media" description="Financeiro"><:icon><.avatar initials="AN" size="30" color="t1" /></:icon>Ana Nogueira</.dropdown_item>
  <.dropdown_item variant="media" description="Dev"><:icon><.avatar initials="CA" size="30" color="t3" /></:icon>Carlos André</.dropdown_item>
  <.dropdown_separator />
  <.dropdown_item color="error"><:icon><.icon name="x-circle" /></:icon>Cancelar pedido</.dropdown_item>
</div>
