<div class="grid grid-cols-3 gap-3.5">
  <div class="flex flex-col items-start gap-1.5">
    <div class={LedgerUI.Components.Dropdown.pop_classes()}>
      <.dropdown_item><:icon><.icon name="edit" /></:icon>Editar</.dropdown_item>
      <.dropdown_item><:icon><.icon name="copy" /></:icon>Duplicar</.dropdown_item>
    </div>
    <span class="font-mono text-[11px] text-muted">variant=default</span>
  </div>
</div>
