<div class="lu-grid" style="--cols:3;gap:16px">
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">default</span>
    <div class="lu-panel"><.empty_state variant="card" icon="inbox" title="Nenhum pedido ainda" tone="default">Os pedidos do balcão e do site aparecem aqui.<:action><button class="lu-b c-mono v-solid s-sm sh-rounded" type="button"><.icon name="plus" />Novo pedido</button></:action></.empty_state></div>
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">gradient</span>
    <div class="lu-panel"><.empty_state variant="card" icon="inbox" title="Nenhum pedido ainda" tone="gradient">Os pedidos do balcão e do site aparecem aqui.<:action><button class="lu-b c-mono v-solid s-sm sh-rounded" type="button"><.icon name="plus" />Novo pedido</button></:action></.empty_state></div>
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">positive</span>
    <div class="lu-panel"><.empty_state variant="card" icon="inbox" title="Nenhum pedido ainda" tone="positive">Os pedidos do balcão e do site aparecem aqui.<:action><button class="lu-b c-mono v-solid s-sm sh-rounded" type="button"><.icon name="plus" />Novo pedido</button></:action></.empty_state></div>
  </div>
</div>
