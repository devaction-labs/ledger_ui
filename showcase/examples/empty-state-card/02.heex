<div class="grid grid-cols-3 gap-4">
  <div :for={t <- ~w(default gradient positive)} class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">{t}</span>
    <div class="rounded-lg border border-line bg-panel">
      <.empty_state variant="card" icon="inbox" title="Nenhum pedido ainda" tone={t}>Os pedidos do balcão e do site aparecem aqui.<:action><.button icon="plus" color="mono" variant="solid" size="sm" shape="rounded">Novo pedido</.button></:action></.empty_state>
    </div>
  </div>
</div>
