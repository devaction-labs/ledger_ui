<div class="lu-grid" style="--cols:2;gap:16px">
  <section class="lu-card"><header class="lu-card-h"><h3 class="lu-card-t" style="margin:0">Cohort retention</h3></header>
    <div class="lu-card-b" style="">
      <.empty_state icon="table" title="Nenhuma coorte ainda">Conecte o Stripe para ver a retenção mês a mês dos seus clientes.<:action><button class="lu-btn primary sm" type="button"><.icon name="link" />Conectar Stripe</button></:action></.empty_state>
    </div></section>
  <section class="lu-card"><header class="lu-card-h"><h3 class="lu-card-t" style="margin:0">Resultados</h3></header>
    <div class="lu-card-b" style="">
      <.empty_state icon="search" title="Nada encontrado para “orbt”">Verifique a grafia ou limpe os filtros.<:action><button class="lu-btn sm" type="button">Limpar filtros</button></:action></.empty_state>
    </div></section>
</div>
