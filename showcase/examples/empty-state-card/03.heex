<div class="grid grid-cols-4 gap-3.5">
  <div :for={c <- ~w(neutral success error)} class="flex flex-col items-start gap-1.5"><.avatar icon="inbox" color={c} variant="soft" shape="rounded" size="44" /><span class="font-mono text-[11px] text-muted">color={c}</span></div>
  <div class="flex flex-col items-start gap-1.5"><.empty_state variant="card" level={4} title="Título nível 4" class="!p-0 [&_b]:text-[16px]" /><span class="font-mono text-[11px] text-muted">level=4</span></div>
</div>
