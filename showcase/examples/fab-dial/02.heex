<div class="grid grid-cols-2 gap-4"><div class="relative h-[300px] overflow-hidden rounded-[16px] border border-line bg-tray"><.fab_dial id="dial-2-1" label="Ações rápidas" fixed={false} open><:action label="Novo contato"><.icon name="user-plus" /></:action><:action label="Enviar arquivo"><.icon name="upload" /></:action><:action label="Nova proposta"><.icon name="file" /></:action></.fab_dial></div><div class="relative h-[300px] overflow-hidden rounded-[16px] border border-line bg-tray"><.fab_dial id="dial-2-2" label="Ações rápidas" fixed={false} variant="pill" open><:action label="Novo contato"><.icon name="user-plus" /></:action><:action label="Enviar arquivo"><.icon name="upload" /></:action><:action label="Nova proposta"><.icon name="file" /></:action></.fab_dial></div></div>
