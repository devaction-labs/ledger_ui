<div class="grid grid-cols-3 gap-4"><div class="relative h-[170px] overflow-hidden rounded-[16px] border border-line bg-tray"><.fab id="fab-1" label="Pergunte ao assistente" variant="pill" fixed={false} loop><:icon><.icon name="sparkles" size="md" /></:icon></.fab></div><div class="relative h-[170px] overflow-hidden rounded-[16px] border border-line bg-tray"><.fab id="fab-2" label="Nova fatura" variant="pill" fixed={false} color="primary" retract="auto" loop><:icon><.icon name="plus" size="md" /></:icon></.fab></div><div class="relative h-[170px] overflow-hidden rounded-[16px] border border-line bg-tray"><.fab id="fab-3" label="Chat com a equipe" variant="pill" fixed={false} color="light" loop badge={3}><:icon><.icon name="chat" size="md" /></:icon></.fab></div></div>
