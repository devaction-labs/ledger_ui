<div class="lu-grid" style="--cols:3;gap:16px"><div class="lu-fabdemo" style="height:170px"><.fab id="fab-1" label="Pergunte ao assistente" variant="pill" fixed={false} class="m-loop"><:icon><.icon name="sparkles" size="md" /></:icon></.fab><span aria-hidden="true" class="lu-cursor m-fab"><svg viewbox="0 0 24 24"><path d="M5 3l14 7-6 2-2 6z" fill="#fff" stroke="#141514" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></div><div class="lu-fabdemo" style="height:170px"><.fab id="fab-2" label="Nova fatura" variant="pill" fixed={false} color="primary" retract="auto" class="m-loop"><:icon><.icon name="plus" size="md" /></:icon></.fab><span aria-hidden="true" class="lu-cursor m-fab"><svg viewbox="0 0 24 24"><path d="M5 3l14 7-6 2-2 6z" fill="#fff" stroke="#141514" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></div><div class="lu-fabdemo" style="height:170px"><.fab id="fab-3" label="Chat com a equipe" variant="pill" fixed={false} color="light" class="m-loop" badge={3}><:icon><.icon name="chat" size="md" /></:icon></.fab><span aria-hidden="true" class="lu-cursor m-fab"><svg viewbox="0 0 24 24"><path d="M5 3l14 7-6 2-2 6z" fill="#fff" stroke="#141514" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></div></div>
