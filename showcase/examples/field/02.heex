<div class="lu-grid" style="--cols:2;gap:16px">
  <.field label="Nome" help="Como no documento">
    <span class="lu-input"><input placeholder="" type="text" value="Ana Nogueira" /></span>
  </.field>
  <.field as="div" layout="inline" label="Cidade">
    <span class="lu-input"><input placeholder="" type="text" value="Feira de Santana" /></span>
  </.field>
</div>
