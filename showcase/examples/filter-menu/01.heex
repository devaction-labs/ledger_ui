<%!-- raw on purpose: animation stage (`m-click` fake cursor over an open menu) --%>
<span class="lu-anc m-click"><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button><span class="fl p-bottom-start"><div class="lu-pop pad" style="width:240px;display:flex;flex-direction:column;gap:10px"><b class="lu-small">Status</b><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Pago</span></label><label class="lu-check"><input type="checkbox"/><span class="t">Aberto</span></label><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Atrasado</span></label><div class="lu-row" style="justify-content:flex-end"><button class="lu-b c-primary v-solid s-xs sh-rounded" type="button">Aplicar</button></div></div></span><span aria-hidden="true" class="lu-cur2"><svg height="16" viewbox="0 0 24 24" width="16"><path d="M5 3l14 7-6 2-2 6z" fill="#fff" stroke="#141514" stroke-linejoin="round" stroke-width="1.5"></path></svg></span></span><div style="height:200px"></div>
