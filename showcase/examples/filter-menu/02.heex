<%!-- facsimile of the vitrine markup: see the component for the interactive version --%>
<div class="lu-col" style="gap:12px"><div style="display:grid;grid-template-columns:80px repeat(6, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">solid</span><span class="lu-xs lu-muted mono" style="text-align:center">glow</span><span class="lu-xs lu-muted mono" style="text-align:center">outline</span><span class="lu-xs lu-muted mono" style="text-align:center">soft</span><span class="lu-xs lu-muted mono" style="text-align:center">bordered</span><span class="lu-xs lu-muted mono" style="text-align:center">flat</span><span class="lu-xs lu-muted mono">neutral</span><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-solid s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-glow s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-soft s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-bordered s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-neutral v-flat s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><span class="lu-xs lu-muted mono">primary</span><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-solid s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-glow s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-soft s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-bordered s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-primary v-flat s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><span class="lu-xs lu-muted mono">secondary</span><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-solid s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-glow s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-soft s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-bordered s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-secondary v-flat s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><span class="lu-xs lu-muted mono">success</span><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-solid s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-glow s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-soft s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-bordered s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-success v-flat s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><span class="lu-xs lu-muted mono">error</span><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-solid s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-glow s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-soft s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-bordered s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div><div style="display:flex;justify-content:center;min-width:0"><button class="lu-b c-error v-flat s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div></div><div class="lu-row"><button class="lu-b c-neutral v-outline s-xs sh-rounded" type="button"><.icon name="filter" />Filtrar</button><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button"><.icon name="filter" />Filtrar</button><button class="lu-b c-neutral v-outline s-md sh-rounded" type="button"><.icon name="filter" />Filtrar</button><button class="lu-b c-neutral v-outline s-lg sh-rounded" type="button"><.icon name="filter" />Filtrar</button><button class="lu-b c-neutral v-outline s-xl sh-rounded" type="button"><.icon name="filter" />Filtrar</button></div></div>
