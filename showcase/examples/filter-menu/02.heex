<div class="flex flex-col gap-3">
  <div class="grid grid-cols-[80px_repeat(6,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5">
    <span></span>
    <span :for={v <- ~w(solid glow outline soft bordered flat)} class="text-center font-mono text-xs text-muted">{v}</span>
    <%= for color <- ~w(neutral primary secondary success error) do %>
      <span class="font-mono text-xs text-muted">{color}</span>
      <div :for={v <- ~w(solid glow outline soft bordered flat)} class="flex min-w-0 justify-center">
        <.filter_menu id={"fm02-#{color}-#{v}"} label="Filtrar" icon="filter" color={color} variant={v} size="sm" groups={[]} />
      </div>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <.filter_menu :for={size <- ~w(xs sm md lg xl)} id={"fm02-size-#{size}"} label="Filtrar" icon="filter" size={size} groups={[]} />
  </div>
</div>
