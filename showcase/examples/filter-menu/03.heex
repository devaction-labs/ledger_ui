<%!-- facsimile of the vitrine markup: see the component for the interactive version --%>
<div class="lu-row top" style="gap:16px"><button class="lu-btn" type="button"><.icon name="filter" />Filter<span class="count">2</span></button><div class="lu-pop pad" style="width:300px;display:flex;flex-direction:column;gap:12px"><div class="lu-menu-label" style="padding:0">Plano</div><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Pro</span></label><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Scale</span></label><label class="lu-check"><input type="checkbox"/><span class="t">Starter</span></label><div class="lu-menu-label" style="padding:0">Status</div><label class="lu-check"><input type="checkbox"/><span class="t">Em risco</span></label><label class="lu-check"><input type="checkbox"/><span class="t">Churned</span></label><div class="lu-row" style="justify-content:space-between;border-top:1px solid var(--line);padding-top:12px;margin:0 -14px -2px;padding-left:14px;padding-right:14px"><button class="lu-btn ghost sm" type="button">Limpar</button><button class="lu-btn primary sm" type="button">Aplicar</button></div></div></div>
