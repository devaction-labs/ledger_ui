<.flow
  id="flow-demo"
  class="h-[460px]"
  node_width={220}
  aria-label="Automação de cobrança"
  edges={[%{from: "t", to: "c"}, %{from: "t", to: "m"}, %{from: "c", to: "a", status: "done"}]}
  steps={[
    %{key: "acao", label: "Ação", title: "Atualizar pedido", sub: "Ação · ERP", icon: "zap", tone: "acc"},
    %{key: "cond", label: "Condição", title: "Valor acima de R$ 1.000?", sub: "Condição", icon: "filter", tone: "warn", branches: [%{label: "Sim", tone: "pos"}, %{label: "Não", tone: "neg"}]},
    %{key: "wait", label: "Esperar", title: "Esperar 1 dia", sub: "Espera", icon: "clock", tone: "info"},
    %{key: "zap", label: "Notificar", title: "Avisar no WhatsApp", sub: "Notificação", icon: "bell", tone: "lime"},
    %{key: "mail", label: "E-mail", title: "Enviar e-mail", sub: "Ação · modelo", icon: "mail", tone: "info"},
    %{key: "ai", label: "IA", title: "Resumir com IA", sub: "IA", icon: "ai", tone: "lime"}
  ]}
>
  <:node id="t" kind="Gatilho" kind_icon="zap" icon="zap" title="Pagamento falhou"><span class="text-xs text-muted">Stripe</span></:node>
  <:node id="c" kind="IA" kind_icon="ai" icon="ai" title="Classificar risco" selected><span class="text-xs text-muted">3 regras</span></:node>
  <:node id="m" kind="Ação" kind_icon="mail" icon="mail" title="E-mail ao cliente"><span class="text-xs text-muted">modelo “dunning”</span></:node>
  <:node id="a" kind="Aprovação" kind_icon="user" icon="user" title="Aprovação do CS"><span class="text-xs text-muted">Aguardando</span></:node>
</.flow>
