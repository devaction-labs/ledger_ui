<div class="flex flex-col gap-4.5">
  <.form_section title="Dados da empresa" description="Aparecem nas notas fiscais." divider={false}>
    <.input label="Razão social" placeholder="Mercadinho Bom Preço" />
    <.input label="CNPJ" placeholder="00.000.000/0000-00" />
  </.form_section>
  <.form_section
    title="Dados da empresa"
    description="Aparecem nas notas fiscais."
    layout="aside"
  >
    <.input label="Razão social" placeholder="Mercadinho Bom Preço" />
    <.input label="CNPJ" placeholder="00.000.000/0000-00" />
  </.form_section>
  <.form_section
    title="Dados da empresa"
    description="Aparecem nas notas fiscais."
    columns={3}
    divider={false}
  >
    <.input label="Razão social" placeholder="Mercadinho Bom Preço" />
    <.input label="CNPJ" placeholder="00.000.000/0000-00" />
    <.input label="Inscrição estadual" placeholder="Isento" />
  </.form_section>
</div>
