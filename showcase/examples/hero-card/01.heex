<.hero_card
  id="hero-loop"
  animated
  eyebrow="Bom dia, Alex"
  title="Novembro está 12% acima de outubro"
  description="Faltam 10 dias para fechar o mês. Três pedidos esperam aprovação."
  meta="Meta de novembro"
  meta_value="R$ 184 mil de R$ 250 mil"
  meter={74}
>
  <:actions>
    <.button color="mono" size="lg"><.icon name="plus" />Novo pedido</.button>
    <.button variant="outline" size="lg"><.icon name="arrow-up-right" />Ver relatório</.button>
  </:actions>
</.hero_card>
