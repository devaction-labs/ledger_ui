<div class="lu-col" style="gap:8px">
  <span class="lu-xs lu-muted mono">size="md"</span>
  <.hero_card
    id="hero-md"
    eyebrow="Painel"
    title="Pedidos de hoje"
    description="48 pedidos, 6 aguardando separação."
  >
    <:actions>
      <.button color="mono">Abrir pedidos</.button>
    </:actions>
  </.hero_card>
  <span class="lu-xs lu-muted mono">size="lg"</span>
  <.hero_card
    id="hero-lg"
    size="lg"
    eyebrow="Bem-vindo de volta"
    title="Metas do trimestre"
    description="Alinhe a equipe e acompanhe o que importa em um só lugar."
  >
    <:actions>
      <.button color="mono" size="lg"><.icon name="plus" />Novo pedido</.button>
      <.button variant="outline" size="lg"><.icon name="arrow-up-right" />Ver relatório</.button>
    </:actions>
  </.hero_card>
</div>
