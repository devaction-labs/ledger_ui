<div class="flex flex-col gap-2">
  <span class="font-mono text-xs text-muted">variant="soft"</span>
  <.hero_card
    id="hero-soft"
    eyebrow="Financeiro"
    title="R$ 42 mil a receber esta semana"
    description="Doze faturas vencem até sexta."
  >
    <:actions>
      <.button variant="outline">Ver faturas</.button>
    </:actions>
  </.hero_card>
  <span class="font-mono text-xs text-muted">variant="panel"</span>
  <.hero_card
    id="hero-panel"
    variant="panel"
    eyebrow="Financeiro"
    title="R$ 42 mil a receber esta semana"
    description="Doze faturas vencem até sexta."
  >
    <:actions>
      <.button variant="outline">Ver faturas</.button>
    </:actions>
  </.hero_card>
</div>
