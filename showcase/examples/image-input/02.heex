<div class="grid grid-cols-[80px_repeat(4,_minmax(0,1fr))] gap-y-[10px] gap-x-[12px] items-center"><span></span><span class="text-xs text-muted font-mono text-center">vazio</span><span class="text-xs text-muted font-mono text-center">com imagem</span><span class="text-xs text-muted font-mono text-center">hover</span><span class="text-xs text-muted font-mono text-center">enviando</span><span class="text-xs text-muted font-mono">square</span><div class="flex justify-center min-w-0"><.image_input id="ii-square-0" shape="square" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-square-1" shape="square" initials="BP" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-square-2" shape="square" initials="BP" hover /></div><div class="flex justify-center min-w-0"><.image_input id="ii-square-3" shape="square" initials="BP" progress={62} /></div><span class="text-xs text-muted font-mono">circle</span><div class="flex justify-center min-w-0"><.image_input id="ii-circle-0" shape="circle" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-circle-1" shape="circle" initials="BP" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-circle-2" shape="circle" initials="BP" hover /></div><div class="flex justify-center min-w-0"><.image_input id="ii-circle-3" shape="circle" initials="BP" progress={62} /></div><span class="text-xs text-muted font-mono">wide</span><div class="flex justify-center min-w-0"><.image_input id="ii-wide-0" shape="wide" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-wide-1" shape="wide" initials="BP" /></div><div class="flex justify-center min-w-0"><.image_input id="ii-wide-2" shape="wide" initials="BP" hover /></div><div class="flex justify-center min-w-0"><.image_input id="ii-wide-3" shape="wide" initials="BP" progress={62} /></div></div>
