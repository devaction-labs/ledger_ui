<div class="lu-col" style="gap:10px">
  <div class="lu-row">
    <.input_group size="sm">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
    <.input_group>
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
    <.input_group size="lg">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
  </div>
  <div class="lu-row">
    <.input_group shape="pill">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
    <.input_group variant="filled">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
    <.input_group state="success">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
    <.input_group state="error">
      <.input_group_addon>R$</.input_group_addon>
      <span class="v">1.284,90</span>
      <.input_group_addon>,00</.input_group_addon>
    </.input_group>
  </div>
</div>
