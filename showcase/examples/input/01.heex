  <.input label="Razão social" icon="user" value="Mercadinho Bom Preço Ltda" class="animate-[lu-focusloop_6s_ease-in-out_infinite] [&_input]:animate-[lu-typeloop_6s_steps(25)_infinite]" />
  <.input label="CNPJ" icon="building" value="12.345.678/0001-0" errors={["CNPJ incompleto"]} class="animate-[lu-shake_6s_ease-in-out_infinite]" wrapper_class="[&_[data-part=error]]:animate-[lu-helperr_6s_ease-in-out_infinite]" />
</div>
