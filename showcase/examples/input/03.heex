<div class="lu-grid" style="--cols:3;gap:16px">
  <.input label='shape="rounded" (padrão)' icon="search" placeholder="Buscar pedidos" />
  <.input label='shape="pill"' shape="pill" icon="search" placeholder="Buscar pedidos" />
  <.input label='align="right" com prefixo' align="right" value="1.284,90"><:prefix text>R$</:prefix></.input>
  <.input label="sufixo" align="right" value="12,5"><:suffix text>%</:suffix></.input>
  <.input label="ícone à direita + atalho" icon="search" placeholder="Buscar…"><:suffix interactive><span class="kbd">⌘K</span></:suffix></.input>
  <.input label="url com prefixo" value="signetum"><:prefix text>https://</:prefix><:suffix text>.com.br</:suffix></.input>
</div>
