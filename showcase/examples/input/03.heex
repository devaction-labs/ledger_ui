<div class="grid grid-cols-3 gap-4">
  <.input label='shape="rounded" (padrão)' icon="search" placeholder="Buscar pedidos" />
  <.input label='shape="pill"' shape="pill" icon="search" placeholder="Buscar pedidos" />
  <.input label='align="right" com prefixo' align="right" value="1.284,90" prefix="R$" />
  <.input label="sufixo" align="right" value="12,5" suffix="%" />
  <.input label="ícone à direita + atalho" icon="search" placeholder="Buscar…"><:trailing><span class="kbd">⌘K</span></:trailing></.input>
  <.input label="url com prefixo" value="signetum" prefix="https://" suffix=".com.br" />
</div>
