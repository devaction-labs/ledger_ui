<div class="lu-grid" style="--cols:2;gap:16px"><div class="lu-field"><span class="lu-label">E-mail</span><span class="lu-input ok"><.icon name="mail" /><span class="val">ana@bompreco.com.br</span></span><span class="lu-help ok"><.icon name="check-circle" size="sm" />E-mail verificado</span></div><div class="lu-field"><span class="lu-label">CNPJ <span class="req">*</span></span><span class="lu-input err"><span class="val">12.345.678/0001</span></span><span class="lu-help err"><.icon name="warn-circle" size="sm" />CNPJ incompleto: faltam 3 dígitos</span></div><div class="lu-field"><span class="lu-label">Apelido<span class="hint">opcional</span></span><span class="lu-input"><span class="val ph">Como aparece nas notas</span></span><span class="lu-help">Aparece no cabeçalho do DANFE</span></div><div class="lu-field"><span class="lu-label">Código interno</span><span class="lu-input disabled"><span class="val">PED-2491</span></span><span class="lu-help">Gerado automaticamente</span></div></div>
