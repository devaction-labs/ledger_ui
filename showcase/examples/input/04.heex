<div class="grid grid-cols-2 gap-4">
  <.input label="E-mail" icon="mail" type="email" value="ana@bompreco.com.br" state="success" help="E-mail verificado" />
  <.input label="CNPJ" required value="12.345.678/0001" state="error" help="CNPJ incompleto: faltam 3 dígitos" />
  <.input label="Apelido" label_hint="opcional" placeholder="Como aparece nas notas" help="Aparece no cabeçalho do DANFE" />
  <.input label="Código interno" value="PED-2491" disabled help="Gerado automaticamente" />
</div>
