<div class="lu-grid" style="--cols:4;gap:16px">
  <.input label="email" type="email" icon="mail" placeholder="nome@empresa.com" />
  <.input label="search" type="search" icon="search" placeholder="Buscar…" />
  <.input label="tel" type="tel" icon="phone" value="(75) 98123-4567" />
  <.input label="url" type="url" icon="link" placeholder="https://" />
  <.input label="date" type="date" icon="calendar" value="2026-11-19" />
  <.input label="time" type="time" icon="clock" value="14:30" />
  <.input label="number" type="number" value="42" />
  <.input label="color" type="color" value="#1f9282" />
</div>
