<div class="lu-col" style="gap:16px"><div class="lu-grid" style="--cols:3;gap:14px"><div class="lu-cell"><span class="lu-input"><.icon name="lock" /><span class="val">••••••••</span></span><span class="lu-cap">type=password</span></div><div class="lu-cell"><span class="lu-input"><.icon name="calendar" /><span class="val">19/11/2026 14:30</span></span><span class="lu-cap">type=datetime-local</span></div><div class="lu-cell"><span class="lu-input"><.icon name="calendar" /><span class="val">novembro 2026</span></span><span class="lu-cap">type=month</span></div><div class="lu-cell"><span class="lu-input"><.icon name="calendar" /><span class="val">semana 47</span></span><span class="lu-cap">type=week</span></div><div class="lu-cell"><span class="lu-input"><.icon name="attach" /><span class="val ph">Escolher arquivo</span></span><span class="lu-cap">type=file</span></div><div class="lu-cell"><span class="lu-input"><span class="val ph">(não renderiza)</span></span><span class="lu-cap">type=hidden</span></div></div><div class="lu-grid" style="--cols:4;gap:14px"><div class="lu-cell"><span class="lu-input"><span class="val">Texto à esquerda</span></span><span class="lu-cap">align=left</span></div><div class="lu-cell"><span class="lu-input ok"><span class="val">ok</span></span><span class="lu-cap">state=success</span></div><div class="lu-cell"><span class="lu-input err"><span class="val">erro</span></span><span class="lu-cap">state=error</span></div><div class="lu-cell"><div class="lu-field"><span class="lu-label">Rótulo em cima</span><span class="lu-input"><span class="val">valor</span></span></div><span class="lu-cap">layout=stacked</span></div></div><div class="lu-grid" style="--cols:3;gap:14px"><div class="lu-cell"><span class="lu-input"><span class="val">123.456.789-09</span></span><span class="lu-cap">mask=cpf_cnpj</span></div><div class="lu-cell"><span class="lu-input"><span class="val">4111 1111 1111 1111</span></span><span class="lu-cap">mask=credit_card</span></div><div class="lu-cell"><span class="lu-input"><span class="val">1.284.903,50</span></span><span class="lu-cap">mask=numeral</span></div><div class="lu-cell"><span class="lu-input"><span class="val">ABC-1234-XY</span></span><span class="lu-cap">mask=blocks</span></div><div class="lu-cell"><span class="lu-tmini">"123.456.789-09"</span><span class="lu-cap">mask_submit=formatted</span></div><div class="lu-cell"><span class="lu-tmini">"12345678909"</span><span class="lu-cap">mask_submit=raw</span></div></div></div>
