<.kanban id="k2" style="--cols:3" local>
  <.kanban_column id="col-neutral" color="neutral" label="neutral" count={1}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    <.kanban_card id="k2-c1"><div class="lu-row" style="justify-content:space-between"><.badge canvas>Tag</.badge><.icon name="more-h" size="md" class="lu-muted" /></div><b>Pedido</b>
      <div class="lu-row" style="justify-content:space-between"><.avatar initials="AN" size="24" />
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />hoje</span></div></.kanban_card>
    
  </.kanban_column>
  <.kanban_column id="col-info" color="info" label="info" count={1}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    <.kanban_card id="k2-c2"><div class="lu-row" style="justify-content:space-between"><.badge canvas>Tag</.badge><.icon name="more-h" size="md" class="lu-muted" /></div><b>Pedido</b>
      <div class="lu-row" style="justify-content:space-between"><.avatar initials="AN" size="24" />
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />hoje</span></div></.kanban_card>
    
  </.kanban_column>
  <.kanban_column id="col-warning" color="warning" label="warning" count={0}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-primary" color="primary" label="primary" count={0}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-teal" color="accent" label="teal" count={0}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-success" color="success" label="success" count={0}>
    <:actions><.button canvas appearance="ghost" size="sm" icon aria-label="Adicionar"><.icon name="plus" /></.button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
</.kanban>
