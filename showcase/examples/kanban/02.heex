<.kanban id="k2" style="--cols:3">
  <.kanban_column id="col-neutral" color="neutral" label="neutral" count={1}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    <.kanban_card id="k2-c1" style=""><div class="lu-row" style="justify-content:space-between"><span class="lu-badge">Tag</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Pedido</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t1" style="--s:24px">AN</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />hoje</span></div></.kanban_card>
    
  </.kanban_column>
  <.kanban_column id="col-info" color="info" label="info" count={1}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    <.kanban_card id="k2-c2" style=""><div class="lu-row" style="justify-content:space-between"><span class="lu-badge">Tag</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Pedido</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t1" style="--s:24px">AN</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />hoje</span></div></.kanban_card>
    
  </.kanban_column>
  <.kanban_column id="col-warning" color="warning" label="warning" count={0}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-primary" color="primary" label="primary" count={0}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-teal" color="teal" label="teal" count={0}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
  <.kanban_column id="col-success" color="success" label="success" count={0}>
    <:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    
    <:empty>Solte aqui</:empty>
  </.kanban_column>
</.kanban>
