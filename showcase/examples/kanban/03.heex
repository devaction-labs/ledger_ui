<.kanban id="k3" style="--cols:3">
  <.kanban_column id="col-Em risco" label="Em risco" count={2}>
    <:icon><span class="lu-dot" style="color:var(--chart-4)"></span></:icon><:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    <.kanban_card id="k3-c1"><div class="lu-row" style="justify-content:space-between"><span class="lu-badge acc">Pro</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Nordic Pay — falha de pagamento</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t3" style="--s:24px">NP</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />21 nov</span></div></.kanban_card>
<.kanban_card id="k3-c2"><div class="lu-row" style="justify-content:space-between"><span class="lu-badge">Starter</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Atlas Labs — trial expira</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t4" style="--s:24px">AL</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />24 nov</span></div></.kanban_card>
  </.kanban_column>
  <.kanban_column id="col-Em negociação" label="Em negociação" count={1}>
    <:icon><span class="lu-dot" style="color:var(--chart-3)"></span></:icon><:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    <.kanban_card id="k3-c3" class="drag"><div class="lu-row" style="justify-content:space-between"><span class="lu-badge info">Scale</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Lumen GmbH — upgrade 50 assentos</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t2" style="--s:24px">LG</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />28 nov</span></div></.kanban_card>
  </.kanban_column>
  <.kanban_column id="col-Renovado" label="Renovado" count={2}>
    <:icon><span class="lu-dot" style="color:var(--chart-1)"></span></:icon><:actions><button aria-label="Adicionar" class="lu-btn icon ghost sm" type="button"><.icon name="plus" /></button></:actions>
    <.kanban_card id="k3-c4"><div class="lu-row" style="justify-content:space-between"><span class="lu-badge acc">Pro</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Orbit Cloud — anual</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t1" style="--s:24px">OC</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />08 dez</span></div></.kanban_card>
<.kanban_card id="k3-c5"><div class="lu-row" style="justify-content:space-between"><span class="lu-badge info">Scale</span><.icon name="more-h" size="md" class="lu-muted" /></div><b>Vektor — mensal</b>
      <div class="lu-row" style="justify-content:space-between"><span class="lu-av t5" style="--s:24px">VK</span>
        <span class="lu-xs lu-muted lu-row" style="gap:4px"><.icon name="calendar" size="sm" />02 dez</span></div></.kanban_card>
  </.kanban_column>
</.kanban>
