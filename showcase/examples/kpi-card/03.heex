<div class="grid grid-cols-7 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="success">+8,8%</.badge><span class="font-mono text-[11px] text-muted">delta_tone=success</span></div>
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="error">−2,1%</.badge><span class="font-mono text-[11px] text-muted">delta_tone=error</span></div>
  <div :for={c <- ~w(primary secondary success warning error)} class="flex flex-col items-start gap-1.5">
    <.card variant="soft" color={c} gradient={nil} style="min-height:0;width:100%"><span>Faturamento</span><b style="font-size:20px">R$ 184 mil</b></.card>
    <span class="font-mono text-[11px] text-muted">color={c}</span>
  </div>
</div>
