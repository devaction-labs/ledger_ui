<div class="lu-grid" style="--cols:7;gap:14px">
  <div class="lu-cell"><.badge canvas color="success">+8,8%</.badge><span class="lu-cap">delta_tone=success</span></div>
  <div class="lu-cell"><.badge canvas color="error">−2,1%</.badge><span class="lu-cap">delta_tone=error</span></div>
  <div :for={c <- ~w(primary secondary success warning error)} class="lu-cell">
    <.card variant="soft" color={c} gradient={nil} style="min-height:0;width:100%"><span>Faturamento</span><b style="font-size:20px">R$ 184 mil</b></.card>
    <span class="lu-cap">color={c}</span>
  </div>
</div>
