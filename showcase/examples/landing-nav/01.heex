<div class="relative h-[230px]">
  <.landing_nav id="ln-1" variant="float" brand={%{name: "Signetum", icon: "grid"}}>
    <:link label="Produto" caret />
    <:link label="Preços" />
    <:link label="Clientes" />
    <:actions>
      <.landing_login>Entrar</.landing_login>
      <.landing_cta>Começar grátis</.landing_cta>
    </:actions>
  </.landing_nav>
  <.landing_mega class="animate-[lu-flin2_5s_ease-out_infinite]">
    <.landing_feature icon="file" title="Notas fiscais" description="NF-e e NFC-e" />
    <.landing_feature icon="cart" title="PDV" description="Venda no balcão" />
    <.landing_feature icon="wallet" title="Financeiro" description="Contas e Pix" />
    <.landing_feature icon="layers" title="Estoque" description="Inventário" />
  </.landing_mega>
</div>
