  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">mobile</span>
    <div class="relative">
      <.landing_nav id="ln-mobile" variant="mobile" brand={%{name: "Signetum", icon: "grid"}} />
