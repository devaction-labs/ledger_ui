<div class="flex flex-col gap-3">
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">default</span>
    <div class="relative">
      <.landing_nav id="ln-default" variant="default" brand={%{name: "Signetum", icon: "grid"}}>
        <:link label="Produto" caret />
        <:link label="Preços" />
        <:link label="Clientes" />
        <:actions>
          <.landing_login>Entrar</.landing_login>
          <.landing_cta>Começar grátis</.landing_cta>
        </:actions>
      </.landing_nav>
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">float</span>
