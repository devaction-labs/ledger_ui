<div class="lu-col" style="gap:12px">
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">default</span>
    <div style="position:relative;">
      <.landing_nav id="ln-default" variant="default" brand={%{name: "Signetum", icon: "grid"}}>
        <:link label="Produto" caret />
        <:link label="Preços" />
        <:link label="Clientes" />
        <:actions>
          <.landing_login>Entrar</.landing_login>
          <.landing_cta>Começar grátis</.landing_cta>
        </:actions>
      </.landing_nav>
    </div>
  </div>
