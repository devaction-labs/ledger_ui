<div class="lu-row lu-start"><div :for={s <- ~w(squircle reuleaux-triangle diamond hexagon hexagon-2 octagon star star-2 heart)} class="lu-col" style="gap:4px"><.mask shape={s} size="64" style="background:linear-gradient(135deg,var(--lu-accent-300),var(--lu-accent-700))">BP</.mask><span class="lu-xs lu-muted mono">{s}</span></div></div>
