<div class="flex flex-wrap items-start gap-2.5"><div :for={s <- ~w(squircle reuleaux-triangle diamond hexagon hexagon-2 octagon star star-2 heart)} class="flex flex-col gap-1"><.mask shape={s} size="64" style="background:linear-gradient(135deg,var(--lu-accent-300),var(--lu-accent-700))">BP</.mask><span class="font-mono text-xs text-muted">{s}</span></div></div>
