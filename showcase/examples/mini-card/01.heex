<div class="lu-grid" style="--cols:3;gap:12px"><.mini_card :for={{ic, t, l, d, dl} <- [{"file", "accent", "Emitir NF-e", "Nota fiscal", "0.0s"}, {"wallet", "success", "Receber", "Pix e boleto", "0.5s"}, {"cart", "info", "Novo pedido", "Balcão", "1.0s"}]} surface="card" icon={ic} tone={t} label={l} class="animate-[mo-lift_4s_ease-in-out_infinite]" style={"animation-delay:#{dl}"}><span>{d}</span></.mini_card></div>
