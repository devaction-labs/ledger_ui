<div class="flex flex-col gap-2">
  <div :for={{s, w, px} <- [{"xs", "w-40", "320px"}, {"sm", "w-[220px]", "440px"}, {"md", "w-[280px]", "560px"}, {"lg", "w-[360px]", "720px (padrão)"}, {"xl", "w-[460px]", "960px"}, {"full", "w-[620px]", "tela inteira"}]} class="flex flex-wrap items-center gap-2.5">
    <span class="w-10 font-mono text-xs text-muted">{s}</span>
    <div class={["flex h-[22px] max-w-full items-center rounded-md bg-sunken px-2 font-mono text-xs text-muted shadow-[inset_0_0_0_1px_var(--lu-line)]", w]}>{px}</div>
  </div>
</div>
