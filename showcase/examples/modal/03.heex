<div class="grid grid-cols-3 gap-3">
  <div :for={{pl, label} <- [{"top", "placement=top"}, {"center", "center"}, {"bottom", "bottom"}]} class="relative overflow-hidden rounded-[14px] bg-page shadow-[inset_0_0_0_1px_var(--lu-line)] h-[230px] [&>[data-part=modal-overlay]]:absolute [&>[data-part=modal-overlay]]:inset-0 [&>[data-part=modal-overlay]]:rounded-none [&>[data-part=modal-overlay]]:p-3.5">
    <div class="absolute inset-0 flex flex-col gap-2.5 px-[18px] py-4"><.skeleton animation={nil} class="h-[9px] w-[38%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[70%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[55%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[62%] rounded-[5px]" /></div>
    <.modal inline id={"mo-place-#{pl}"} placement={pl} size="xs" title="Exportar relatório" close_button={false}>
      <.skeleton animation={nil} class="h-[7px] w-[90%] rounded-sm" /><.skeleton animation={nil} class="h-[7px] w-[70%] rounded-sm" />
      <:footer><.button color="neutral" variant="soft" size="xs">Cancelar</.button><.button color="neutral" size="xs">Salvar</.button></:footer>
    </.modal>
    <span class="absolute bottom-2 left-2.5 z-50 font-mono text-[11px] text-muted">{label}</span>
  </div>
  <div class="relative overflow-hidden rounded-[14px] bg-page shadow-[inset_0_0_0_1px_var(--lu-line)] h-[230px] [&>[data-part=modal-overlay]]:absolute [&>[data-part=modal-overlay]]:inset-0 [&>[data-part=modal-overlay]]:rounded-none [&>[data-part=modal-overlay]]:p-3.5">
    <div class="absolute inset-0 flex flex-col gap-2.5 px-[18px] py-4"><.skeleton animation={nil} class="h-[9px] w-[38%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[70%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[55%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[62%] rounded-[5px]" /></div>
    <.modal inline id="mo-chip" size="xs" close_variant="chip" class="p-0">
      <div class="h-[110px] bg-[linear-gradient(135deg,var(--lu-accent-300),var(--lu-accent-700))]"></div>
      <div class="p-2.5"><b>Capa da loja</b></div>
    </.modal>
    <span class="absolute bottom-2 left-2.5 z-50 font-mono text-[11px] text-muted">close_variant=chip</span>
  </div>
  <div class="relative overflow-hidden rounded-[14px] bg-page shadow-[inset_0_0_0_1px_var(--lu-line)] h-[230px] [&>[data-part=modal-overlay]]:absolute [&>[data-part=modal-overlay]]:inset-0 [&>[data-part=modal-overlay]]:rounded-none [&>[data-part=modal-overlay]]:p-3.5">
    <div class="absolute inset-0 flex flex-col gap-2.5 px-[18px] py-4"><.skeleton animation={nil} class="h-[9px] w-[38%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[70%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[55%] rounded-[5px]" /><.skeleton animation={nil} class="h-[9px] w-[62%] rounded-[5px]" /></div>
    <.modal inline id="mo-alert" size="xs" role="alertdialog" title="Excluir pedido #2488?" close_button={false}>
      <.skeleton animation={nil} class="h-[7px] w-[85%] rounded-sm" />
      <:footer><.button color="neutral" variant="soft" size="xs">Cancelar</.button><.button color="error" size="xs">Excluir</.button></:footer>
    </.modal>
    <span class="absolute bottom-2 left-2.5 z-50 font-mono text-[11px] text-muted">role=alertdialog</span>
  </div>
</div>
