<div class="lu-grid" style="--cols:2;gap:16px">
<.modal id="modal-export" inline size="sm" title="Exportar relatório" description="October 2026 · Orbit Cloud" icon="download" close_label="Fechar" style="min-height:360px">
<label class="lu-field"><span class="lu-label">Formato</span><div class="lu-seg block" data-lu-single="" role="tablist"><button aria-selected="true" class="on" data-v="pdf" role="tab" type="button">PDF</button><button aria-selected="false" class="" data-v="csv" role="tab" type="button">CSV</button><button aria-selected="false" class="" data-v="xlsx" role="tab" type="button">XLSX</button></div></label><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Incluir comparação com 2025</span></label><label class="lu-check"><input checked="" type="checkbox"/><span class="t">Incluir insights de IA</span></label>
<:footer><button class="lu-btn ghost" type="button">Cancelar</button><button class="lu-btn primary" type="button"><.icon name="download" />Exportar</button></:footer>
</.modal>
<.modal id="modal-delete" inline size="sm" card_style="width:380px" title="Excluir visão?" description="“Pro churn watch” será removida para todos do workspace." icon="trash" icon_tone="error" close_button={false} style="min-height:360px"><:footer style="margin-top:14px"><button class="lu-btn ghost" type="button">Cancelar</button><button class="lu-btn danger" type="button">Excluir</button></:footer></.modal>
</div>
