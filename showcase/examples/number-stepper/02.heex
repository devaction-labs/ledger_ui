<div style="display:grid;grid-template-columns:90px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">inset</span><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-inset-sm" steppers stepper_style="inset" size="sm" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-inset-md" steppers stepper_style="inset" size="md" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-inset-lg" steppers stepper_style="inset" size="lg" value={12} /></div><span class="lu-xs lu-muted mono">round</span><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-round-sm" steppers stepper_style="round" size="sm" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-round-md" steppers stepper_style="round" size="md" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-round-lg" steppers stepper_style="round" size="lg" value={12} /></div><span class="lu-xs lu-muted mono">joined</span><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-joined-sm" steppers stepper_style="joined" size="sm" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-joined-md" steppers stepper_style="joined" size="md" value={12} /></div><div style="display:flex;justify-content:center;min-width:0"><.number_input id="ns-joined-lg" steppers stepper_style="joined" size="lg" value={12} /></div></div>
