<div class="grid grid-cols-[90px_repeat(3,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span class="text-center font-mono text-xs text-muted">sm</span><span class="text-center font-mono text-xs text-muted">md</span><span class="text-center font-mono text-xs text-muted">lg</span><span class="font-mono text-xs text-muted">inset</span><div class="flex min-w-0 justify-center"><.number_input id="ns-inset-sm" steppers stepper_style="inset" size="sm" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-inset-md" steppers stepper_style="inset" size="md" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-inset-lg" steppers stepper_style="inset" size="lg" value={12} /></div><span class="font-mono text-xs text-muted">round</span><div class="flex min-w-0 justify-center"><.number_input id="ns-round-sm" steppers stepper_style="round" size="sm" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-round-md" steppers stepper_style="round" size="md" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-round-lg" steppers stepper_style="round" size="lg" value={12} /></div><span class="font-mono text-xs text-muted">joined</span><div class="flex min-w-0 justify-center"><.number_input id="ns-joined-sm" steppers stepper_style="joined" size="sm" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-joined-md" steppers stepper_style="joined" size="md" value={12} /></div><div class="flex min-w-0 justify-center"><.number_input id="ns-joined-lg" steppers stepper_style="joined" size="lg" value={12} /></div></div>
