<div class="overflow-hidden rounded-lg border border-line bg-panel">
  <.page_header>
    <:heading><span>Pedidos</span></:heading>
    <:subtitle><b class="font-mono text-ink [--to:1096] animate-[mo-count_5s_cubic-bezier(.2,.8,.2,1)_infinite] after:[counter-reset:n_var(--lu-n)] after:content-[var(--pre,'')_counter(n)_var(--suf,'')]"></b> pedidos em novembro.</:subtitle>
    <:actions>
      <.button canvas><.icon name="download" />Exportar</.button>
      <.button color="mono"><.icon name="plus" />Novo pedido</.button>
    </:actions>
    <:tabs>
      <.tabs id="ph-tabs" variant="line" selected="todos">
        <:tab name="todos">Todos</:tab>
        <:tab name="abertos">Abertos</:tab>
        <:tab name="pagos">Pagos</:tab>
      </.tabs>
    </:tabs>
  </.page_header>
</div>
