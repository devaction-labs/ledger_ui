<div class="lu-panel" style="overflow:hidden">
  <.page_header>
    <:heading><span>Pedidos</span></:heading>
    <:subtitle><b class="mono mo-count" style="--to:1096;color:var(--ink)"></b> pedidos em novembro.</:subtitle>
    <:actions>
      <button class="lu-btn" type="button"><.icon name="download" />Exportar</button>
      <.button color="mono"><.icon name="plus" />Novo pedido</.button>
    </:actions>
    <:tabs>
      <div class="lu-tb line" role="tablist">
        <button class="on" type="button">Todos</button>
        <button type="button">Abertos</button>
        <button type="button">Pagos</button>
      </div>
    </:tabs>
  </.page_header>
</div>
