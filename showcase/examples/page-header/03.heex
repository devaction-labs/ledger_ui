<div class="lu-panel" style="overflow:hidden"><.page_header title="All cases"><:subtitle><b class="mono" style="color:var(--ink)">60</b> cases. Use the side panel to filter by status or department.</:subtitle><:actions><button class="lu-btn" type="button"><.icon name="download" />Export</button><button class="lu-btn primary" type="button"><.icon name="plus" />New case</button></:actions><:tabs><div class="lu-tabs" data-lu-single="" style="border-bottom:0"><button class="lu-tab on" type="button">Lista</button><button class="lu-tab" type="button">Quadro</button><button class="lu-tab" type="button">Agenda</button></div></:tabs></.page_header></div>
