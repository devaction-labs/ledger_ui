<div class="grid grid-cols-[90px_repeat(3,_minmax(0,1fr))] gap-y-[10px] gap-x-[12px] items-center"><span></span><span class="text-xs text-muted font-mono text-center">sm</span><span class="text-xs text-muted font-mono text-center">md</span><span class="text-xs text-muted font-mono text-center">lg</span><span class="text-xs text-muted font-mono">canvas</span><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="canvas" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="canvas" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="canvas" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><span class="text-xs text-muted font-mono">rounded</span><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="rounded" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="rounded" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="rounded" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><span class="text-xs text-muted font-mono">pill</span><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="pill" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="pill" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div class="flex justify-center min-w-0"><.pagination page={2} total_pages={44} shape="pill" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div></div>
