<div style="display:grid;grid-template-columns:90px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">canvas</span><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="canvas" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="canvas" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="canvas" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><span class="lu-xs lu-muted mono">rounded</span><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="rounded" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="rounded" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="rounded" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><span class="lu-xs lu-muted mono">pill</span><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="pill" size="sm" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="pill" size="md" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div><div style="display:flex;justify-content:center;min-width:0"><.pagination page={2} total_pages={44} shape="pill" size="lg" page_attrs={fn p -> if p == :ellipsis or p > 4, do: %{style: "--dl:0s"}, else: %{style: "--dl:#{:erlang.float_to_binary((p - 1) * 1.5, decimals: 1)}s"} end} /></div></div>
