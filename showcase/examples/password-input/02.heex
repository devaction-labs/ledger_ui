<div style="display:grid;grid-template-columns:90px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">outlined</span><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input sm"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input lg"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div><span class="lu-xs lu-muted mono">filled</span><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input filled sm"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input filled"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div><div style="display:flex;justify-content:center;min-width:0"><span class="lu-input filled lg"><.icon name="lock" /><span class="val"><span class="lu-dots">••••••••••••</span></span><button aria-label="Mostrar a senha" class="eye" type="button"><.icon name="eye" /></button></span></div></div>
