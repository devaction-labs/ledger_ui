<div class="grid grid-cols-3 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.password_input id="pw05-1" variant="plain" value="password1234" aria-label="Senha" /><span class="font-mono text-[11px] text-muted">variant=plain</span></div>
  <div class="flex flex-col items-start gap-1.5"><.password_input id="pw05-2" state="success" value="password1234" aria-label="Senha" /><span class="font-mono text-[11px] text-muted">state=success</span></div>
  <div class="flex flex-col items-start gap-1.5"><.password_input id="pw05-3" state="error" value="password1234" aria-label="Senha" /><span class="font-mono text-[11px] text-muted">state=error</span></div>
</div>
