<div class="flex flex-col gap-2.5">
  <div class="flex flex-wrap items-center gap-2.5">
    <.phone_input id="ph02-sm" size="sm" flags class="w-[280px]" value="+5575981234567" aria-label="Telefone" />
    <.phone_input id="ph02-md" flags class="w-[280px]" value="+5575981234567" aria-label="Telefone" />
    <.phone_input id="ph02-lg" size="lg" flags class="w-[280px]" value="+5575981234567" aria-label="Telefone" />
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <.phone_input id="ph02-filled" variant="filled" flags class="w-[280px]" value="+5575981234567" aria-label="Telefone" />
    <.phone_input id="ph02-pill" shape="pill" flags class="w-[280px]" value="+5575981234567" aria-label="Telefone" />
  </div>
</div>
