<%!-- raw on purpose: the size matrix of the canvas mock; <.pillbox> always draws remove buttons, a chevron and its hidden list, and the `+4` count is made by the hook --%>
<div class="lu-col" style="gap:8px"><div class="lu-pbox sm" style="width:380px"><span class="lu-chip" style="height:22px">Arroz</span><span class="lu-chip" style="height:22px">Feijão</span><span class="lu-chip" style="height:22px">Café</span><span class="lu-xs lu-muted mono">size=sm</span></div><div class="lu-pbox" style="width:380px"><span class="lu-chip" style="height:22px">Arroz</span><span class="lu-chip" style="height:22px">Feijão</span><span class="lu-chip" style="height:22px">Café</span><span class="lu-xs lu-muted mono">size=md</span></div><div class="lu-pbox lg" style="width:380px"><span class="lu-chip" style="height:22px">Arroz</span><span class="lu-chip" style="height:22px">Feijão</span><span class="lu-chip" style="height:22px">Café</span><span class="lu-xs lu-muted mono">size=lg</span></div><div class="lu-pbox one" style="width:240px"><span class="lu-chip" style="height:22px">Arroz</span><span class="lu-chip" style="height:22px">Feijão</span><span class="lu-chip" style="height:22px">Café</span><span class="more">+4</span></div></div>
