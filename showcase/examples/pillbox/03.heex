<%!-- facsimile of the vitrine markup: see the component for the interactive version --%>
<label class="lu-field"><span class="lu-label">Segmentos</span><span class="lu-input" style="height:auto;min-height:38px;padding:5px 8px;flex-wrap:wrap;gap:6px"><span class="lu-tag"><span class="sw" style="background:var(--chart-1)"></span>Pro<button aria-label="Remover Pro" data-lu-remove="" type="button"><.icon name="x" size="sm" /></button></span><span class="lu-tag"><span class="sw" style="background:var(--chart-2)"></span>Scale<button aria-label="Remover Scale" data-lu-remove="" type="button"><.icon name="x" size="sm" /></button></span><span class="lu-tag"><span class="sw" style="background:var(--chart-3)"></span>EMEA<button aria-label="Remover EMEA" data-lu-remove="" type="button"><.icon name="x" size="sm" /></button></span><input placeholder="Adicionar…" style="min-width:90px;height:26px"/></span><span class="lu-help">3 selecionados</span></label>
