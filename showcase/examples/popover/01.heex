<div class="relative h-[200px]">
  <div class="absolute top-5 left-[30px]">
    <.popover id="pop-ticket" placement="right-start" width="260px">
      <:trigger :let={aria}><.icon_button icon="info" label="Sobre" {aria} /></:trigger>
      <:title>Ticket médio</:title>
      <span class="mt-1.5 block text-[13px] leading-[18px] text-muted">Faturamento dividido pelo número de pedidos pagos no período.</span>
    </.popover>
  </div>
</div>
