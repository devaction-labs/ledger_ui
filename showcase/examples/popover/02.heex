  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-top-end" color="light" placement="top-end" text="top-end" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-right-start" color="light" placement="right-start" text="right-start" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-right" color="light" placement="right" text="right" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-right-end" color="light" placement="right-end" text="right-end" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-bottom-start" color="light" placement="bottom-start" text="bottom-start" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-bottom" color="light" placement="bottom" text="bottom" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
