  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-left-start" color="light" placement="left-start" text="left-start" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-left" color="light" placement="left" text="left" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
  <div style="height:150px;display:grid;place-items:center"><.tooltip id="pp-left-end" color="light" placement="left-end" text="left-end" open><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Gatilho</button></.tooltip></div>
</div>
