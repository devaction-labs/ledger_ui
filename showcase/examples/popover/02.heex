<div class="grid grid-cols-6 gap-1.5">
  <div :for={p <- ~w(top-start top top-end right-start right right-end bottom-start bottom bottom-end left-start left left-end)} class="grid h-[150px] place-items-center">
    <.tooltip id={"pp-#{p}"} color="light" placement={p} text="Ticket médio · R$ 168,40" arrow={false} open><.button color="neutral" variant="outline" size="sm" shape="rounded">{p}</.button></.tooltip>
  </div>
</div>
