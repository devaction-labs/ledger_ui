<div style="display:grid;grid-template-columns:70px repeat(7, minmax(0,1fr));gap:10px 12px;align-items:center">
  <span></span>
  <span class="lu-xs lu-muted mono" style="text-align:center">neutral</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">primary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">secondary</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">info</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">success</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">warning</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">error</span>
  <span class="lu-xs lu-muted mono">solid</span>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={40} color="neutral" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={48} color="primary" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={56} color="secondary" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={64} color="info" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={72} color="success" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={80} color="warning" variant="solid" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={88} color="error" variant="solid" style="width:100%" /></div>
  <span class="lu-xs lu-muted mono">soft</span>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={40} color="neutral" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={48} color="primary" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={56} color="secondary" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={64} color="info" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={72} color="success" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={80} color="warning" variant="soft" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={88} color="error" variant="soft" style="width:100%" /></div>
  <span class="lu-xs lu-muted mono">gradient</span>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={40} color="neutral" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={48} color="primary" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={56} color="secondary" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={64} color="info" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={72} color="success" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={80} color="warning" variant="gradient" style="width:100%" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.progress value={88} color="error" variant="gradient" style="width:100%" /></div>
</div>
