<div class="lu-grid" style="--cols:6;gap:14px">
  <div class="lu-cell"><.progress value={60} height="1.5" color="primary" /><span class="lu-cap">height=1.5</span></div>
  <div class="lu-cell"><.progress value={60} height="3" color="primary" /><span class="lu-cap">height=3</span></div>
  <div class="lu-cell"><.progress value={60} height="4" color="primary" /><span class="lu-cap">height=4</span></div>
  <div class="lu-cell">
    <div style="background:var(--inverse);padding:10px;border-radius:10px;width:100%"><.progress value={60} color="white" height="1.5" /></div>
    <span class="lu-cap">color=white</span>
  </div>
  <div class="lu-cell"><.progress value={40} size="md" color="primary" /><span class="lu-cap">size=md</span></div>
  <div class="lu-cell"><.progress value={40} size="lg" color="primary" /><span class="lu-cap">size=lg</span></div>
</div>
