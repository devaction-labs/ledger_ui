<div class="grid grid-cols-6 gap-3.5">
  <div :for={h <- ~w(1.5 3 4)} class="flex flex-col items-start gap-1.5"><.progress value={60} height={h} color="primary" class="w-full" /><span class="font-mono text-[11px] text-muted">height={h}</span></div>
  <div class="flex flex-col items-start gap-1.5">
    <div class="w-full rounded-[10px] bg-inverse p-2.5"><.progress value={60} color="white" height="1.5" /></div>
    <span class="font-mono text-[11px] text-muted">color=white</span>
  </div>
  <div :for={s <- ~w(md lg)} class="flex flex-col items-start gap-1.5"><.progress value={40} size={s} color="primary" class="w-full" /><span class="font-mono text-[11px] text-muted">size={s}</span></div>
</div>
