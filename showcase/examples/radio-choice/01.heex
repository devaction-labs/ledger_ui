<.radio_group id="rc-01" variant="segmented" class="w-[320px] relative [--n:3] before:absolute before:inset-y-[3px] before:left-[3px] before:w-[calc((100%-6px-2px*(var(--n)-1))/var(--n))] before:rounded-[7px] before:bg-panel before:shadow-[var(--lu-shadow-xs),0_0_0_1px_var(--lu-line)] before:animate-[lu-segslide_6s_cubic-bezier(.4,0,.2,1)_infinite] [&>button]:relative [&>button]:flex-1 [&>button]:justify-center" options={["Mensal", "Trimestral", "Anual"]} />
