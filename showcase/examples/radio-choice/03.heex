<div style="display:grid;grid-template-columns:100px repeat(4, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">xs</span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">neutral</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="neutral" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="neutral" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="neutral" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="neutral" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">primary</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="primary" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="primary" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="primary" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="primary" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">secondary</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="secondary" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="secondary" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="secondary" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="secondary" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">info</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="info" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="info" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="info" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="info" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">success</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="success" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="success" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="success" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="success" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">warning</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="warning" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="warning" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="warning" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="warning" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><span class="lu-xs lu-muted mono">error</span><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="error" size="xs" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="error" size="sm" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="error" size="md" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div><div style="display:flex;justify-content:center;min-width:0"><.radio_group color="error" size="lg" class="lu-row" value="a" options={[{"", "a"}, {"", "b"}]} /></div></div>
