<div class="grid grid-cols-2 gap-[16px]"><.range id="rs-disc" label="Desconto" show_value value_format="até %{value}%" color="primary" class="animate-[lu-slloop_5s_cubic-bezier(.45,0,.25,1)_infinite] [&_[data-part=range-thumb]]:animate-[lu-grab_5s_infinite]" value={50} /><.range id="rs-price" label="Faixa de preço" show_value value_format="R$ 0 – 1.000" color="secondary" class="animate-[lu-slloop_5s_cubic-bezier(.45,0,.25,1)_infinite] [&_[data-part=range-thumb]]:animate-[lu-grab_5s_infinite]" value={50} marks={[0, 250, 500, 750, {1000, "1.000"}]} /></div>
