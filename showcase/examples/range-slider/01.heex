<div class="lu-grid" style="--cols:2;gap:16px"><.range id="rs-disc" label="Desconto" show_value value_format="até %{value}%" color="primary" class="m-loop" value={50} /><.range id="rs-price" label="Faixa de preço" show_value value_format="R$ 0 – 1.000" color="secondary" class="m-loop" value={50} marks={[0, 250, 500, 750, {1000, "1.000"}]} /></div>
