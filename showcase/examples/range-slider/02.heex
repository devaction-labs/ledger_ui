<div style="display:grid;grid-template-columns:100px repeat(2, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">canvas</span><span class="lu-xs lu-muted mono" style="text-align:center">classic</span><span class="lu-xs lu-muted mono">neutral</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-neutral-1" color="neutral" value={30} /></div><div style="display:flex;justify-content:center;min-width:0"><.range id="r-neutral-2" color="neutral" variant="classic" value={30} /></div><span class="lu-xs lu-muted mono">primary</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-primary-1" color="primary" value={38} /></div><div style="display:flex;justify-content:center;min-width:0"><.range id="r-primary-2" color="primary" variant="classic" value={38} /></div><span class="lu-xs lu-muted mono">secondary</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-secondary-1" color="secondary" value={46} /></div><div style="display:flex;justify-content:center;min-width:0"><.range id="r-secondary-2" color="secondary" variant="classic" value={46} /></div><span class="lu-xs lu-muted mono">info</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-info-1" color="info" value={54} /></div><div style="display:flex;justify-content:center;min-width:0"><.range id="r-info-2" color="info" variant="classic" value={54} /></div><span class="lu-xs lu-muted mono">success</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-success-1" color="success" value={62} /></div><div style="display:flex;justify-content:center;min-width:0"><.range id="r-success-2" color="success" variant="classic" value={62} /></div><span class="lu-xs lu-muted mono">warning</span><div style="display:flex;justify-content:center;min-width:0"><.range id="r-warning-1" color="warning" value={70} /></div><div style="display:flex