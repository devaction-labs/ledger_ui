<div class="grid grid-cols-[100px_repeat(2,_minmax(0,1fr))] gap-y-[10px] gap-x-[12px] items-center"><span></span><span class="text-xs text-muted font-mono text-center">canvas</span><span class="text-xs text-muted font-mono text-center">classic</span><span class="text-xs text-muted font-mono">neutral</span><div class="flex justify-center min-w-0"><.range id="r-neutral-1" color="neutral" value={30} /></div><div class="flex justify-center min-w-0"><.range id="r-neutral-2" color="neutral" variant="classic" value={30} /></div><span class="text-xs text-muted font-mono">primary</span><div class="flex justify-center min-w-0"><.range id="r-primary-1" color="primary" value={38} /></div><div class="flex justify-center min-w-0"><.range id="r-primary-2" color="primary" variant="classic" value={38} /></div><span class="text-xs text-muted font-mono">secondary</span><div class="flex justify-center min-w-0"><.range id="r-secondary-1" color="secondary" value={46} /></div><div class="flex justify-center min-w-0"><.range id="r-secondary-2" color="secondary" variant="classic" value={46} /></div><span class="text-xs text-muted font-mono">info</span><div class="flex justify-center min-w-0"><.range id="r-info-1" color="info" value={54} /></div><div class="flex justify-center min-w-0"><.range id="r-info-2" color="info" variant="classic" value={54} /></div><span class="text-xs text-muted font-mono">success</span><div class="flex justify-center min-w-0"><.range id="r-success-1" color="success" value={62} /></div><div class="flex justify-center min-w-0"><.range id="r-success-2" color="success" variant="classic" value={62} /></div><span class="text-xs text-muted font-mono">warning</span><div class="flex justify-center min-w-0"><.range id="r-warning-1" color="warning" value={70} /></div><div class="flex justify-center min-w-0"><.range id="r-warning-2" color="warning" variant="classic" value={70} /></div><span class="text-xs text-muted font-mono">error</span><div class="flex justify-center min-w-0"><.range id="r-error-1" color="error" value={78} /></div><div class="flex justify-center min-w-0"><.range id="r-error-2" color="error" variant="classic" value={78} /></div></div>
