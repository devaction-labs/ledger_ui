<div class="grid grid-cols-2 gap-[16px]"><.range id="r-com" label="Comissão" show_value value_format="%{value}%" color="primary" value={35} marks={[{0, "0%"}, {25, "25%"}, {50, "50%"}, {75, "75%"}, {100, "100%"}]} /><.range id="r-qty" label="Quantidade" show_value value_format="%{value} un" color="primary" max={10} value={4} steppers /><.range id="r-per" label="Período" show_value value_format="jun – out" color="primary" value={{25, 75}} marks={[{0, "jan"}, {25, "abr"}, {50, "jul"}, {75, "out"}, {100, "dez"}]} /><div class="flex flex-wrap items-center gap-[28px] justify-center"><.range id="r-v1" color="primary" orientation="vertical" value={70} /><.range id="r-v2" color="success" orientation="vertical" value={35} /><.range id="r-v3" color="warning" orientation="vertical" value={55} /></div></div>
