<.text_editor id="rte02" name="rte02" images value="<b>Resumo de outubro</b><br>O MRR cresceu <b>8,8%</b> puxado por expansão em contas Scale. O churn ficou concentrado no plano Pro após falhas de pagamento." toolbar={[~w(heading bold italic underline), ~w(list-bullet list-ordered blockquote link image code-block)]} tool_labels={%{"heading" => "heading", "bold" => "bold", "italic" => "italic", "underline" => "underline", "list-bullet" => "list", "list-ordered" => "list-ol", "blockquote" => "quote", "link" => "link", "image" => "image", "code-block" => "code"}} />
