<div class="grid grid-cols-2 gap-4">
  <.scroll_area variant="preview" scrollbar="always" class="h-[200px]">
    <div data-part="scroll-area-content" class="animate-[mo-scroll_8s_ease-in-out_infinite] [--sy:-300px]">
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2480</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 1</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2481</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 2</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2482</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 3</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2483</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 4</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2484</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 5</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2485</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 6</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2486</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 7</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2487</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 8</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2488</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 9</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2489</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 10</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2490</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 11</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2491</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 12</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2492</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 13</span></div>
    <div class="flex h-9 flex-wrap items-center gap-2.5 border-b border-line px-3"><span class="font-mono text-[13px]">PED-2493</span><span class="min-w-0 flex-1 text-[13px] text-muted">Cliente 14</span></div>
    </div>
  </.scroll_area>
  <.scroll_area variant="preview" orientation="horizontal" scrollbar="always" class="h-[110px]">
    <div data-part="scroll-area-content" class="animate-[mo-scrollx_8s_ease-in-out_infinite] [--sx:-420px]">
      <div class="flex w-[900px] gap-2.5 p-3">
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 1</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 2</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 3</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 4</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 5</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 6</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 7</b></div>
      <div class="h-[70px] w-[150px] flex-none rounded-lg border border-line bg-panel p-2.5"><b class="text-[13px]">Filial 8</b></div>
      </div>
    </div>
  </.scroll_area>
</div>
