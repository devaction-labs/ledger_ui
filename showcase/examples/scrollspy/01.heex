<div class="grid h-[230px] grid-cols-[170px_1fr] gap-4">
  <.scrollspy id="spy1" demo label={nil}>
    <:item href="#" style="--dl:0s">Dados gerais</:item>
    <:item href="#" style="--dl:2s">Endereço</:item>
    <:item href="#" style="--dl:4s">Fiscal</:item>
    <:item href="#" style="--dl:6s">Financeiro</:item>
  </.scrollspy>
  <div class="relative overflow-hidden rounded-xl shadow-[inset_0_0_0_1px_var(--lu-line)]">
    <div class="absolute inset-x-0 top-0 flex animate-[mo-spydoc_8s_cubic-bezier(.4,0,.2,1)_infinite] flex-col gap-2.5 p-3.5">
      <h5 class="mt-1.5 text-sm font-bold">Dados gerais</h5>
      <.skeleton animation="none" class="h-2.5 w-[90%]" />
      <.skeleton animation="none" class="h-2.5 w-[70%]" />
      <.skeleton animation="none" class="h-2.5 w-[80%]" />
      <.skeleton animation="none" class="h-2.5 w-[55%]" />
      <h5 class="mt-1.5 text-sm font-bold">Endereço</h5>
      <.skeleton animation="none" class="h-2.5 w-[90%]" />
      <.skeleton animation="none" class="h-2.5 w-[70%]" />
      <.skeleton animation="none" class="h-2.5 w-[80%]" />
      <.skeleton animation="none" class="h-2.5 w-[55%]" />
      <h5 class="mt-1.5 text-sm font-bold">Fiscal</h5>
      <.skeleton animation="none" class="h-2.5 w-[90%]" />
      <.skeleton animation="none" class="h-2.5 w-[70%]" />
      <.skeleton animation="none" class="h-2.5 w-[80%]" />
      <.skeleton animation="none" class="h-2.5 w-[55%]" />
      <h5 class="mt-1.5 text-sm font-bold">Financeiro</h5>
      <.skeleton animation="none" class="h-2.5 w-[90%]" />
      <.skeleton animation="none" class="h-2.5 w-[70%]" />
      <.skeleton animation="none" class="h-2.5 w-[80%]" />
      <.skeleton animation="none" class="h-2.5 w-[55%]" />
      <h5 class="mt-1.5 text-sm font-bold">Observações</h5>
      <.skeleton animation="none" class="h-2.5 w-[90%]" />
      <.skeleton animation="none" class="h-2.5 w-[70%]" />
      <.skeleton animation="none" class="h-2.5 w-[80%]" />
      <.skeleton animation="none" class="h-2.5 w-[55%]" />
    </div>
  </div>
</div>
