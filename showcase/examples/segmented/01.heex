<div class="flex flex-wrap items-center gap-2.5">
  <.segmented id="seg-01-a" class="w-[300px] relative [--n:3] before:absolute before:inset-y-[3px] before:left-[3px] before:w-[calc((100%-6px-2px*(var(--n)-1))/var(--n))] before:rounded-[7px] before:bg-panel before:shadow-[var(--lu-shadow-xs),0_0_0_1px_var(--lu-line)] before:animate-[lu-segslide_6s_cubic-bezier(.4,0,.2,1)_infinite] [&>button]:relative [&>button]:flex-1 [&>button]:justify-center" options={["Dia", "Semana", "Mês"]} />
  <.segmented id="seg-01-b" size="sm" class="w-[240px] relative [--n:3] before:absolute before:inset-y-[3px] before:left-[3px] before:w-[calc((100%-6px-2px*(var(--n)-1))/var(--n))] before:rounded-[7px] before:bg-panel before:shadow-[var(--lu-shadow-xs),0_0_0_1px_var(--lu-line)] before:animate-[lu-segslide_6s_cubic-bezier(.4,0,.2,1)_infinite] [&>button]:relative [&>button]:flex-1 [&>button]:justify-center" options={["Lista", "Quadro", "Tabela"]} />
</div>
