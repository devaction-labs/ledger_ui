<%!-- facsimile of the vitrine markup: see the component for the interactive version --%>
<div class="lu-grid" style="--cols:5;gap:14px"><div class="lu-cell"><div class="lu-seg sm"><button class="on" type="button">Dia</button><button type="button">Mês</button></div><span class="lu-cap">size=sm</span></div><div class="lu-cell"><div class="lu-seg"><button class="on" type="button">Dia</button><button type="button">Mês</button></div><span class="lu-cap">size=md</span></div><div class="lu-cell"><div class="lu-seg lg"><button class="on" type="button">Dia</button><button type="button">Mês</button></div><span class="lu-cap">size=lg</span></div><div class="lu-cell"><div class="lu-seg"><button class="on" type="button">Dia</button><button type="button">Mês</button></div><span class="lu-cap">shape=rounded</span></div><div class="lu-cell"><div class="lu-seg" style="border-radius:999px"><button class="on" style="border-radius:999px" type="button">Dia</button><button type="button">Mês</button></div><span class="lu-cap">shape=pill</span></div></div>
