<%!-- facsimile of the vitrine markup: see the component for the interactive version --%>
<div style="display:grid;grid-template-columns:80px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">outline</span><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input sm" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input lg" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div><span class="lu-xs lu-muted mono">filled</span><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input filled sm" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input filled" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-sel2"><span class="lu-input filled lg" style="width:100%"><.icon name="building" /><span class="val">Matriz · Feira de Santana</span><.icon name="chevron-down" size="sm" /></span></div></div></div>
