<div class="grid grid-cols-[80px_repeat(3,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5">
  <span></span>
  <span class="text-center font-mono text-xs text-muted">sm</span>
  <span class="text-center font-mono text-xs text-muted">md</span>
  <span class="text-center font-mono text-xs text-muted">lg</span>
  <%= for variant <- ~w(outline filled) do %>
    <span class="font-mono text-xs text-muted">{variant}</span>
    <div :for={size <- ~w(sm md lg)} class="flex min-w-0 justify-center">
      <.select id={"sel02-#{variant}-#{size}"} variant={variant} size={size} icon="building" value="matriz" options={[{"Matriz · Feira de Santana", "matriz"}]} />
    </div>
  <% end %>
</div>
