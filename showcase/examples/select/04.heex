<%!-- raw on purpose: a static list (`lu-pop`) as in the canvas; the real list is the panel of <.select> / <.menu_list> --%>
<div class="lu-pop" style="width:280px">
  <button class="lu-menu-item sel" role="menuitem" type="button">Pro<span class="r"><.icon name="check" size="sm" class="ck" /></span></button>
  <button class="lu-menu-item" role="menuitem" type="button">Scale</button>
  <button class="lu-menu-item" role="menuitem" type="button">Starter</button>
  <div class="lu-menu-sep"></div>
  <button aria-disabled="true" class="lu-menu-item" role="menuitem" type="button">Enterprise<span class="r">Em breve</span></button>
</div>
