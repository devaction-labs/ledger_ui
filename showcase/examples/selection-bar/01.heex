<div style="height:110px;position:relative;overflow:hidden;border-radius:14px;background:var(--bg-tray)">
  <div style="position:absolute;left:0;right:0;bottom:16px;display:flex;justify-content:center">
    <.bulk_bar id="sel-live" count={3} label="selecionado" label_plural="selecionados" floating={false} class="mo-sel">
      <:action icon="file">Emitir NF-e</:action>
        <:action icon="download">Exportar</:action>
        <:action variant="danger" icon="trash">Excluir</:action>
    </.bulk_bar>
  </div>
</div>
