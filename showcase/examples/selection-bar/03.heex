<div style="display:flex;justify-content:center;padding:20px;background:var(--bg-tray);border-radius:16px">
  <.bulk_bar id="sel-ref" count={2} label="selecionada" label_plural="selecionadas" floating={false} on_clear="clear" clear_label="Limpar">
    <:action icon="user-plus">Atribuir</:action>
    <:action icon="tag">Tag</:action>
    <:action icon="download">Exportar</:action>
    <:action variant="danger" icon="trash">Excluir</:action>
  </.bulk_bar>
</div>
