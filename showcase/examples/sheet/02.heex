<.drawer id="sheet-filters" inline placement="bottom" style="height:380px;padding:0">
<div class="lu-row" style="padding:8px 18px 12px"><b style="font-size:17px">Filtros</b><span class="lu-grow"></span><button class="lu-btn link sm" type="button">Limpar</button></div><div class="lu-col" style="padding:0 18px 12px"><label class="lu-field"><span class="lu-label">Plano</span><div class="lu-row"><button class="lu-chip on" data-lu-toggle="" type="button">Pro</button><button class="lu-chip" data-lu-toggle="" type="button">Scale</button><button class="lu-chip" data-lu-toggle="" type="button">Starter</button></div></label><label class="lu-field"><span class="lu-label">Status</span><div class="lu-seg block" data-lu-single="" role="tablist"><button aria-selected="false" class="" data-v="todos" role="tab" type="button">Todos</button><button aria-selected="true" class="on" data-v="em risco" role="tab" type="button">Em risco</button><button aria-selected="false" class="" data-v="ativas" role="tab" type="button">Ativas</button></div></label></div><div style="padding:12px 18px 16px;border-top:1px solid var(--line)"><button class="lu-btn primary block lg" type="button">Mostrar 23 contas</button></div>
</.drawer>
