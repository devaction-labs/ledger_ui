<% rows = [
    %{av: "PB", name: "Priya Banerjee", age: "32F", mrn: "MRN-0204013", bed: "ED-01", cond: "Shortness of breath", st: "Needs approval", st_c: "warning", risk: "Medium", risk_c: "primary", adm: "4d ago"},
    %{av: "SM", name: "Sofia Mensah", age: "31F", mrn: "MRN-0204043", bed: "ED-02", cond: "Syncope", st: "Open", st_c: "neutral", risk: "Low", risk_c: "neutral", adm: "5d ago"},
    %{av: "CR", name: "Clara Reyes", age: "81F", mrn: "MRN-0204101", bed: "ED-03", cond: "Chest pain", st: "Open", st_c: "neutral", risk: "Low", risk_c: "neutral", adm: "4d ago"},
    %{av: "FH", name: "Felix Hussain", age: "66M", mrn: "MRN-0204161", bed: "ED-06", cond: "Shortness of breath", st: "Needs approval", st_c: "warning", risk: "Medium", risk_c: "primary", adm: "3d ago"},
    %{av: "LI", name: "Lucia Ivanova", age: "55F", mrn: "MRN-0204363", bed: "ED-24", cond: "Syncope", st: "Solved", st_c: "success", risk: "Medium", risk_c: "primary", adm: "4d ago"},
    %{av: "JN", name: "Jonas Nowak", age: "81M", mrn: "MRN-0204385", bed: "ED-08", cond: "Fever and cough", st: "Open", st_c: "neutral", risk: "High", risk_c: "warning", adm: "5d ago"},
    %{av: "EM", name: "Elena Moreau", age: "49F", mrn: "MRN-0204452", bed: "ICU-01", cond: "Acute kidney injury", st: "Needs approval", st_c: "warning", risk: "Critical", risk_c: "error", adm: "2d ago"}
  ] %>
<.shell_floating id="shell-float-demo" class="min-h-[900px]! min-w-[1360px] rounded-2xl border border-line" persist={false}>
  <:sidebar>
    <.main_sidebar id="rail-float" aria-label="Módulos"><:logo><.icon name="settings" size="lg" /></:logo><:item label="home"><.icon name="home" /></:item><:item label="bot"><.icon name="bot" /></:item><:item label="inbox" active><.icon name="inbox" /></:item><:item label="layers"><.icon name="layers" /></:item><:item label="check-circle"><.icon name="check-circle" /><.badge canvas color="warning" class="absolute -right-1 -top-1">8</.badge></:item><:item label="logout"><.icon name="logout" /></:item><:item label="history"><.icon name="history" /></:item><:item label="bookmark"><.icon name="bookmark" /></:item><:item label="users"><.icon name="users" /></:item></.main_sidebar>
    <.sidebar_panel title="Cases"><.sidebar_nav_link href="#" active><.icon name="list" size="md" />All<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">60</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="package" size="md" />Archived<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">0</span></.sidebar_nav_link><div class="flex items-center gap-1 px-2.5 pb-1.5 pt-3 text-[12.5px] font-medium text-muted"><.icon name="chevron-down" size="sm" />Status</div><.sidebar_nav_link href="#"><.icon name="circle" size="md" />New<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">11</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="clock" size="md" />Open<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">31</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="shield" size="md" />Needs approval<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">7</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="check-circle" size="md" />Solved<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">11</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="plus" size="md" />Add Status</.sidebar_nav_link><div class="flex items-center gap-1 px-2.5 pb-1.5 pt-3 text-[12.5px] font-medium text-muted"><.icon name="chevron-down" size="sm" />Department</div><.sidebar_nav_link href="#"><.icon name="alert" size="md" />ED<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">12</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="target" size="md" />ICU<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">17</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="tool" size="md" />Surgery<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">17</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="smile" size="md" />Pediatrics<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">14</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="droplet" size="md" />Pharmacy<span data-part="nav-r" class="ml-auto font-mono text-[12px] tabular-nums text-muted">2</span></.sidebar_nav_link><.sidebar_nav_link href="#"><.icon name="plus" size="md" />Add Department</.sidebar_nav_link></.sidebar_panel>
  </:sidebar>
  <:header>
    <.header toggle={false} theme_toggle={false} monochrome_toggle={false} search_placeholder="Search or run…">
      <:start><.navbar_crumbs label={nil} items={[%{label: "St. Aurelia General", href: "#"}, %{label: "Cases"}]} /></:start>
      <:actions><.navbar_bell dot /></:actions>
      <:profile><.avatar initials="IS" color="t1" size="md" /></:profile>
    </.header>
  </:header>
  <.page_header>
    <:heading>All cases</:heading>
    <:subtitle><b class="font-mono text-ink">60</b> cases. Use the side panel to filter by status or department.</:subtitle>
    <:actions>
      <.navbar_search input kbd="/" placeholder="Search name, MRN, bed" width="280px" />
      <.button><.icon name="plus" />New case</.button>
    </:actions>
  </.page_header>
  <div class="px-7 pb-7">
    <.card_table id="float-cases" rows={rows}>
      <:col :let={r} label="Patient"><span class="flex flex-nowrap items-center gap-2.5"><.avatar variant="mono" initials={r.av} size="sm" /><span class="text-ink">{r.name}</span><span class="text-muted">{r.age}</span></span></:col>
      <:col :let={r} label="MRN"><span class="font-mono">{r.mrn}</span></:col>
      <:col :let={r} label="Bed"><span class="font-mono text-ink">{r.bed}</span></:col>
      <:col :let={r} label="Condition">{r.cond}</:col>
      <:col :let={r} label="Status"><.badge canvas variant="outline" color={r.st_c}>{r.st}</.badge></:col>
      <:col :let={r} label="Risk"><.badge canvas variant="outline" color={r.risk_c}>{r.risk}</.badge></:col>
      <:col :let={r} label="Admitted" align="right"><span class="font-mono">{r.adm}</span></:col>
    </.card_table>
  </div>
</.shell_floating>
