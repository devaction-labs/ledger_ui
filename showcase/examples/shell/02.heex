<div class="grid grid-cols-3 gap-3.5">
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">sidebar</span>
    <.shell variant="preview" layout="sidebar" />
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">minimal</span>
    <.shell variant="preview" layout="minimal" />
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">sideblock</span>
    <.shell variant="preview" layout="sideblock" />
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">horizontal</span>
    <.shell variant="preview" layout="horizontal" />
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">framed</span>
    <.shell variant="preview" layout="framed" />
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">rail</span>
    <.shell variant="preview" layout="rail" />
  </div>
</div>
