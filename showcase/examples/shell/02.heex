<div class="lu-grid" style="--cols:3;gap:14px">
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">sidebar</span>
    <.shell variant="preview" layout="sidebar" />
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">minimal</span>
    <.shell variant="preview" layout="minimal" />
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">sideblock</span>
    <.shell variant="preview" layout="sideblock" />
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">horizontal</span>
    <.shell variant="preview" layout="horizontal" />
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">framed</span>
    <.shell variant="preview" layout="framed" />
  </div>
  <div class="lu-col" style="gap:6px">
    <span class="lu-xs lu-muted mono">rail</span>
    <.shell variant="preview" layout="rail" />
  </div>
</div>
