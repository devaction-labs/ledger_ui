<div class="grid grid-cols-8 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="success" dot>success</.badge><span class="font-mono text-[11px] text-muted">status=success</span></div>
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="warning" dot>warning</.badge><span class="font-mono text-[11px] text-muted">status=warning</span></div>
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="error" dot>error</.badge><span class="font-mono text-[11px] text-muted">status=error</span></div>
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="info" dot>info</.badge><span class="font-mono text-[11px] text-muted">status=info</span></div>
  <div class="flex flex-col items-start gap-1.5"><.badge canvas color="neutral" dot>neutral</.badge><span class="font-mono text-[11px] text-muted">status=neutral</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="neutral"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=neutral</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="secondary"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=secondary</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="info"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=info</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="success"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=success</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="warning"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=warning</span></div>
  <div class="flex flex-col items-start gap-1.5"><.sidebar_nav_link active color="error"><.icon name="grid" size="md" />Item</.sidebar_nav_link><span class="font-mono text-[11px] text-muted">color=error</span></div>
  <div class="flex flex-col items-start gap-1.5"><.chip>default</.chip><span class="font-mono text-[11px] text-muted">variant=default</span></div>
  <div class="flex flex-col items-start gap-1.5"><.chip>canvas</.chip><span class="font-mono text-[11px] text-muted">variant=canvas</span></div>
  <div class="flex flex-col items-start gap-1.5"><.switch color="primary" checked aria-label="switch" /><span class="font-mono text-[11px] text-muted">variant=switch</span></div>
  <div class="flex flex-col items-start gap-1.5"><.inline_code>/pedidos</.inline_code><span class="font-mono text-[11px] text-muted">match=exact</span></div>
  <div class="flex flex-col items-start gap-1.5"><.inline_code>/pedidos/*</.inline_code><span class="font-mono text-[11px] text-muted">match=prefix</span></div>
</div>
