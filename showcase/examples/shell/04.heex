<div class="lu-grid" style="--cols:8;gap:14px"><div class="lu-cell"><span class="lu-bd c-success v-soft"><span class="lu-dot" style="background:var(--c)"></span>success</span><span class="lu-cap">status=success</span></div><div class="lu-cell"><span class="lu-bd c-warning v-soft"><span class="lu-dot" style="background:var(--c)"></span>warning</span><span class="lu-cap">status=warning</span></div><div class="lu-cell"><span class="lu-bd c-error v-soft"><span class="lu-dot" style="background:var(--c)"></span>error</span><span class="lu-cap">status=error</span></div><div class="lu-cell"><span class="lu-bd c-info v-soft"><span class="lu-dot" style="background:var(--c)"></span>info</span><span class="lu-cap">status=info</span></div><div class="lu-cell"><span class="lu-bd c-neutral v-soft"><span class="lu-dot" style="background:var(--c)"></span>neutral</span><span class="lu-cap">status=neutral</span></div><div class="lu-cell"><span class="lu-nav-item on c-neutral" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=neutral</span></div><div class="lu-cell"><span class="lu-nav-item on c-secondary" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=secondary</span></div><div class="lu-cell"><span class="lu-nav-item on c-info" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=info</span></div><div class="lu-cell"><span class="lu-nav-item on c-success" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=success</span></div><div class="lu-cell"><span class="lu-nav-item on c-warning" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=warning</span></div><div class="lu-cell"><span class="lu-nav-item on c-error" style="background:var(--c-soft);color:var(--c-ink)"><i class="md" data-i="grid"></i>Item</span><span class="lu-cap">color=error</span></div><div class="lu-cell"><span class="lu-chip">default</span><span class="lu-cap">variant=default</span></div><div class="lu-cell"><span class="lu-chip">canvas</span><span class="lu-cap">variant=canvas</span></div><div class="lu-cell"><span class="lu-sw on"><i></i></span><span class="lu-cap">variant=switch</span></div><div class="lu-cell"><span class="lu-tmini">/pedidos</span><span class="lu-cap">match=exact</span></div><div class="lu-cell"><span class="lu-tmini">/pedidos/*</span><span class="lu-cap">match=prefix</span></div></div>
