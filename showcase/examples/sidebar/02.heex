<div class="grid grid-cols-4 gap-3.5">
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">sections · sidebar</span>
    <div class="flex min-h-[520px] overflow-hidden rounded-2xl border border-line bg-shell">
      <.sidebar id="sb-sections" variant="sidebar" style="width:260px;min-height:380px"
        brand={%{name: "Signetum", sub: "Bom Preço · Matriz", mark: true}}
        nav={[
          %{label: "Início", icon: "grid", href: "#", style: "--dl:0s", active: true},
          %{label: "Pedidos", icon: "cart", href: "#", style: "--dl:1s", count: "12"},
          %{label: "Notas fiscais", icon: "file", href: "#", style: "--dl:2s"},
          %{label: "Clientes", icon: "users", href: "#", style: "--dl:3s", count: "1.096"},
          %{label: "Financeiro", icon: "wallet", href: "#", style: "--dl:4s"},
          %{label: "Estoque", icon: "layers", href: "#", style: "--dl:5s", count: "3", alert: true},
          %{label: "Ajustes", icon: "settings", href: "#", style: "--dl:6s"},
          %{label: "Ajuda", icon: "help", href: "#", style: "--dl:7s"}
        ]}
      />
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">tree</span>
    <div class="flex min-h-[520px] overflow-hidden rounded-2xl border border-line bg-shell">
      <.sidebar id="sb-tree" format="tree" collapsible={false} variant="sidebar" style="width:260px;min-height:380px"
        nav={[
          %{label: "Início", icon: "grid", href: "#", style: "--dl:0s", active: true},
          %{label: "Pedidos", icon: "cart", href: "#", style: "--dl:1s", count: "12"},
          %{label: "Fiscal", icon: "file", href: "#", loose: true, collapsible: false, open: true, children: [
            %{label: "NF-e", href: "#", active: true},
            %{label: "NFC-e", href: "#"},
            %{label: "Manifesto", href: "#"}
          ]},
          %{label: "Financeiro", icon: "wallet", href: "#", loose: true, caret: "right"}
        ]}
      />
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">floating</span>
    <div class="rounded-[16px] bg-shell">
      <.sidebar id="sb-floating" variant="floating" style="width:240px;min-height:380px"
        brand={%{name: "Signetum", sub: "Bom Preço · Matriz", mark: true}}
        nav={[
          %{label: "Início", icon: "grid", href: "#", style: "--dl:0s", active: true},
          %{label: "Pedidos", icon: "cart", href: "#", style: "--dl:1s", count: "12"},
          %{label: "Notas fiscais", icon: "file", href: "#", style: "--dl:2s"},
          %{label: "Clientes", icon: "users", href: "#", style: "--dl:3s", count: "1.096"},
          %{label: "Financeiro", icon: "wallet", href: "#", style: "--dl:4s"},
          %{label: "Estoque", icon: "layers", href: "#", style: "--dl:5s", count: "3", alert: true},
          %{label: "Ajustes", icon: "settings", href: "#", style: "--dl:6s"},
          %{label: "Ajuda", icon: "help", href: "#", style: "--dl:7s"}
        ]}
      />
    </div>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">inset</span>
    <div class="rounded-[16px] bg-page shadow-[inset_0_0_0_1px_var(--lu-line)]">
      <.sidebar id="sb-inset" variant="inset" style="width:240px;min-height:380px"
        brand={%{name: "Signetum", sub: "Bom Preço · Matriz", mark: true}}
        nav={[
          %{label: "Início", icon: "grid", href: "#", style: "--dl:0s", active: true},
          %{label: "Pedidos", icon: "cart", href: "#", style: "--dl:1s", count: "12"},
          %{label: "Notas fiscais", icon: "file", href: "#", style: "--dl:2s"},
          %{label: "Clientes", icon: "users", href: "#", style: "--dl:3s", count: "1.096"},
          %{label: "Financeiro", icon: "wallet", href: "#", style: "--dl:4s"},
          %{label: "Estoque", icon: "layers", href: "#", style: "--dl:5s", count: "3", alert: true},
          %{label: "Ajustes", icon: "settings", href: "#", style: "--dl:6s"},
          %{label: "Ajuda", icon: "help", href: "#", style: "--dl:7s"}
        ]}
      />
    </div>
  </div>
</div>
