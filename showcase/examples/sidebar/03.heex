<div class="lu-app" style="width:290px;min-height:820px;box-shadow:none">
  <.sidebar
    id="sb-ledgerly"
    variant="sidebar"
    flat
    footer="user"
    brand={%{name: "Ledgerly", sub: "Orbit Cloud · Finance", mark: true, switch: true}}
    plan={%{name: "Ledgerly AI", text: "3 new revenue insights", description: "Ask why revenue moved and get the accounts behind it.", action: %{label: "Run AI insights", icon: "sparkles"}}}
    user={%{name: "Ikram Sakib", role: "Head of Finance", initials: "IS", tone: "t1", status: "on"}}
    nav={[
      %{label: "Search", icon: "search", href: "#", kbd: "⌘K"},
      %{label: "Inbox", icon: "inbox", href: "#", count: "3"},
      :separator,
      %{label: "Overview", icon: "grid", href: "#", active: true},
      %{label: "Revenue", icon: "trend-up", href: "#"},
      %{label: "Customers", icon: "users", href: "#", count: "1,096"},
      %{label: "Plans", icon: "layers", href: "#"},
      %{label: "Cohorts", icon: "table", href: "#"},
      %{label: "Churn", icon: "user-minus", href: "#", count: "23", alert: true},
      %{label: "Reports", icon: "file", href: "#"},
      :separator,
      %{label: "Board packs", icon: "folder", href: "#", class: "folder", caret: "right"},
      %{label: "Pro churn watch", icon: "folder", href: "#", class: "folder", caret: "right"},
      %{label: "EMEA expansion", icon: "folder", href: "#", class: "folder", caret: "right"},
      %{label: "Create view", icon: "folder-plus", href: "#"},
      %{group: "Foot", footer: true, items: [
        %{label: "Settings", icon: "settings", href: "#"},
        %{label: "Help & docs", icon: "help", href: "#"}
      ]}
    ]}
  />
</div>
