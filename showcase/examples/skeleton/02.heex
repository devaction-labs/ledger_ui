<div class="lu-grid" style="--cols:3;gap:16px">
  <div class="lu-col" style="gap:8px">
    <span class="lu-xs lu-muted mono">wave</span>
    <.skeleton animation="wave" style="width:80%" />
    <.skeleton animation="wave" style="width:55%" />
  </div>
  <div class="lu-col" style="gap:8px">
    <span class="lu-xs lu-muted mono">pulse</span>
    <.skeleton animation="pulse" style="width:80%" />
    <.skeleton animation="pulse" style="width:55%" />
  </div>
  <div class="lu-col" style="gap:8px">
    <span class="lu-xs lu-muted mono">none</span>
    <.skeleton animation="none" style="width:80%" />
    <.skeleton animation="none" style="width:55%" />
  </div>
</div>
