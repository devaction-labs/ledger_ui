<div class="grid grid-cols-3 gap-3.5">
  <div :for={v <- ~w(canvas lineone)} class="flex flex-col items-start gap-1.5">
    <div class="flex w-full flex-col gap-1.5"><.skeleton variant={v} tag="span" animation={nil} class="h-3 w-4/5" /><.skeleton variant={v} tag="span" animation={nil} class="h-3 w-3/5" /></div>
    <span class="font-mono text-[11px] text-muted">variant={v}</span>
  </div>
</div>
