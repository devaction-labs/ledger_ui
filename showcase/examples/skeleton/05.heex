<div class="lu-grid" style="--cols:3;gap:14px">
  <div class="lu-cell">
    <div class="lu-col" style="gap:6px;width:100%"><.skeleton tag="span" animation={nil} style="height:12px;width:80%" /><.skeleton tag="span" animation={nil} style="height:12px;width:60%" /></div>
    <span class="lu-cap">variant=canvas</span>
  </div>
  <div class="lu-cell">
    <div class="lu-col" style="gap:6px;width:100%"><.skeleton variant="lineone" tag="span" animation={nil} style="height:12px;width:80%" /><.skeleton variant="lineone" tag="span" animation={nil} style="height:12px;width:60%" /></div>
    <span class="lu-cap">variant=lineone</span>
  </div>
</div>
