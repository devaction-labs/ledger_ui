<div style="display:grid;grid-template-columns:70px repeat(5, minmax(0,1fr));gap:10px 12px;align-items:center">
  <span></span>
  <span class="lu-xs lu-muted mono" style="text-align:center">xs</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">sm</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">md</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">lg</span>
  <span class="lu-xs lu-muted mono" style="text-align:center">xl</span>
  <span class="lu-xs lu-muted mono">canvas</span>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="canvas" size="xs" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="canvas" size="sm" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="canvas" size="md" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="canvas" size="lg" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="canvas" size="xl" color="primary" label="Carregando" /></div>
  <span class="lu-xs lu-muted mono">border</span>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="border" size="xs" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="border" size="sm" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="border" size="md" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="border" size="lg" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="border" size="xl" color="primary" label="Carregando" /></div>
  <span class="lu-xs lu-muted mono">soft</span>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="soft" size="xs" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="soft" size="sm" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="soft" size="md" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="soft" size="lg" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="soft" size="xl" color="primary" label="Carregando" /></div>
  <span class="lu-xs lu-muted mono">grow</span>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="grow" size="xs" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="grow" size="sm" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="grow" size="md" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="grow" size="lg" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="grow" size="xl" color="primary" label="Carregando" /></div>
  <span class="lu-xs lu-muted mono">svg</span>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="svg" size="xs" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="svg" size="sm" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="svg" size="md" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="svg" size="lg" color="primary" label="Carregando" /></div>
  <div style="display:flex;justify-content:center;min-width:0"><.spinner variant="svg" size="xl" color="primary" label="Carregando" /></div>
</div>
