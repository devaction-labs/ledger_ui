<div class="grid w-full grid-cols-2 gap-x-[18px] gap-y-4">
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">tone=default</span>
    <.stat_group><.stat_item label="Clientes" value="1.096" /></.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">tone=accent</span>
    <.stat_group><.stat_item label="Total" value="R$ 3.120" tone="accent" /></.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">size=sm</span>
    <.stat_group><.stat_item label="Pagamento" value="Boleto" size="sm" /></.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">unit</span>
    <.stat_group><.stat_item label="Prazo médio" value="18" unit="dias" /></.stat_group>
  </div>
</div>
