<div class="grid w-full grid-cols-2 gap-x-[18px] gap-y-4">
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">delta subindo (bom)</span>
    <.stat_group>
      <.stat_item label="Recebido hoje" value="R$ 12.480" change="18%" note="vs. ontem" />
    </.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">delta subindo (ruim)</span>
    <.stat_group>
      <.stat_item
        label="Em atraso"
        value="R$ 3.210"
        change="6%"
        change_tone="neg"
        note="vs. semana passada"
      />
    </.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">meta</span>
    <.stat_group>
      <.stat_item
        label="Meta do mês"
        value="R$ 184 mil"
        meter={74}
        note="74% de R$ 250 mil · faltam 10 dias"
      />
    </.stat_group>
  </div>
  <div class="flex flex-col gap-2 w-full">
    <span class="font-mono text-xs text-muted">sparkline</span>
    <.stat_group>
      <.stat_item
        label="Pedidos / dia"
        value="48"
        note="últimos 12 dias"
        sparkline={[0.6, 3, 0, 4.8, 7.7, 5.9, 9.5, 13.1, 11.3, 14.9, 18.4, 22]}
      />
    </.stat_group>
  </div>
</div>
