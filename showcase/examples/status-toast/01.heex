<div class="flex flex-col items-start gap-2.5">
  <.status_toast state="run" role={nil}>Importando <b>stripe-oct.csv</b></.status_toast>
  <.status_toast state="run" percent={64} role={nil}>Gerando board pack · <b>64%</b><:action ghost>Cancelar</:action></.status_toast>
  <.status_toast state="queue" role={nil}>Backup <b>orbit-db</b> na fila</.status_toast>
  <.status_toast state="ok" role={nil}>Deploy de <b>nexus_pro</b> concluído<:action>Ver</:action></.status_toast>
  <.status_toast state="err" role={nil}>Falha ao transmitir <b>NF-e 4312</b><:action>Tentar de novo</:action></.status_toast>
</div>
