<div class="lu-row lu-start"><.step_group style="width:340px"><:step title="Validar XML" status={:ok} result="0,4s" /><:step title="Assinar" status={:ok} result="1,2s" /><:step title="Transmitir à SEFAZ" status={:running} /><:step title="Gerar DANFE" status={:waiting} /><:step title="Enviar por WhatsApp" status={:skipped} /><:step title="Enviar por e-mail" status={:failed} result="erro" /><:step title="Imprimir" status={:canceled} /></.step_group><div class="lu-sg2" style="width:300px"><div class="r ok okk"><span class="ic"><.icon name="check" size="sm" /></span>tone ok</div><div class="r failed err"><span class="ic"><.icon name="x" size="sm" /></span>tone err</div><div class="r waiting dim"><span class="ic"></span>tone dim</div></div></div>
