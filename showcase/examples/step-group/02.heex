<div class="lu-row lu-start"><.step_group style="width:340px"><:step title="Validar XML" status={:ok} result="0,4s" /><:step title="Assinar" status={:ok} result="1,2s" /><:step title="Transmitir à SEFAZ" status={:running} /><:step title="Gerar DANFE" status={:waiting} /><:step title="Enviar por WhatsApp" status={:skipped} /><:step title="Enviar por e-mail" status={:failed} result="erro" /><:step title="Imprimir" status={:canceled} /></.step_group><.step_group style="width:300px"><:step title="tone ok" status={:ok} class="bg-pos-soft" /><:step title="tone err" status={:failed} class="bg-neg-soft" /><:step title="tone dim" status={:waiting} class="opacity-55" /></.step_group></div>
