<.card canvas><.card_header><.card_heading level={3}>Configuração · 2 de 4</.card_heading></.card_header><.card_body><div class="lu-col" style="gap:0"><div class="lu-row" style="padding:10px 0;border-top:0;gap:12px"><span class="lu-step done" style="gap:0"><span class="n"><.icon name="check" size="sm" /></span></span><span class="lu-col lu-grow" style="gap:0"><b style="font-weight:500;color:var(--muted)">Criar workspace</b><span class="lu-xs lu-muted">Orbit Cloud</span></span></div><div class="lu-row" style="padding:10px 0;border-top:1px solid var(--line);gap:12px"><span class="lu-step done" style="gap:0"><span class="n"><.icon name="check" size="sm" /></span></span><span class="lu-col lu-grow" style="gap:0"><b style="font-weight:500;color:var(--muted)">Convidar equipe</b><span class="lu-xs lu-muted">3 pessoas</span></span></div><div class="lu-row" style="padding:10px 0;border-top:1px solid var(--line);gap:12px"><span class="lu-step cur" style="gap:0"><span class="n">3</span></span><span class="lu-col lu-grow" style="gap:0"><b style="font-weight:500;">Conectar Stripe</b><span class="lu-xs lu-muted">Importa assinaturas e MRR</span></span><button class="lu-btn sm primary" type="button">Conectar</button></div><div class="lu-row" style="padding:10px 0;border-top:1px solid var(--line);gap:12px"><span class="lu-step" style="gap:0"><span class="n">4</span></span><span class="lu-col lu-grow" style="gap:0"><b style="font-weight:500;">Definir metas</b><span class="lu-xs lu-muted">MRR e churn</span></span></div></div></.card_body><.card_footer><div class="lu-progress sm lu-grow"><i style="width:50%"></i></div><span class="num">50%</span></.card_footer></.card>
