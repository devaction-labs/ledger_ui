<div class="grid grid-cols-3 gap-[14px]"><div class="flex flex-col items-start gap-1.5"><.badge color="primary" variant="solid">accent</.badge><span class="font-mono text-[11px] text-muted">color=accent</span></div><div class="flex flex-col items-start gap-1.5"><.chip label="md" /><span class="font-mono text-[11px] text-muted">size=md</span></div><div class="flex flex-col items-start gap-1.5"><.stepper color="primary" class="w-[260px]" current={1}><:step label="Conta" marker="1" state="done" /><:step label="Plano" marker="2" /><:step label="Fim" marker="3" /></.stepper><span class="font-mono text-[11px] text-muted">variant=classic</span></div></div>
