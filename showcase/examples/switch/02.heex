<div class="grid grid-cols-[100px_repeat(5,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span class="text-center font-mono text-xs text-muted">off</span><span class="text-center font-mono text-xs text-muted">on</span><span class="text-center font-mono text-xs text-muted">outline on</span><span class="text-center font-mono text-xs text-muted">outline filled</span><span class="text-center font-mono text-xs text-muted">desabilitado</span><span class="font-mono text-xs text-muted">neutral</span><div class="flex min-w-0 justify-center"><.switch color="neutral" /></div><div class="flex min-w-0 justify-center"><.switch color="neutral" checked /></div><div class="flex min-w-0 justify-center"><.switch color="neutral" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="neutral" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="neutral" disabled checked /></div><span class="font-mono text-xs text-muted">primary</span><div class="flex min-w-0 justify-center"><.switch color="primary" /></div><div class="flex min-w-0 justify-center"><.switch color="primary" checked /></div><div class="flex min-w-0 justify-center"><.switch color="primary" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="primary" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="primary" disabled checked /></div><span class="font-mono text-xs text-muted">secondary</span><div class="flex min-w-0 justify-center"><.switch color="secondary" /></div><div class="flex min-w-0 justify-center"><.switch color="secondary" checked /></div><div class="flex min-w-0 justify-center"><.switch color="secondary" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="secondary" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="secondary" disabled checked /></div><span class="font-mono text-xs text-muted">info</span><div class="flex min-w-0 justify-center"><.switch color="info" /></div><div class="flex min-w-0 justify-center"><.switch color="info" checked /></div><div class="flex min-w-0 justify-center"><.switch color="info" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="info" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="info" disabled checked /></div><span class="font-mono text-xs text-muted">success</span><div class="flex min-w-0 justify-center"><.switch color="success" /></div><div class="flex min-w-0 justify-center"><.switch color="success" checked /></div><div class="flex min-w-0 justify-center"><.switch color="success" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="success" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="success" disabled checked /></div><span class="font-mono text-xs text-muted">warning</span><div class="flex min-w-0 justify-center"><.switch color="warning" /></div><div class="flex min-w-0 justify-center"><.switch color="warning" checked /></div><div class="flex min-w-0 justify-center"><.switch color="warning" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="warning" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="warning" disabled checked /></div><span class="font-mono text-xs text-muted">error</span><div class="flex min-w-0 justify-center"><.switch color="error" /></div><div class="flex min-w-0 justify-center"><.switch color="error" checked /></div><div class="flex min-w-0 justify-center"><.switch color="error" variant="outline" checked /></div><div class="flex min-w-0 justify-center"><.switch color="error" variant="outline" filled checked /></div><div class="flex min-w-0 justify-center"><.switch color="error" disabled checked /></div></div>
