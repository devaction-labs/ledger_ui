<div style="display:grid;grid-template-columns:100px repeat(5, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">off</span><span class="lu-xs lu-muted mono" style="text-align:center">on</span><span class="lu-xs lu-muted mono" style="text-align:center">outline on</span><span class="lu-xs lu-muted mono" style="text-align:center">outline filled</span><span class="lu-xs lu-muted mono" style="text-align:center">desabilitado</span><span class="lu-xs lu-muted mono">neutral</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="neutral" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="neutral" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="neutral" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="neutral" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="neutral" disabled checked /></div><span class="lu-xs lu-muted mono">primary</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="primary" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="primary" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="primary" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="primary" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="primary" disabled checked /></div><span class="lu-xs lu-muted mono">secondary</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="secondary" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="secondary" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="secondary" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="secondary" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="secondary" disabled checked /></div><span class="lu-xs lu-muted mono">info</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="info" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="info" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="info" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="info" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="info" disabled checked /></div><span class="lu-xs lu-muted mono">success</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="success" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="success" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="success" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="success" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="success" disabled checked /></div><span class="lu-xs lu-muted mono">warning</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="warning" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="warning" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="warning" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="warning" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="warning" disabled checked /></div><span class="lu-xs lu-muted mono">error</span><div style="display:flex;justify-content:center;min-width:0"><.switch color="error" /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="error" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="error" variant="outline" checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="error" variant="outline" filled checked /></div><div style="display:flex;justify-content:center;min-width:0"><.switch color="error" disabled checked /></div></div>
