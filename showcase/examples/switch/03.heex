<div style="display:grid;grid-template-columns:130px repeat(3, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">lg</span><span class="lu-xs lu-muted mono">squircle (padrão)</span><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="sm" shape="squircle" /><.switch color="primary" size="sm" shape="squircle" checked /></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="md" shape="squircle" /><.switch color="primary" size="md" shape="squircle" checked /></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="lg" shape="squircle" /><.switch color="primary" size="lg" shape="squircle" checked /></div></div><span class="lu-xs lu-muted mono">pill</span><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="sm" shape="pill" /><.switch color="primary" size="sm" shape="pill" checked /></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="md" shape="pill" /><.switch color="primary" size="md" shape="pill" checked /></div></div><div style="display:flex;justify-content:center;min-width:0"><div class="lu-row"><.switch color="primary" size="lg" shape="pill" /><.switch color="primary" size="lg" shape="pill" checked /></div></div></div>
