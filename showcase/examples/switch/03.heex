<div class="grid grid-cols-[130px_repeat(3,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span class="text-center font-mono text-xs text-muted">sm</span><span class="text-center font-mono text-xs text-muted">md</span><span class="text-center font-mono text-xs text-muted">lg</span><span class="font-mono text-xs text-muted">squircle (padrão)</span><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="sm" shape="squircle" /><.switch color="primary" size="sm" shape="squircle" checked /></div></div><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="md" shape="squircle" /><.switch color="primary" size="md" shape="squircle" checked /></div></div><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="lg" shape="squircle" /><.switch color="primary" size="lg" shape="squircle" checked /></div></div><span class="font-mono text-xs text-muted">pill</span><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="sm" shape="pill" /><.switch color="primary" size="sm" shape="pill" checked /></div></div><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="md" shape="pill" /><.switch color="primary" size="md" shape="pill" checked /></div></div><div class="flex min-w-0 justify-center"><div class="flex flex-wrap items-center gap-2.5"><.switch color="primary" size="lg" shape="pill" /><.switch color="primary" size="lg" shape="pill" checked /></div></div></div>
