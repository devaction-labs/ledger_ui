<.table_toolbar>
  <:start>
    <span class="lu-input sm m-type" style="width:260px"><.icon name="search" size="md" /><span class="val"><span class="typed" style="--steps:9">bom preço</span><span class="caret"></span></span></span>
    <button class="lu-btn sm" type="button"><.icon name="filter" />Filtrar</button>
    <span class="lu-tag mo-stg" style="display:inline-flex"><span>Status: Pago</span></span>
  </:start>
  <:actions>
    <button class="lu-b c-mono v-solid s-sm sh-rounded" type="button"><.icon name="plus" />Novo pedido</button>
  </:actions>
</.table_toolbar>
