<.table_toolbar id="tb-demo" search="bom preço" search_width="260px">
  <:start>
    <.button canvas size="sm"><.icon name="filter" size="md" />Filtrar</.button>
    <.tag canvas class="animate-[mo-stg_var(--dur,6s)_cubic-bezier(.2,.8,.2,1)_infinite]">Status: Pago</.tag>
  </:start>
  <:actions>
    <.button color="mono" size="sm"><.icon name="plus" size="md" />Novo pedido</.button>
  </:actions>
</.table_toolbar>
