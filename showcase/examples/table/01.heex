<.table id="orders-sort">
  <.table_head>
    <:col>Pedido</:col>
    <:col>Cliente</:col>
    <:col>Status</:col>
    <:col align="right">Total <span class="mo-sort"><.icon name="arrow-up" size="sm" /></span></:col>
    <:col align="right">Hora</:col>
  </.table_head>
  <.table_body class="mo-rows">
      <.table_row :for={{no, cl, tone, st, tot, h, dl} <- [{"PED-2491", "Mercadinho Bom Preço", "pos", "Pago", "R$ 1.284,90", "14:02", "0.00"}, {"PED-2492", "Padaria Central", "", "Aberto", "R$ 312,00", "14:40", "1.50"}, {"PED-2493", "Farmácia Vida", "neg", "Atrasado", "R$ 2.940,10", "ontem", "3.00"}, {"PED-2494", "Açougue Serrinha", "pos", "Pago", "R$ 860,00", "ontem", "4.50"}]} style={"--dl:#{dl}s"}>
        <:cell class="mono">{no}</:cell>
        <:cell>{cl}</:cell>
        <:cell><span class={"lu-badge " <> tone}><span class="lu-dot"></span>{st}</span></:cell>
        <:cell align="right" class="strong">{tot}</:cell>
        <:cell align="right" class="lu-muted">{h}</:cell>
      </.table_row>
  </.table_body>
</.table>
