<div class="grid grid-cols-3 gap-4">
  <div :for={r <- ~w(row top)} class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">rounded="{r}"</span>
    <.table id={"rounded-" <> r} rounded={r}>
      <.table_head>
        <:col>Pedido</:col>
        <:col>Cliente</:col>
        <:col>Status</:col>
        <:col align="right">Total</:col>
        <:col align="right">Hora</:col>
      </.table_head>
      <.table_body>
        <.table_row :for={{no, cl, tone, st, tot, h, dl} <- [{"PED-2491", "Mercadinho Bom Preço", "pos", "Pago", "R$ 1.284,90", "14:02", "0.00"}, {"PED-2492", "Padaria Central", "", "Aberto", "R$ 312,00", "14:40", "0.35"}]} style={"--dl:#{dl}s"}>
          <:cell class="font-mono text-[13px]">{no}</:cell>
          <:cell>{cl}</:cell>
          <:cell><.badge canvas dot color={Map.get(%{"pos" => "success", "neg" => "error"}, tone, "neutral")}>{st}</.badge></:cell>
          <:cell align="right" class="font-medium text-ink">{tot}</:cell>
          <:cell align="right">{h}</:cell>
        </.table_row>
      </.table_body>
    </.table>
  </div>
  <div class="flex flex-col gap-1.5">
    <span class="font-mono text-xs text-muted">sort_dir asc / desc</span>
    <div class="flex flex-wrap items-center gap-2.5">
      <.chip>Total <.icon name="arrow-up" size="sm" /></.chip>
      <.chip>Total <.icon name="arrow-down" size="sm" /></.chip>
    </div>
  </div>
</div>
