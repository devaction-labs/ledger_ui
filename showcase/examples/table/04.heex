<div class="grid grid-cols-3 gap-3.5">
  <div :for={a <- ~w(left center right)} class="flex flex-col items-start gap-1.5">
    <div class={["w-40 border-b border-line py-1.5 font-mono text-[13px] leading-[18px]", a == "center" && "text-center", a == "right" && "text-right"]}>R$ 1.284,90</div>
    <span class="font-mono text-[11px] text-muted">align={a}</span>
  </div>
</div>
