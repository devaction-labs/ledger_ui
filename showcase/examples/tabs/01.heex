<div class="grid grid-cols-2 gap-4">
  <div class="flex flex-col gap-1">
    <.tabs id="tabs1-left" variant="line" transition="left" selected="a" loop>
      <:tab name="a" class="w-[110px] justify-center">Visão geral</:tab>
      <:tab name="b" class="w-[110px] justify-center">Faturas</:tab>
      <:tab name="c" class="w-[110px] justify-center">Uso</:tab>
      <:panel name="a" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[40%]" /><.skeleton animation="none" class="h-2.5 w-[80%]" /><.skeleton animation="none" class="h-2.5 w-[65%]" /></:panel>
      <:panel name="b" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[55%]" /><.skeleton animation="none" class="h-2.5 w-[30%]" /><.skeleton animation="none" class="h-2.5 w-[90%]" /><.skeleton animation="none" class="h-2.5 w-[60%]" /></:panel>
      <:panel name="c" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[70%]" /><.skeleton animation="none" class="h-2.5 w-[45%]" /></:panel>
    </.tabs>
    <span class="font-mono text-xs text-muted">transition="left"</span>
  </div>
  <div class="flex flex-col gap-1">
    <.tabs id="tabs1-up" variant="line" transition="up" selected="a" loop>
      <:tab name="a" class="w-[110px] justify-center">Visão geral</:tab>
      <:tab name="b" class="w-[110px] justify-center">Faturas</:tab>
      <:tab name="c" class="w-[110px] justify-center">Uso</:tab>
      <:panel name="a" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[40%]" /><.skeleton animation="none" class="h-2.5 w-[80%]" /><.skeleton animation="none" class="h-2.5 w-[65%]" /></:panel>
      <:panel name="b" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[55%]" /><.skeleton animation="none" class="h-2.5 w-[30%]" /><.skeleton animation="none" class="h-2.5 w-[90%]" /><.skeleton animation="none" class="h-2.5 w-[60%]" /></:panel>
      <:panel name="c" class="flex flex-col gap-2"><.skeleton animation="none" class="h-2.5 w-[70%]" /><.skeleton animation="none" class="h-2.5 w-[45%]" /></:panel>
    </.tabs>
    <span class="font-mono text-xs text-muted">transition="up"</span>
  </div>
</div>
