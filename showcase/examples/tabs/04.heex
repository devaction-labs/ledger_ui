<div class="lu-col" style="gap:18px">
<.tabs id="t4-a" variant="classic" selected="ov">
  <:tab name="ov" aria-selected="true">Visão geral</:tab>
  <:tab name="inv" count={12} aria-selected="false">Faturas</:tab>
  <:tab name="use" aria-selected="false">Uso</:tab>
  <:tab name="act" count={3} count_tone="acc" aria-selected="false">Atividade</:tab>
  <:tab name="cfg" aria-selected="false">Configurações</:tab>
</.tabs>
<.tabs id="t4-b" variant="classic" selected="rev">
  <:tab name="ov"><.icon name="grid" size="md" />Overview</:tab>
  <:tab name="rev"><.icon name="trend-up" size="md" />Revenue</:tab>
  <:tab name="cus"><.icon name="users" size="md" />Customers</:tab>
</.tabs>
</div>
