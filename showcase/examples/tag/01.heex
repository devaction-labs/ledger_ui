<div class="lu-row mo-stg" style="gap:8px"><span :for={{c, l, d} <- [{"primary", "Atacado", "0.0s"}, {"info", "Varejo", "0.4s"}, {"secondary", "VIP", "0.8s"}, {"error", "Inadimplente", "1.2s"}]} style={"--dl:#{d};display:inline-flex"}><.tag as="span" color={c} variant="soft" removable>{l}</.tag></span></div>
