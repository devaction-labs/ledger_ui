<div class="flex flex-wrap items-center gap-2"><.tag as="span" color="primary" variant="soft" removable class="animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite]">Atacado</.tag><.tag as="span" color="info" variant="soft" removable class="animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite] [animation-delay:.4s]">Varejo</.tag><.tag as="span" color="secondary" variant="soft" removable class="animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite] [animation-delay:.8s]">VIP</.tag><.tag as="span" color="error" variant="soft" removable class="animate-[mo-stg_6s_cubic-bezier(.2,.8,.2,1)_infinite] [animation-delay:1.2s]">Inadimplente</.tag></div>
