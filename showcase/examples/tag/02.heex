<div style="display:grid;grid-template-columns:80px repeat(5, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span :for={v <- ~w(solid soft bordered outline flat)} class="text-center font-mono text-xs text-muted">{v}</span><%= for c <- ~w(neutral primary secondary info success warning error light) do %><span class="font-mono text-xs text-muted">{c}</span><div :for={v <- ~w(solid soft bordered outline flat)} style="display:flex;justify-content:center;min-width:0"><.tag as="span" color={c} variant={v}>{String.capitalize(c)}</.tag></div><% end %></div>
