<div class="grid grid-cols-2 gap-4">
  <.textarea id="ta01-a" label="Observações" autogrow help="autogrow até 6 linhas" value={"Entregar após as 14h.\nPortão lateral, falar com Rita.\nLevar maquininha."} frame_class="border-accent-500! shadow-[0_0_0_3px_var(--lu-focus)]" class="overflow-hidden animate-[lu-tagrow_6s_ease-in-out_infinite]" />
  <.textarea id="ta01-b" label="Mensagem ao cliente" counter maxlength={200} help="Até 200 caracteres" value="Seu pedido saiu para entrega e chega hoje entre 14h e 16h." frame_class="border-accent-500! shadow-[0_0_0_3px_var(--lu-focus)]" />
</div>
