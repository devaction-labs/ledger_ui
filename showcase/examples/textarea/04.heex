<div phx-no-curly-interpolation class="grid grid-cols-2 gap-4">
  <.textarea id="ta04-tokens" label="Modelo de mensagem" tokens value="Olá, {{cliente}}! Sua nota {{numero}} foi autorizada. O boleto vence em {{vencimento}}.">
    <:header><span class="text-xs text-muted">Variáveis: </span><.chip label="{{cliente}}" /><.chip label="{{numero}}" /></:header>
    <:footer><.icon name="bold" size="sm" /><.icon name="italic" size="sm" /><.icon name="link" size="sm" /><span class="ml-auto text-xs text-muted tabular-nums">96 / 300</span></:footer>
  </.textarea>
  <.textarea id="ta04-rz" label="Redimensionável" resizable value="Arraste o canto para aumentar." />
</div>
