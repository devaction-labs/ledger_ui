<div class="grid grid-cols-4 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><div class="flex items-baseline gap-2.5"><span class="ml-auto text-xs text-muted tabular-nums">26 / 200</span></div><span class="font-mono text-[11px] text-muted">counter_align=end</span></div>
  <div class="flex flex-col items-start gap-1.5"><div class="flex items-baseline gap-2.5"><span class="text-xs text-muted tabular-nums">26 / 200</span></div><span class="font-mono text-[11px] text-muted">counter_align=start</span></div>
  <div class="flex flex-col items-start gap-1.5"><.textarea id="ta06-ok" state="success" value="Ok" aria-label="Sucesso" /><span class="font-mono text-[11px] text-muted">state=success</span></div>
  <div class="flex flex-col items-start gap-1.5"><.textarea id="ta06-err" state="error" value="Erro" aria-label="Erro" /><span class="font-mono text-[11px] text-muted">state=error</span></div>
</div>
