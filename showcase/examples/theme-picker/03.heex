<div class="lu-grid" data-lu-single="" style="--cols:6;gap:10px"><button class="on" style="border:0;background:none;padding:0;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:6px" type="button"><span style="display:flex;height:84px;border-radius:12px;overflow:hidden;border:1px solid var(--line);box-shadow:0 0 0 2px var(--bg-page),0 0 0 4px var(--ink)"><span style="width:30%;background:#f4f4f2;border-right:1px solid rgba(127,127,127,.2)"></span><span style="flex:1;background:#fff;padding:8px;display:flex;flex-direction:column;gap:5px"><i style="display:block;height:6px;width:60%;border-radius:2px;background:#141514;opacity:.8"></i><i style="display:block;height:22px;border-radius:5px;background:#1f9282;opacity:.9"></i><i style="display:block;height:6px;width:40%;border-radius:2px;background:#141514;opacity:.4"></i></span></span><span class="lu-row" style="gap:6px"><i style="width:10px;height:10px;border-radius:3px;background:#1f9282;display:block"></i><span class="lu-small" style="color:var(--ink)">Ledger</span></span></button><button class="" style="border:0;background:none;padding:0;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:6px" type="button"><span style="display:flex;height:84px;border-radius:12px;overflow:hidden;border:1px solid var(--line);"><span style="width:30%;background:#f1f1ef;border-right:1px solid rgba(127,127,127,.2)"></span><span style="flex:1;background:#fff;padding:8px;display:flex;flex-direction:column;gap:5px"><i style="display:block;height:6px;width:60%;border-radius:2px;background:#141514;opacity:.8"></i><i style="display:block;height:22px;border-radius:5px;background:#3b3d3b;opacity:.9"></i><i style="display:block;height:6px;width:40%;border-radius:2px;background:#141514;opacity:.4"></i></span></span><span class="lu-row" style="gap:6px"><i style="width:10px;height:10px;border-radius:3px;background:#3b3d3b;display:block"></i><span class="lu-small" style="color:var(--ink)">Graphite</span></span></bu