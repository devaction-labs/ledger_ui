<div class="grid grid-cols-[90px_repeat(2,minmax(0,1fr))] items-center gap-x-3 gap-y-2.5"><span></span><span class="text-center font-mono text-xs text-muted">md</span><span class="text-center font-mono text-xs text-muted">sm</span><span class="font-mono text-xs text-muted">segmented</span><div class="flex min-w-0 justify-center"><.theme_switch id="ts-seg-md" value="light" /></div><div class="flex min-w-0 justify-center"><.theme_switch id="ts-seg-sm" value="light" size="sm" /></div><span class="font-mono text-xs text-muted">icons</span><div class="flex min-w-0 justify-center"><.theme_switch id="ts-icons-md" value="light" variant="icons" /></div><div class="flex min-w-0 justify-center"><.theme_switch id="ts-icons-sm" value="light" variant="icons" size="sm" /></div><span class="font-mono text-xs text-muted">switch</span><div class="flex min-w-0 justify-center"><.theme_switch id="ts-sw-md" value="dark" variant="switch" dark_label="Escuro" /></div><div class="flex min-w-0 justify-center"><.theme_switch id="ts-sw-sm" value="dark" variant="switch" size="sm" dark_label="Escuro" /></div></div>
