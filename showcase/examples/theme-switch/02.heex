<div style="display:grid;grid-template-columns:90px repeat(2, minmax(0,1fr));gap:10px 12px;align-items:center"><span></span><span class="lu-xs lu-muted mono" style="text-align:center">md</span><span class="lu-xs lu-muted mono" style="text-align:center">sm</span><span class="lu-xs lu-muted mono">segmented</span><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-seg-md" /></div><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-seg-sm" size="sm" /></div><span class="lu-xs lu-muted mono">icons</span><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-icons-md" variant="icons" /></div><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-icons-sm" variant="icons" size="sm" /></div><span class="lu-xs lu-muted mono">switch</span><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-sw-md" variant="switch" class="on" dark_label="Escuro" /></div><div style="display:flex;justify-content:center;min-width:0"><.theme_switch id="ts-sw-sm" variant="switch" size="sm" class="on" dark_label="Escuro" /></div></div>
