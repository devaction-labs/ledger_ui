<.timeline marker="icon" class="mo-stg"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}])} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline>
