<div class="lu-grid" style="--cols:5;gap:14px"><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono"></span><.timeline ><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">outline</span><.timeline marker="outline"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">icon</span><.timeline marker="icon"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">avatar</span><.timeline marker="avatar"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.avatar color="t1" size="28">{Enum.at(~w(Na Sa Ce), n)}</.avatar></:point></.timeline_item></.timeline></div><div class="lu-col" style="gap:6px"><span class="lu-xs lu-muted mono">dot</span><.timeline marker="dot"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}></.timeline_item></.timeline></div></div>
