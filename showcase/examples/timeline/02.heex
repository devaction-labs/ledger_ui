<div class="grid grid-cols-5 gap-3.5"><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted"></span><.timeline ><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">outline</span><.timeline marker="outline"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">icon</span><.timeline marker="icon"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.icon name={i} size="sm" /></:point></.timeline_item></.timeline></div><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">avatar</span><.timeline marker="avatar"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}><:point><.avatar color="t1" size="28">{Enum.at(~w(Na Sa Ce), n)}</.avatar></:point></.timeline_item></.timeline></div><div class="flex flex-col gap-1.5"><span class="font-mono text-xs text-muted">dot</span><.timeline marker="dot"><.timeline_item :for={{{c, i, t, d, h}, n} <- Enum.with_index(Enum.take([{"success", "check", "NF-e 48.211 autorizada", "Protocolo 129 2611", "14:02"}, {"info", "truck", "Saiu para entrega", "Motorista: Rita", "14:40"}, {"warning", "alert", "Cliente ausente", "Nova tentativa às 16h", "15:10"}, {"success", "check-circle", "Entregue", "Assinado por Ana", "16:05"}], 3))} color={c} title={t} description={d} time={h} style={"--dl:#{Float.round(n * 0.6, 1)}s"}></.timeline_item></.timeline></div></div>
