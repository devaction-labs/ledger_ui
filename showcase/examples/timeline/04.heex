<div class="flex flex-wrap items-center gap-2.5"><span :for={c <- ~w(neutral primary secondary info success warning error dark)} class={LedgerUI.Color.vars(c)} style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--c);color:var(--c-on)"><.icon name="check" size="sm" /></span></div>
