<div class="lu-grid" style="--cols:5;gap:14px"><div class="lu-cell"><span class="lu-chip">espaçamento normal</span><span class="lu-cap">density=default</span></div><div class="lu-cell"><span class="lu-chip">canvas</span><span class="lu-cap">variant=canvas</span></div><div class="lu-cell"><span class="c-primary" style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--c);color:var(--c-on)"><.icon name="check" size="sm" /></span><span class="lu-cap">color=accent</span></div><div class="lu-cell"><.badge canvas>Entregue</.badge><span class="lu-cap">tone=default</span></div><div class="lu-cell"><.badge canvas color="warning">Atrasado</.badge><span class="lu-cap">tone=warn</span></div></div>
