<div class="grid grid-cols-5 gap-3.5"><div class="flex flex-col items-start gap-1.5"><.chip>espaçamento normal</.chip><span class="font-mono text-[11px] text-muted">density=default</span></div><div class="flex flex-col items-start gap-1.5"><.chip>canvas</.chip><span class="font-mono text-[11px] text-muted">variant=canvas</span></div><div class="flex flex-col items-start gap-1.5"><span class="c-primary" style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--c);color:var(--c-on)"><.icon name="check" size="sm" /></span><span class="font-mono text-[11px] text-muted">color=accent</span></div><div class="flex flex-col items-start gap-1.5"><.badge canvas>Entregue</.badge><span class="font-mono text-[11px] text-muted">tone=default</span></div><div class="flex flex-col items-start gap-1.5"><.badge canvas color="warning">Atrasado</.badge><span class="font-mono text-[11px] text-muted">tone=warn</span></div></div>
