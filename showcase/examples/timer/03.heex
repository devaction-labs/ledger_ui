<%!-- the canvas draws the three formats as static samples ("value · format") --%>
<div class="flex flex-wrap items-center gap-2.5">
  <.timer id="timer-fmt-hms" variant="mini" running={false} elapsed={5076} format="hms"> · hms</.timer>
  <.timer id="timer-fmt-hm" variant="mini" running={false} elapsed={5076} format="hh:mm"> · hm</.timer>
  <.timer id="timer-fmt-auto" variant="mini" running={false} elapsed={1476} format="mm:ss"> · auto</.timer>
</div>
