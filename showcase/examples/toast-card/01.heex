<div class="lu-col" style="gap:16px;">
  <.toast_card aura="spin" aura_tone="ai" busy dismissible={false} kind="primary" icon="sparkles" title="Assistente lendo a nota" description="NF-e 48.211 · 44 itens" />
  <.toast_card aura="dual" aura_tone="ai" dismissible={false} kind="success" icon="check-circle" title="Conciliação pronta" description="18 lançamentos casados"><:action><button class="lu-b c-neutral v-outline s-sm sh-rounded" type="button">Revisar</button></:action></.toast_card>
  <.toast_card aura="glow" aura_tone="warn" dismissible={false} kind="warning" icon="alert" title="Certificado vence hoje" description="Renove para continuar emitindo"><:action><button class="lu-b c-neutral v-solid s-sm sh-rounded" type="button">Renovar</button></:action></.toast_card>
</div>
