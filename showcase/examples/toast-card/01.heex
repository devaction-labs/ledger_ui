<div class="flex flex-col gap-4">
  <.toast_card aura="spin" aura_tone="ai" busy dismissible={false} kind="primary" icon="sparkles" title="Assistente lendo a nota" description="NF-e 48.211 · 44 itens" />
  <.toast_card aura="dual" aura_tone="ai" dismissible={false} kind="success" icon="check-circle" title="Conciliação pronta" description="18 lançamentos casados"><:action><.button color="neutral" variant="outline" size="sm" shape="rounded">Revisar</.button></:action></.toast_card>
  <.toast_card aura="glow" aura_tone="warn" dismissible={false} kind="warning" icon="alert" title="Certificado vence hoje" description="Renove para continuar emitindo"><:action><.button color="neutral" variant="solid" size="sm" shape="rounded">Renovar</.button></:action></.toast_card>
</div>
