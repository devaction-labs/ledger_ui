<b class="text-[15px]">Cores</b><span class="mb-1.5 text-[13px] leading-[18px] text-muted">aura_color segue o significado: assistant (teal + violeta), primary, info, success, warning, error.</span>
<div class="rounded-[16px] border border-line bg-tray p-[22px]">
<div class="flex flex-col gap-3">
  <.toast_card aura="spin" aura_tone="info" busy dismissible={false} kind="info" icon="refresh" title="Sincronizando estoque" description="Filial Serrinha"></.toast_card>
  <.toast_card aura="spin" aura_tone="pos" dismissible={false} kind="success" icon="check" title="Pagamento recebido" description="Pix · R$ 3.120,50"></.toast_card>
  <.toast_card aura="glow" aura_tone="neg" dismissible={false} kind="error" icon="x-circle" title="SEFAZ recusou a nota" description="Rejeição 539 · duplicidade"></.toast_card>
</div>
</div>
