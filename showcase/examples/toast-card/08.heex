<b style="font-size:15px">Espessura</b><span class="lu-small lu-muted" style="margin-bottom:6px">aura_size xs (0,75px), sm (1px), padrão (1,25px) e lg (2px): fina por padrão; a mais grossa só para chamar atenção.</span>
<div style="padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)">
<div class="lu-col" style="gap:12px;">
  <.toast_card aura="spin" aura_tone="ai" aura_width="xs" busy dismissible={false} kind="primary" icon="sparkles" title="Aura xs" description="Assistente trabalhando"></.toast_card>
  <.toast_card aura="spin" aura_tone="ai" aura_width="sm" busy dismissible={false} kind="primary" icon="sparkles" title="Aura sm" description="Assistente trabalhando"></.toast_card>
  <.toast_card aura="spin" aura_tone="ai" busy dismissible={false} kind="primary" icon="sparkles" title="Aura default" description="Assistente trabalhando"></.toast_card>
  <.toast_card aura="spin" aura_tone="ai" aura_width="lg" busy dismissible={false} kind="primary" icon="sparkles" title="Aura lg" description="Assistente trabalhando"></.toast_card>
</div>
</div>
