<b class="text-[15px]">Toast escuro</b><span class="mb-1.5 text-[13px] leading-[18px] text-muted">invert para destacar sobre telas claras; a aura continua visível.</span>
<div class="rounded-[16px] border border-line bg-tray p-[22px]">
<div class="flex flex-col gap-3">
  <.toast_card aura="spin" aura_tone="ai" busy tone="dark" dismissible={false} kind="primary" icon="mic" title="Transcrevendo a reunião" description="Revisão comercial · 38 min de áudio"></.toast_card>
  <.toast_card aura="dual" aura_tone="ai" tone="dark" dismissible={false} kind="success" icon="check-circle" title="Transcrição pronta" description="12 tarefas encontradas"><:action><.button color="neutral" variant="soft" size="sm" shape="rounded">Ver</.button></:action></.toast_card>
</div>
</div>
