<b style="font-size:15px">Toast escuro</b><span class="lu-small lu-muted" style="margin-bottom:6px">invert para destacar sobre telas claras; a aura continua visível.</span>
<div style="padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)">
<div class="lu-col" style="gap:12px;">
  <.toast_card aura="spin" aura_tone="ai" busy tone="dark" dismissible={false} kind="primary" icon="mic" title="Transcrevendo a reunião" description="Revisão comercial · 38 min de áudio"></.toast_card>
  <.toast_card aura="dual" aura_tone="ai" tone="dark" dismissible={false} kind="success" icon="check-circle" title="Transcrição pronta" description="12 tarefas encontradas"><:action><button class="lu-b c-neutral v-soft s-sm sh-rounded" type="button">Ver</button></:action></.toast_card>
</div>
</div>
