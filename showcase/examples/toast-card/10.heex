<b style="font-size:15px">Aura em qualquer elemento</b><span class="lu-small lu-muted" style="margin-bottom:6px">&lt;.aura&gt; aplica o mesmo anel em botão, campo ou card.</span>
<div style="padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)">
<div class="lu-row" style="gap:18px;align-items:center">
  <.aura tone="ai" width="sm" radius="pill" style="width:auto;--r:15px"><button class="lu-b c-neutral v-outline s-md sh-pill" style="background:var(--bg-panel);border:0;gap:6px" type="button"><.icon name="sparkles" />Gerar resumo</button></.aura>
  <.aura tone="ai" radius="r12" style="width:auto;--r:15px"><span class="lu-input" style="border:0;width:300px"><.icon name="sparkles" /><input readonly="" value="Lendo o pedido por foto…" /></span></.aura>
  <span class="lu-aura m-dual t-ai w-default" style="width:auto;--r:15px"><div class="lu-panel" style="border:0;padding:14px;width:300px;display:flex;flex-direction:column;gap:6px"><b>Pedido #2492</b>
    <span class="lu-xs lu-muted">Assistente preenchendo 44 itens…</span>
    <div class="lu-meter2"><i style="width:70%"></i></div></div></span>
</div>
</div>
