<b class="text-[15px]">Aura em qualquer elemento</b><span class="mb-1.5 text-[13px] leading-[18px] text-muted">&lt;.aura&gt; aplica o mesmo anel em botão, campo ou card.</span>
<div class="rounded-[16px] border border-line bg-tray p-[22px]">
<div class="flex flex-wrap items-center gap-[18px]">
  <.aura tone="ai" width="sm" radius="pill"><.button color="neutral" variant="outline" size="md" shape="pill" class="gap-1.5 border-0 bg-panel"><.icon name="sparkles" />Gerar resumo</.button></.aura>
  <.aura tone="ai" radius="r12"><.input icon="sparkles" readonly value="Lendo o pedido por foto…" class="w-[300px] border-0" /></.aura>
  <.aura tone="ai" radius="r12"><div class="flex w-[300px] flex-col gap-1.5 bg-panel p-3.5"><b>Pedido #2492</b>
    <span class="text-xs text-muted">Assistente preenchendo 44 itens…</span>
    <.progress value={70} color="primary" size="sm" /></div></.aura>
</div>
</div>
