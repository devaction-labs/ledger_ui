<b style="font-size:15px">Com desfazer</b><span class="lu-small lu-muted" style="margin-bottom:6px">Ação reversível sem modal de confirmação.</span>
<div style="padding:22px;border-radius:16px;background:var(--bg-tray);border:1px solid var(--line)">
<.toast_card tone="dark" kind="neutral" icon="trash" title="Pedido #2488 excluído" close_label="Fechar"><:action><button class="lu-b c-white v-soft s-sm sh-rounded" type="button">Desfazer</button></:action></.toast_card>
</div>
