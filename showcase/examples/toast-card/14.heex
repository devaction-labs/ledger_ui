<div class="grid grid-cols-3 gap-3.5">
  <div class="flex flex-col items-start gap-1.5"><.toast_card kind="primary" icon="bell" title="Toast claro" description="tone=light" dismissible={false} /><span class="font-mono text-[11px] text-muted">tone=light</span></div>
  <div :for={t <- ~w(accent violet)} class="flex flex-col items-start gap-1.5"><.toast_card aura="spin" aura_tone={t} aura_shadow={false} title={t} dismissible={false} /><span class="font-mono text-[11px] text-muted">aura_tone={t}</span></div>
</div>
