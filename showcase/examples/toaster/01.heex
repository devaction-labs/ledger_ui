<div class="lu-col" style="gap:12px;"><div class="lu-row" style="justify-content:space-between"><div class="lu-row"><button phx-click={show_toast("Alterações salvas", kind: "neutral", description: "Orbit Cloud \u00b7 agora", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "neutral", "title": "Altera\u00e7\u00f5es salvas", "desc": "Orbit Cloud \u00b7 agora"}' type="button">Neutral</button><button phx-click={show_toast("Nova versão disponível", kind: "info", description: "Orbit Cloud \u00b7 agora", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "info", "title": "Nova vers\u00e3o dispon\u00edvel", "desc": "Orbit Cloud \u00b7 agora"}' type="button">Info</button><button phx-click={show_toast("Relatório exportado", kind: "success", description: "Orbit Cloud \u00b7 agora", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "success", "title": "Relat\u00f3rio exportado", "desc": "Orbit Cloud \u00b7 agora"}' type="button">Success</button><button phx-click={show_toast("Assentos em 80%", kind: "warning", description: "Orbit Cloud \u00b7 agora", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "warning", "title": "Assentos em 80%", "desc": "Orbit Cloud \u00b7 agora"}' type="button">Warning</button><button phx-click={show_toast("Falha ao sincronizar", kind: "error", description: "Orbit Cloud \u00b7 agora", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "error", "title": "Falha ao sincronizar", "desc": "Orbit Cloud \u00b7 agora"}' type="button">Error</button><button phx-click={show_toast("Emitindo NF-e…", kind: "loading", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "loading", "title": "Emitindo NF-e\u2026", "then": {"kind": "success", "title": "NF-e autorizada", "desc": "N\u00ba 4.312 \u00b7 SEFAZ-BA"} }' type="button">Loading → success</button><button phx-click={show_toast("3 new AI insights", kind: "info", description: "Churn liderado por Pro", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "info", "title": "3 new AI insights", "desc": "Churn liderado por Pro", "action": "Ver"}' type="button">Com ação</button><button phx-click={show_toast("Deploy de <b>nexus_pro</b> concluído", status: "ok", to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"status": "ok", "title": "Deploy de &lt;b&gt;nexus_pro&lt;/b&gt; conclu\u00eddo"}' type="button">Status ok</button><button phx-click={show_toast("Pagamento recebido", kind: "success", invert: true, to: "#tdemo")} class="lu-b c-neutral v-outline s-sm" data-target="tdemo" data-toast='{"kind": "success", "title": "Pagamento recebido", "invert": true}' type="button">Invert</button></div><div class="lu-seg sm" data-lu-single="" data-pos-switch="tdemo"><button class="" data-v="left-top" type="button">left-top</button><button class="" data-v="center-top" type="button">center-top</button><button class="" data-v="right-top" type="button">right-top</button><button class="" data-v="left-bottom" type="button">left-bottom</button><button class="on" data-v="center-bottom" type="button">center-bottom</button><button class="" data-v="right-bottom" type="button">right-bottom</button></div></div><.toaster id="tdemo" contained>
    <%!-- raw: the toasts the canvas demo left on screen (a frozen snapshot, not driven by the hook) --%>
    <div class="lu-tcard c-success"><span class="tile"><.icon name="check-circle" size="md" /></span><div class="t"><b>Relatório exportado</b><span>board-pack-oct-2026.pdf</span></div><button class="x" type="button" aria-label="Fechar" data-x=""><.icon name="x" size="sm" /></button><i class="timer" style="--dur:60000ms"></i></div>
    <div class="lu-tcard c-info"><span class="tile"><.icon name="info" size="md" /></span><div class="t"><b>3 new AI insights</b></div><button class="x" type="button" aria-label="Fechar" data-x=""><.icon name="x" size="sm" /></button><i class="timer" style="--dur:60000ms"></i></div>
    <div class="lu-stoast"><span class="lu-st"><i></i></span><span class="msg">Importando <b>stripe-oct.csv</b></span></div>
  </.toaster></div>
