<div class="flex flex-col gap-3">
  <div class="flex flex-wrap items-center justify-between gap-2.5">
    <div class="flex flex-wrap items-center gap-2.5">
      <.button phx-click={show_toast("Alterações salvas", kind: "neutral", description: "Orbit Cloud · agora", to: "#tdemo")} color="neutral" variant="outline" size="sm">Neutral</.button>
      <.button phx-click={show_toast("Nova versão disponível", kind: "info", description: "Orbit Cloud · agora", to: "#tdemo")} color="neutral" variant="outline" size="sm">Info</.button>
      <.button phx-click={show_toast("Relatório exportado", kind: "success", description: "Orbit Cloud · agora", to: "#tdemo")} color="neutral" variant="outline" size="sm">Success</.button>
      <.button phx-click={show_toast("Assentos em 80%", kind: "warning", description: "Orbit Cloud · agora", to: "#tdemo")} color="neutral" variant="outline" size="sm">Warning</.button>
      <.button phx-click={show_toast("Falha ao sincronizar", kind: "error", description: "Orbit Cloud · agora", to: "#tdemo")} color="neutral" variant="outline" size="sm">Error</.button>
      <.button phx-click={show_toast("Emitindo NF-e…", kind: "loading", to: "#tdemo")} color="neutral" variant="outline" size="sm">Loading → success</.button>
      <.button phx-click={show_toast("3 new AI insights", kind: "info", description: "Churn liderado por Pro", actions: [%{label: "Ver"}], to: "#tdemo")} color="neutral" variant="outline" size="sm">Com ação</.button>
      <.button phx-click={show_toast("Deploy de <b>nexus_pro</b> concluído", status: "ok", to: "#tdemo")} color="neutral" variant="outline" size="sm">Status ok</.button>
      <.button phx-click={show_toast("Pagamento recebido", kind: "success", invert: true, to: "#tdemo")} color="neutral" variant="outline" size="sm">Invert</.button>
    </div>
    <.segmented id="tdemo-pos" size="sm" value="center-bottom" options={~w(left-top center-top right-top left-bottom center-bottom right-bottom)} />
  </div>
  <.toaster id="tdemo" contained>
    <%!-- the toasts the canvas demo left on screen: a still snapshot of what the hook draws (the stack is phx-update="ignore") --%>
    <div class="w-[380px] max-w-full"><.toast_card kind="success" icon="check-circle" title="Relatório exportado" description="board-pack-oct-2026.pdf" close_label="Fechar" /></div>
    <div class="w-[380px] max-w-full"><.toast_card kind="info" icon="info" title="3 new AI insights" close_label="Fechar" /></div>
    <.status_toast state="run">Importando <b>stripe-oct.csv</b></.status_toast>
  </.toaster>
</div>
