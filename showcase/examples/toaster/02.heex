<div class="relative h-[210px] overflow-hidden rounded-[14px] border border-line bg-panel">
  <div class="absolute bottom-4 left-1/2 w-[380px] max-w-[calc(100%-32px)] -translate-x-1/2 opacity-0 animate-[lu-ts1_9s_cubic-bezier(.3,.7,.4,1)_infinite] [&>*]:w-full">
    <.toast_card kind="success" icon="check-circle" title="Relatório exportado" description="board-pack-oct-2026.pdf" close_label="Fechar" />
  </div>
  <div class="absolute bottom-4 left-1/2 w-[380px] max-w-[calc(100%-32px)] -translate-x-1/2 opacity-0 animate-[lu-ts2_9s_cubic-bezier(.3,.7,.4,1)_infinite] [&>*]:w-full">
    <.toast_card kind="primary" icon="bell" title="Novo pedido #2492" description="Mercadinho Bom Preço" close_label="Fechar" />
  </div>
  <div class="absolute bottom-4 left-1/2 w-[380px] max-w-[calc(100%-32px)] -translate-x-1/2 opacity-0 animate-[lu-ts3_9s_cubic-bezier(.3,.7,.4,1)_infinite] [&>*]:w-full">
    <.status_toast state="run" class="mx-auto flex w-max">Importando <b>extrato BB</b><:action>Ocultar</:action></.status_toast>
  </div>
</div>
