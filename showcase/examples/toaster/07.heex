<div class="lu-tloop" style="display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;padding:16px">
  <.toast_card aura="spin" aura_tone="ai" aura_style="width:380px;--r:15px" kind="primary" icon="sparkles" title="Assistente trabalhando" dismissible={false} busy />
  <.toast_card aura="glow" aura_tone="warn" aura_style="width:380px;--r:15px" kind="warning" icon="alert" title="Precisa de você" dismissible={false}><:action><button class="lu-b c-neutral v-solid s-sm sh-rounded" type="button">Revisar</button></:action></.toast_card>
</div>
