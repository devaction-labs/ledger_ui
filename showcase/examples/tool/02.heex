<div class="flex flex-col gap-2">
  <.tool id="tool-running" variant="panel" icon="tool" state="running" title="Transmitindo à SEFAZ" class="max-w-[460px]" />
  <.tool id="tool-waiting" variant="panel" icon="tool" state="waiting" title="Aguardando aprovação" class="max-w-[460px]" />
  <.tool id="tool-done" variant="panel" icon="tool" state="done" title="XML assinado" class="max-w-[460px]" />
  <.tool id="tool-error" variant="panel" icon="tool" state="error" title="Certificado vencido" class="max-w-[460px]" />
  <.tool id="tool-denied" variant="panel" icon="tool" state="denied" title="Acesso negado" class="max-w-[460px]" />
</div>
