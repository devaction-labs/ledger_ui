<div class="lu-col" style="gap:8px">
  <.tool id="tool-running" variant="panel" icon="tool" state="running" title="Transmitindo à SEFAZ" style="max-width:460px" />
  <.tool id="tool-waiting" variant="panel" icon="tool" state="waiting" title="Aguardando aprovação" style="max-width:460px" />
  <.tool id="tool-done" variant="panel" icon="tool" state="done" title="XML assinado" style="max-width:460px" />
  <.tool id="tool-error" variant="panel" icon="tool" state="error" title="Certificado vencido" style="max-width:460px" />
  <.tool id="tool-denied" variant="panel" icon="tool" state="denied" title="Acesso negado" style="max-width:460px" />
</div>
