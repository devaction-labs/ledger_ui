<div class="lu-grid" style="--cols:3;gap:16px"><div class="lu-panel" style="padding:14px;display:flex;flex-direction:column;gap:10px"><div class="lu-row" style="flex-wrap:nowrap"><span class="lu-ic acc"><.icon name="card" /></span><span class="lu-col lu-grow" style="gap:0"><b>Stripe</b><span class="lu-xs lu-muted">Assinaturas e faturas</span></span><label class="lu-switch"><input checked="" type="checkbox"/><span></span></label></div><div class="lu-row" style="gap:6px"><code class="lu-badge" style="font-family:var(--font-mono)">read:subscriptions</code><code class="lu-badge" style="font-family:var(--font-mono)">read:invoices</code></div><div class="lu-row"><span class="lu-badge pos"><span class="lu-dot"></span>Conectado</span></div></div><div class="lu-panel" style="padding:14px;display:flex;flex-direction:column;gap:10px"><div class="lu-row" style="flex-wrap:nowrap"><span class="lu-ic info"><.icon name="server" /></span><span class="lu-col lu-grow" style="gap:0"><b>Postgres</b><span class="lu-xs lu-muted">Banco de produção (réplica)</span></span><label class="lu-switch"><input checked="" type="checkbox"/><span></span></label></div><div class="lu-row" style="gap:6px"><code class="lu-badge" style="font-family:var(--font-mono)">read:accounts</code></div><div class="lu-row"><span class="lu-badge pos"><span class="lu-dot"></span>Conectado</span></div></div><div class="lu-panel" style="padding:14px;display:flex;flex-direction:column;gap:10px"><div class="lu-row" style="flex-wrap:nowrap"><span class="lu-ic"><.icon name="mail" /></span><span class="lu-col lu-grow" style="gap:0"><b>Gmail</b><span class="lu-xs lu-muted">Rascunhos de cobrança</span></span><label class="lu-switch"><input type="checkbox"/><span></span></label></div><div class="lu-row" style="gap:6px"><code class="lu-badge" style="font-family:var(--font-mono)">compose</code></div><div class="lu-row"><span class="lu-badge"><span class="lu-dot"></span>Desligado</span></div></div></div>
