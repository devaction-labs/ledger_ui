<div class="grid grid-cols-4 gap-3.5">
  <div :for={f <- ~w(initial horizontal vertical both)} class="flex flex-col items-start gap-1.5">
    <.tooltip id={"tt-f-#{f}"} color="dark" text={f} follow_cursor={f} open><.icon_button icon="download" label="Exportar" /></.tooltip>
    <span class="font-mono text-[11px] text-muted">follow_cursor={f}</span>
  </div>
</div>
