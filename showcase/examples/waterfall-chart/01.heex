<div class="max-w-[480px]">
  <.card title="MRR movement">
      <:actions><.button canvas size="sm" icon aria-label="Mais"><.icon name="more-h" /></.button></:actions>
      <div class="mb-2 flex items-baseline gap-2.5"><b class="text-[30px] leading-9 font-semibold tracking-[-.03em] tabular-nums">+$14,860</b><span class="text-muted">net new in October</span></div>
      <.waterfall_chart
        id="mrr-movement"
        label="Movimento de MRR"
        steps={[
          %{name: "New", value: 18400, label: "+$18.4k", color: "var(--lu-chart-1)"},
          %{name: "Expand", value: 6200, label: "+$6.2k", color: "var(--lu-chart-5)"},
          %{name: "Contract", value: -2100, label: "−$2.1k", color: "var(--lu-chart-3)"},
          %{name: "Churn", value: -7600, label: "−$7.6k", color: "var(--lu-chart-4)"},
          %{name: "Net", value: 14900, label: "$14.9k", total: true, color: "var(--lu-chart-2)"}
        ]}
      />
  </.card>
</div>
